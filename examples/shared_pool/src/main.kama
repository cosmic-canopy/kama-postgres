// shared_pool: one pool of connections, used by four worker isolates. A pool belongs to the isolate that made it.
// share() gives each worker a PoolShare (Sendable), and Pool.join(share:) makes a pool over the same connections in
// that isolate, with the same maxSize between them all. Each worker runs three jobs. A job is a transaction on a
// leased connection, and the lease gives its connection back when it is dropped, on every path out of its scope.
//
//   kama pkg install examples/shared_pool/kama.json
//   PGHOST=localhost PGUSER=app PGDATABASE=inventory kama run examples/shared_pool/kama.json
//   kama run examples/shared_pool/kama.json -- "postgresql://app@db.internal/inventory"
//
// The server is the connection string given as the argument, or libpq's PG* variables without one. Exit 0 when every
// job ran, and no more than maxSize (2) sessions served them all.
import { core::args, core::println, std::collections::DynamicArray, std::concurrent::Channel, std::concurrent::Sender,
         std::concurrent::Receiver, std::concurrent::Isolate,
         postgres::Config, postgres::PgError, postgres::Rows, postgres::column, postgres::pg,
         postgres::pool::Pool, postgres::pool::PoolOptions, postgres::pool::PoolShare, postgres::pool::Lease };

// One job: a connection from the pool, and a transaction on it. The advisory lock is held until the transaction ends,
// so one worker at a time is past it. Its answer is the session's backend process id, or -1, with the error printed.
unsafe fn int32 job(ref Pool pool) {
    Result<Lease, PgError> got = pool.acquire();
    Lease lease = match (give got) { case Ok(value: l): give l; case Err(error: e): { println(s: e.message()); return -1; } };
    borrow lease.conn().transaction() as tx {
        Result<Unit, PgError> begun = tx.began();
        match (give begun) { case Ok(value: u): { } case Err(error: e): { println(s: e.message()); return -1; } };
        Result<Rows, PgError> r = tx.conn().query(q: pg"select pg_backend_pid() from pg_advisory_xact_lock(42)");
        Rows rows = match (give r) { case Ok(value: v): give v; case Err(error: e): { println(s: e.message()); return -1; } };
        Result<int32, PgError> backend = column::<int32>(rows: rows, row: 0, index: 0);
        int32 pid = match (backend) { case Ok(value: p): p; case Err(error: e): { println(s: e.message()); return -1; } };
        Result<Unit, PgError> done = tx.commit();
        match (give done) { case Ok(value: u): { } case Err(error: e): { println(s: e.message()); return -1; } };
        return pid;
    }
}

// A worker isolate: its share of the pool, and where its jobs' answers go.
type resource Worker implements Sendable {
    PoolShare share;
    Sender<int32> report;
    public ctor make(PoolShare share, Sender<int32> report) { this.share = give share; this.report = give report; }
    public unsafe fn void run() {
        Pool pool = Pool.join(share: this.share);
        isize round = 0;
        while (round < 3) {
            int32 pid = job(pool: ref pool);
            _ = this.report.send(item: pid);
            round = round + 1;
        }
    }
}

fn void work(Worker w) { w.run(); }

fn uint8 main() {
    Optional<string> given = args().get(at: 0);
    string conninfo = match (give given) { case Some(value: s): give s; case None: ""; };
    Result<Config, PgError> parsed = Config.parse(text: conninfo);
    Config config = match (give parsed) { case Ok(value: c): give c; case Err(error: e): { println(s: e.message()); return 1; } };

    PoolOptions options = PoolOptions.defaults();
    options.maxSize = 2;
    options.minIdle = 1;   // the maintenance keeps one connection ready
    Result<Pool, PgError> made = Pool.make(config: config, options: options);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { println(s: e.message()); return 1; } };

    Channel<int32> answers = Channel.bounded(capacity: 16);
    Receiver<int32> rx = answers.receiver();
    {
        DynamicArray<Isolate> running = DynamicArray.empty();
        isize i = 0;
        while (i < 4) {
            Result<PoolShare, PgError> shared = pool.share();
            PoolShare share = match (give shared) { case Ok(value: s): give s; case Err(error: e): { println(s: e.message()); return 1; } };
            Worker w = Worker.make(share: give share, report: answers.sender());
            Isolate t = spawn work(w: give w);
            running.add(item: give t);
            i = i + 1;
        }
    }   // dropping an Isolate joins it

    // Twelve answers: the backends that served them, each counted once.
    DynamicArray<int32> sessions = DynamicArray.empty();
    isize failed = 0;
    isize k = 0;
    while (k < 12) {
        Optional<int32> answer = rx.recv();
        int32 pid = match (answer) { case Some(value: p): p; case None: -1; };
        if (pid < 0) { failed = failed + 1; }
        else {
            bool seen = false;
            isize j = 0;
            while (j < sessions.length()) { if (sessions[j] == pid) { seen = true; } j = j + 1; }
            if (!seen) { sessions.add(item: pid); }
        }
        k = k + 1;
    }
    isize used = sessions.length();
    println(s: "12 jobs, ${failed} failed, on ${used} sessions");
    if (failed != 0 || used < 1 || used > 2) { println(s: "expected every job to run, on 1 or 2 sessions"); return 1; }
    return 0;
}
