{
  "name": "@kama/postgres",
  "version": "0.3.0",
  "license": "MIT OR Apache-2.0",
  "description": "PostgreSQL client in kama: the v3 wire protocol, libpq's connection rules, TLS, COPY, pipelining and a statement cache",
  "repository": "https://github.com/cosmic-canopy/kama-postgres",
  "keywords": ["postgresql", "database", "sql", "libpq", "client"],
  "kind": "library",
  "kama": ">=0.9.719",
  "dependencies": {
    "@kama/tls": { "version": "^0.1.7" }
  },
  "publish": {
    "exclude": [
      ".claude/", ".github/", "tools/", "docs/",
      "AGENTS.md", "AGENTS.package.md", "AGENTS.postgres.md", "CLAUDE.md", "KAMA_GAPS.md"
    ]
  },
  "modules": {
    ".":        { "visibility": "public" },
    "protocol": { "visibility": "public" },
    "conninfo": { "visibility": "public" },
    "sqlstate": { "visibility": "public" },
    "types":    { "visibility": "public" },
    "pool":     { "visibility": "public" },
    "wire":     { "visibility": "internal" },
    "secure":   { "visibility": "internal" },
    "session":  { "visibility": "internal" },
    "stringprep": { "visibility": "internal" }
  }
}
