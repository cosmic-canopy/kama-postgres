import { std::collections::DynamicArray, std::collections::ConstView, std::encoding::utf8::validate,
         std::encoding::utf8::decode as utf8Decode, std::encoding::utf8::Utf8Error, std::io::IoError, std::io::IoErrorKind,
         std::memory::Owned, std::net::SocketAddr, std::net::IpAddr, std::net::resolve, std::net::parseIp,
         std::time::Duration, std::random::Rng, std::random::shuffle,
         postgres::PgError, postgres::ServerError, postgres::ConnectError, postgres::ConnectAttempt,
         postgres::Config, postgres::HostKind, postgres::ChannelBindingMode, postgres::RequireAuth,
         postgres::Transport, postgres::socketPathMax,
         postgres::NoticeHandler, postgres::Notification,
         postgres::logNotice, postgres::Rows,
         postgres::wire::Wire, postgres::wire::Deadline, postgres::wire::strerror,
         postgres::protocol::MessageWriter, postgres::protocol::BackendMessage, postgres::protocol::ProtocolError,
         postgres::protocol::FieldDescription, postgres::protocol::RowValues, postgres::protocol::ErrorFields,
         postgres::protocol::ScramClient, postgres::protocol::ChannelBinding, postgres::protocol::AuthError,
         postgres::protocol::md5Password, postgres::protocol::PROTOCOL_3_0, postgres::protocol::PROTOCOL_3_2,
         postgres::protocol::startup as sendStartup, postgres::protocol::password as sendPassword,
         postgres::protocol::saslInitialResponse, postgres::protocol::saslResponse,
         postgres::protocol::query as sendQuery, postgres::protocol::terminate as sendTerminate,
         postgres::protocol::copyFail as sendCopyFail, postgres::protocol::parse as sendParse,
         postgres::protocol::bind as sendBind, postgres::protocol::describeStatement as sendDescribeStatement,
         postgres::protocol::execute as sendExecute, postgres::protocol::closeStatement as sendCloseStatement,
         postgres::protocol::closePortal as sendClosePortal, postgres::protocol::sync as sendSync,
         postgres::protocol::cancelRequest as sendCancelRequest, postgres::CancelToken,
         postgres::TransactionOptions, postgres::Savepoint, postgres::TransactionBody,
         postgres::CopyInfo, postgres::CopyChunk, postgres::protocol::CopyFormats,
         postgres::protocol::copyData as sendCopyData, postgres::protocol::copyDone as sendCopyDone,
         std::io::Reader, std::io::Writer, std::io::writeAll, std::collections::FixedArray,
         postgres::sqlstate::QUERY_CANCELED, postgres::sqlstate::FEATURE_NOT_SUPPORTED,
         postgres::CacheMode, postgres::session::StatementCache, postgres::session::CachedStatement, postgres::SessionTarget,
         postgres::protocol::describePortal as sendDescribePortal, postgres::protocol::flush as sendFlush,
         postgres::PipelineStatus, postgres::PipelineResult, postgres::Batch, postgres::BatchResult,
         postgres::protocol::BindValues,
         postgres::Query, postgres::Statement, postgres::Portal, postgres::hasBinaryCodec,
         postgres::Dialer, postgres::DialTarget, postgres::SslCertMode, postgres::sqlstate::sqlstateCode,
         postgres::secure::EncryptionPlan, postgres::secure::Fallback, postgres::secure::Secured, postgres::secure::secure,
         postgres::secure::TlsSession,
         postgres::session::Opener, postgres::session::Opened, postgres::session::CancelRoute };
export { Connection, TransactionStatus };

// postgres::Connection — one session with a server: connecting as libpq connects (every host and address in
// turn, each within connect_timeout), authenticating, and running queries. A connection belongs to one isolate at
// a time and moves between them: it is Sendable, and it holds no Shared.

// Where the session's transaction stands, as libpq's PQtransactionStatus says: Active while a command's result is
// still being read, otherwise what the last ReadyForQuery said (idle, in a transaction block, or in a failed one);
// Unknown once the connection is closed.
type enum TransactionStatus implements Sendable { Idle, Active, InTransaction, Failed, Unknown }

// The authentication request codes (AUTH_REQ_* in PostgreSQL's src/include/libpq/protocol.h).
comptime int32 AUTH_OK = 0;
comptime int32 AUTH_PASSWORD = 3;
comptime int32 AUTH_MD5 = 5;
comptime int32 AUTH_SASL = 10;
comptime int32 AUTH_SASL_CONT = 11;
comptime int32 AUTH_SASL_FIN = 12;

type resource Connection implements Sendable {
    Wire wire;
    MessageWriter outbox;
    bool live = false;
    int32 pid = 0;
    DynamicArray<uint8> cancelKey;
    int32 protocol = 0;
    uint8 txStatus = 73ui8;   // 'I'
    DynamicArray<string> paramNames;
    DynamicArray<string> paramValues;
    Optional<Owned<NoticeHandler>> handler;
    DynamicArray<Notification> pending;
    // A result being read: its columns as they arrive, and whether its BindComplete is still to come. While
    // `busy`, every other call is refused, as libpq refuses one while a query is in progress.
    bool busy = false;
    bool streaming = false;   // the result is read a chunk at a time (startRows)
    bool bindPending = false;
    bool rowLimited = false;  // its Execute had a row limit, so it may end in PortalSuspended
    DynamicArray<FieldDescription> openFields;
    int64 statements = 0i64;  // the names given so far: s0, s1, …
    int64 portals = 0i64;     // p0, p1, …
    Optional<TlsSession> tls;          // what TLS settled, when the session is encrypted
    bool refusedBeforeAuth = false;    // startup ended on an ErrorResponse before AuthenticationOk
    // How a cancel request reaches the server again: the route the connect took (None over a caller's transport),
    // and how connections are opened (this client's sockets, or the caller's Dialer).
    Optional<CancelRoute> route;
    Opener dialing;
    // The query timeout (setQueryTimeout): the limit, the grace for the server's answer to the cancel, and for the
    // command in hand, when it must end and whether its cancel has been sent.
    Optional<Duration> timeoutSetting;
    Duration graceSetting;
    Deadline due;
    bool cancelling = false;
    int64 savepoints = 0i64;   // the names given so far: sp_1, sp_2, …
    uint8 copyMode = 0ui8;     // a COPY in progress: 1 FROM STDIN (copy-in), 2 TO STDOUT (copy-out); 0 none
    // The statement cache (Config.setStatementCache), the statements it let go that the server is still to close,
    // the CloseCompletes owed for those sent, and for the command in hand whether its statement came from the cache.
    StatementCache cache;
    DynamicArray<string> closing;
    isize closesOwed = 0;
    bool fromCache = false;
    string cachedSql;
    // For a describe-only cache's run: its Parse is sent with the Bind, and the portal is described.
    bool parsePending = false;
    bool portalDescribing = false;
    // Pipeline mode: 0 off, 1 on, 2 aborted (a command failed; the rest until the next sync were skipped), and the
    // commands sent whose results are still to be read, oldest first.
    uint8 pipeline = 0ui8;
    DynamicArray<PipelineCommand> queue;

    ctor over(Owned<Transport> transport) {
        this.wire = Wire.over(transport: give transport);
        this.outbox = MessageWriter.make();
        this.live = true;
        this.pid = 0;
        this.cancelKey = DynamicArray.empty();
        this.protocol = 0;
        this.txStatus = 73ui8;
        this.paramNames = DynamicArray.empty();
        this.paramValues = DynamicArray.empty();
        this.handler = Optional::None;
        this.pending = DynamicArray.empty();
        this.busy = false;
        this.streaming = false;
        this.bindPending = false;
        this.rowLimited = false;
        this.openFields = DynamicArray.empty();
        this.statements = 0i64;
        this.portals = 0i64;
        this.tls = Optional::None;
        this.refusedBeforeAuth = false;
        this.route = Optional::None;
        this.dialing = Opener.builtIn();
        this.timeoutSetting = Optional::None;
        this.graceSetting = Duration.fromSecs(s: 2i64);
        this.due = Deadline.none();
        this.cancelling = false;
        this.savepoints = 0i64;
        this.copyMode = 0ui8;
        this.cache = StatementCache.make(mode: CacheMode::Off, capacity: 0);
        this.closing = DynamicArray.empty();
        this.closesOwed = 0;
        this.fromCache = false;
        this.cachedSql = "";
        this.parsePending = false;
        this.portalDescribing = false;
        this.pipeline = 0ui8;
        this.queue = DynamicArray.empty();
    }

    // Over a transport some of whose bytes were read already: what the server sent after its 'N' to an SSLRequest.
    ctor resumed(Owned<Transport> transport, ConstView<uint8> preread) {
        this.wire = Wire.resume(transport: give transport, preread: preread);
        this.outbox = MessageWriter.make();
        this.live = true;
        this.pid = 0;
        this.cancelKey = DynamicArray.empty();
        this.protocol = 0;
        this.txStatus = 73ui8;
        this.paramNames = DynamicArray.empty();
        this.paramValues = DynamicArray.empty();
        this.handler = Optional::None;
        this.pending = DynamicArray.empty();
        this.busy = false;
        this.streaming = false;
        this.bindPending = false;
        this.rowLimited = false;
        this.openFields = DynamicArray.empty();
        this.statements = 0i64;
        this.portals = 0i64;
        this.tls = Optional::None;
        this.refusedBeforeAuth = false;
        this.route = Optional::None;
        this.dialing = Opener.builtIn();
        this.timeoutSetting = Optional::None;
        this.graceSetting = Duration.fromSecs(s: 2i64);
        this.due = Deadline.none();
        this.cancelling = false;
        this.savepoints = 0i64;
        this.copyMode = 0ui8;
        this.cache = StatementCache.make(mode: CacheMode::Off, capacity: 0);
        this.closing = DynamicArray.empty();
        this.closesOwed = 0;
        this.fromCache = false;
        this.cachedSql = "";
        this.parsePending = false;
        this.portalDescribing = false;
        this.pipeline = 0ui8;
        this.queue = DynamicArray.empty();
    }

    // Connect as `config` says, as libpq's PQconnectPoll does: each host in order, each of its addresses in turn,
    // and at each address the encryption sslmode allows, in its order (prefer: TLS, then plaintext; allow: the other
    // way round). A failure to reach an address, or connect_timeout passing, moves to the next address. A refusal
    // tries the next encryption method on a new connection to the same address while one is left; then, or for a
    // failure no other method could cure, the connect ends, and no further host is tried. A server that cannot
    // accept connections yet (57P03) moves to the next host. Every attempt is kept in the error, each with libpq's
    // lead ("connection to server at …").
    public unsafe ctor Result<Connection, PgError> connect(const ref Config config) {
        Opener opener = Opener.builtIn();
        return Connection.establish(config: config, opener: opener);
    }

    // `connect`, with each connection opened by `dialer` (a tunnel, a proxy) rather than a socket of this client's.
    public unsafe ctor Result<Connection, PgError> connectWith(Owned<Dialer> dialer, const ref Config config) {
        Opener opener = Opener.with(dialer: give dialer);
        Result<Connection, PgError> made = Connection.establish(config: config, opener: opener);
        match (give made) {
            case Ok(value: c): {
                // A cancel request goes through the same dialer.
                Connection session = give c;
                session.dialing = give opener;
                return Result::Ok(value: give session);
            }
            case Err(error: e): { return Result::Err(error: give e); }
        };
        return Result::Err(error: PgError::Closed);
    }

    // Start a session over a transport the caller opened (tokio-postgres's connect_raw). `config` supplies everything
    // but the hosts: the transport stands in for a connection to its first host, so sslmode applies as it would there
    // (a socket host: plaintext), and that host's name is the one TLS sends as SNI and verify-full checks. There is one
    // transport, so there is one attempt: a fallback that needs a new connection is reported as the failure.
    // connect_timeout bounds the startup.
    public unsafe ctor Result<Connection, PgError> connectOver(Owned<Transport> transport, const ref Config config) {
        Deadline deadline = Deadline.none();
        if (config.connectTimeout() > 0) { deadline = Deadline.after(span: Duration.fromSecs(s: cast<int64>(config.connectTimeout()))); }
        bool socket = config.hostCount() == 0 || config.host(index: 0).kind() == HostKind::Socket;
        string host = "";
        if (config.hostCount() > 0 && !socket) { host = copy config.host(index: 0).name(); }
        EncryptionPlan plan = EncryptionPlan.forAddress(mode: config.tls().mode(), socket: socket);
        Errand errand = Errand.session(target: config.sessionTarget());
        Attempt tried = Connection::attempt(link: give transport, config: config, hostIndex: -1, host: host, plan: plan, deadline: deadline, errand: errand);
        return match (give tried) {
            case Ready(connection: c): Result::Ok(value: give c);
            case Retry(error: e): Result::Err(error: give e);
            case Final(error: e): Result::Err(error: give e);
            case TimedOut(error: e): Result::Err(error: give e);
            case NextHost(error: e): Result::Err(error: give e);
        };
    }

    unsafe ctor Result<Connection, PgError> establish(const ref Config config, ref Opener opener) {
        ConnectError failures = ConnectError.make();
        // prefer-standby goes round the hosts twice: for a standby, then for any server (libpq's PREFER_STANDBY_PASS2).
        bool secondPass = match (config.sessionTarget()) { case PreferStandby: true; case _: false; };
        isize passes = 1;
        if (secondPass) { passes = 2; }
        // load_balance_hosts=random: the hosts shuffled once per connect (both passes take the same order), and each host's
        // addresses as they resolve, from one generator, as libpq does. libpq's Fisher-Yates runs inside out and std's from
        // the end; both are uniform, and libpq's stream is not reproducible across processes either.
        bool random = config.loadBalanceRandom();
        Rng rng = Rng.seeded(seed: 0ui64);
        if (random) { rng = Rng.fromEntropy(); }
        DynamicArray<isize> order = DynamicArray.empty();
        isize k = 0;
        while (k < config.hostCount()) { order.add(item: k); k = k + 1; }
        if (random) { shuffle(items: order.viewMut(), rng: ref rng); }
        bool stop = false;
        isize pass = 0;
        while (pass < passes && !stop) {
            SessionTarget wanted = config.sessionTarget();
            if (pass == 1) { wanted = SessionTarget::Any; }
            Errand errand = Errand.session(target: wanted);
            isize at = 0;
            while (at < order.length() && !stop) {
                isize h = order[at];
                Result<DynamicArray<DialTarget>, PgError> listed = Connection::targetsOf(config: config, hostIndex: h, failures: failures);
                DynamicArray<DialTarget> targets = match (give listed) { case Ok(value: t): give t; case Err(error: e): { return Result::Err(error: give e); } };
                if (random) { shuffle(items: targets.viewMut(), rng: ref rng); }
                bool nextHost = false;
                isize a = 0;
                while (a < targets.length() && !stop && !nextHost) {
                    Visit v = Connection::visit(config: config, hostIndex: h, target: targets[a], opener: opener, failures: failures, errand: errand);
                    match (give v) {
                        case Connected(connection: c): { return Result::Ok(value: give c); }
                        case NextAddress: { }
                        case ToNextHost: { nextHost = true; }
                        case Stop: { stop = true; }
                    };
                    a = a + 1;
                }
                at = at + 1;
            }
            pass = pass + 1;
        }
        return Result::Err(error: PgError::Connect(error: give failures));
    }

    // The places host `hostIndex` can be reached: its socket, its hostaddr, or every address its name resolves to. A
    // host that has none (a bad port, a path too long, a name that does not resolve) is recorded and has no targets.
    // A port that is not an integer ends the connect, as libpq's does.
    static unsafe fn Result<DynamicArray<DialTarget>, PgError> targetsOf(const ref Config config, isize hostIndex, ref ConnectError failures) {
        DynamicArray<DialTarget> targets = DynamicArray.empty();
        string shown = config.host(index: hostIndex).display();
        string portText = copy config.host(index: hostIndex).port();
        if (portText.length() == 0) { portText = "5432"; }
        Optional<int32> parsedPort = config.host(index: hostIndex).portNumber();
        int32 portValue = match (parsedPort) {
            case Some(value: p): p;
            case None: {
                return Result::Err(error: PgError::Config(detail: "invalid integer value \"".concat(other: config.host(index: hostIndex).port()).concat(other: "\" for connection option \"port\"")));
            }
        };
        if (portValue < 1 || portValue > 65535) {
            failures.add(attempt: ConnectAttempt.make(host: copy shown, address: "", port: copy portText, lead: "",
                error: PgError::Config(detail: "invalid port number: \"".concat(other: config.host(index: hostIndex).port()).concat(other: "\"")), passfile: "", note: ""));
            return Result::Ok(value: give targets);
        }
        uint16 port = cast<uint16>(portValue);
        if (config.host(index: hostIndex).kind() == HostKind::Socket) {
            // UNIXSOCK_PATH: the directory and the port make the path; "@name" is Linux's abstract namespace.
            string dir = copy config.host(index: hostIndex).name();
            string path = dir.concat(other: "/.s.PGSQL.${portValue}");
            if (path.length() > socketPathMax()) {
                isize most = socketPathMax();
                failures.add(attempt: ConnectAttempt.make(host: copy shown, address: "", port: copy portText, lead: "",
                    error: PgError::Config(detail: "Unix-domain socket path \"".concat(other: path).concat(other: "\" is too long (maximum ${most} bytes)")), passfile: "", note: ""));
                return Result::Ok(value: give targets);
            }
            bool linuxAbstract = dir.startsWith(prefix: "@");
            targets.add(item: DialTarget.overSocket(host: copy shown, port: copy portText, path: give path, linuxAbstract: linuxAbstract));
            return Result::Ok(value: give targets);
        }
        if (config.host(index: hostIndex).kind() == HostKind::Address) {
            Optional<IpAddr> ip = parseIp(text: config.host(index: hostIndex).address());
            match (ip) {
                case Some(value: a): { targets.add(item: DialTarget.overTcp(host: copy shown, port: copy portText, address: SocketAddr.of(ip: a, port: port))); }
                case None: {
                    failures.add(attempt: ConnectAttempt.make(host: copy shown, address: "", port: copy portText,
                        lead: "could not parse network address \"".concat(other: config.host(index: hostIndex).address()).concat(other: "\": "),
                        error: PgError::Io(error: IoError.of(kind: IoErrorKind::InvalidInput)), passfile: "", note: ""));
                }
            };
            return Result::Ok(value: give targets);
        }
        Result<DynamicArray<SocketAddr>, IoError> found = resolve(host: config.host(index: hostIndex).name(), port: port);
        match (give found) {
            case Ok(value: list): {
                foreach (SocketAddr address in list) { targets.add(item: DialTarget.overTcp(host: copy shown, port: copy portText, address: address)); }
            }
            case Err(error: e): {
                failures.add(attempt: ConnectAttempt.make(host: copy shown, address: "", port: copy portText,
                    lead: "could not translate host name \"".concat(other: config.host(index: hostIndex).name()).concat(other: "\" to address: "),
                    error: PgError::Io(error: e), passfile: "", note: ""));
            }
        };
        return Result::Ok(value: give targets);
    }

    // One address: a connection for each encryption method sslmode allows, until one starts a session or a failure
    // decides otherwise. connect_timeout runs from the first connection and bounds them all, as it bounds libpq's
    // attempts at one address. libpq prints its lead again for every new connection.
    static unsafe fn Visit visit(const ref Config config, isize hostIndex, const ref DialTarget target, ref Opener opener, ref ConnectError failures, const ref Errand errand) {
        string addressText = "";
        string lead = "";
        if (target.isSocket()) {
            lead = "connection to server on socket \"".concat(other: target.socketPath()).concat(other: "\" failed: ");
        } else {
            Optional<SocketAddr> at = target.address();
            match (at) { case Some(value: a): { IpAddr ip = a.ip; addressText = "${ip}"; } case None: { } };
            lead = identity(host: target.host(), address: addressText, port: target.port());
        }
        Deadline deadline = Deadline.none();
        if (config.connectTimeout() > 0) { deadline = Deadline.after(span: Duration.fromSecs(s: cast<int64>(config.connectTimeout()))); }
        // A cancel for a query timeout ends with its grace, if that comes first.
        deadline = deadline.sooner(other: errand.limit());
        EncryptionPlan plan = EncryptionPlan.forAddress(mode: config.tls().mode(), socket: target.isSocket());
        // libpq's connhost[].host: the name TLS sends as SNI and verify-full checks, "" when only hostaddr was given.
        string host = "";
        if (!target.isSocket()) { host = copy config.host(index: hostIndex).name(); }
        while (true) {
            Opened opened = opener.open(target: target, config: config, deadline: deadline);
            Owned<Transport> link = match (give opened) {
                case Link(transport: t): give t;
                case Unreachable(error: e, note: n): {
                    failures.add(attempt: ConnectAttempt.make(host: copy target.host(), address: copy addressText, port: copy target.port(), lead: copy lead,
                        error: give e, passfile: "", note: give n));
                    return Visit::NextAddress;
                }
                case Refused(error: e): {
                    failures.add(attempt: ConnectAttempt.make(host: copy target.host(), address: copy addressText, port: copy target.port(), lead: copy lead,
                        error: give e, passfile: "", note: ""));
                    return Visit::Stop;
                }
            };
            Attempt tried = Connection::attempt(link: give link, config: config, hostIndex: hostIndex, host: host, plan: plan, deadline: deadline, errand: errand);
            string passfile = passfileFor(config: config, hostIndex: hostIndex);
            match (give tried) {
                case Ready(connection: c): {
                    Connection session = give c;
                    if (!errand.isCancel()) { session.route = Optional::Some(value: CancelRoute.make(config: copy config, hostIndex: hostIndex, target: copy target)); }
                    return Visit::Connected(connection: give session);
                }
                case Retry(error: e): {
                    failures.add(attempt: ConnectAttempt.make(host: copy target.host(), address: copy addressText, port: copy target.port(), lead: copy lead, error: give e, passfile: give passfile, note: ""));
                }
                case Final(error: e): {
                    failures.add(attempt: ConnectAttempt.make(host: copy target.host(), address: copy addressText, port: copy target.port(), lead: copy lead, error: give e, passfile: give passfile, note: ""));
                    return Visit::Stop;
                }
                case TimedOut(error: e): {
                    failures.add(attempt: ConnectAttempt.make(host: copy target.host(), address: copy addressText, port: copy target.port(), lead: copy lead, error: give e, passfile: "", note: ""));
                    return Visit::NextAddress;
                }
                case NextHost(error: e): {
                    failures.add(attempt: ConnectAttempt.make(host: copy target.host(), address: copy addressText, port: copy target.port(), lead: copy lead, error: give e, passfile: give passfile, note: ""));
                    return Visit::ToNextHost;
                }
            };
        }
        return Visit::Stop;
    }

    // One connection: encryption as `plan` has it now, then startup. What a failure leads to is libpq's: a TLS failure
    // or the server's refusal before authentication tries the next method (Retry) while one is left; 57P03 moves on
    // to the next host; connect_timeout to the next address; anything else ends the connect.
    static unsafe fn Attempt attempt(Owned<Transport> link, const ref Config config, isize hostIndex, const ref string host, ref EncryptionPlan plan, Deadline deadline, const ref Errand errand) {
        bool ssl = match (plan.current()) { case Ssl: true; case Plain: false; };
        if (!ssl) {
            Connection plain = Connection.over(transport: give link);
            return Connection::finish(c: give plain, config: config, hostIndex: hostIndex, plan: plan, deadline: deadline, errand: errand);
        }
        Secured secured = secure(link: give link, settings: config.tls(), host: host, deadline: deadline);
        match (give secured) {
            case Encrypted(link: l, session: s): {
                Connection c = Connection.over(transport: give l);
                c.tls = Optional::Some(value: give s);
                return Connection::finish(c: give c, config: config, hostIndex: hostIndex, plan: plan, deadline: deadline, errand: errand);
            }
            case Declined(link: l, preread: p): {
                Fallback next = plan.refused();
                bool same = match (next) { case SameConnection: true; case _: false; };
                if (!same) { return Attempt::Final(error: PgError::Tls(detail: "server does not support SSL, but SSL was required", cause: Optional::None)); }
                Connection c = Connection.resumed(transport: give l, preread: p.view());
                return Connection::finish(c: give c, config: config, hostIndex: hostIndex, plan: plan, deadline: deadline, errand: errand);
            }
            case Failed(error: e): {
                bool timedOut = match (e) { case Timeout: true; case _: false; };
                if (timedOut) { return Attempt::TimedOut(error: give e); }
                Fallback next = plan.failed();
                bool again = match (next) { case NewConnection: true; case _: false; };
                if (again) { return Attempt::Retry(error: give e); }
                return Attempt::Final(error: give e);
            }
            case Fatal(error: e): { return Attempt::Final(error: give e); }
        };
        return Attempt::Final(error: PgError::Closed);
    }

    // Startup over a connection whose encryption is settled; or, for a cancel request, the request in its place.
    static unsafe fn Attempt finish(Connection c, const ref Config config, isize hostIndex, ref EncryptionPlan plan, Deadline deadline, const ref Errand errand) {
        Connection session = give c;
        if (errand.isCancel()) {
            Result<Unit, PgError> answered = session.cancelExchange(pid: errand.processId(), key: errand.secretKey(), deadline: deadline);
            session.lose();
            match (give answered) {
                case Ok(value: u): { return Attempt::Ready(connection: give session); }
                case Err(error: e): {
                    bool late = match (e) { case Timeout: true; case _: false; };
                    if (late) { return Attempt::TimedOut(error: give e); }
                    return Attempt::Final(error: give e);
                }
            };
        }
        Result<Unit, PgError> started = session.startup(config: config, hostIndex: hostIndex, deadline: deadline);
        match (give started) {
            case Ok(value: u): {
                Result<Unit, PgError> fits = session.checkTarget(target: errand.target(), deadline: deadline);
                match (give fits) {
                    case Ok(value: k): { }
                    case Err(error: e): {
                        // Not the server asked for: libpq sends Terminate and moves on to the next host.
                        session.close();
                        if (isTimeout(e: e)) { return Attempt::TimedOut(error: give e); }
                        bool wrong = match (e) { case Target(detail: d): true; case _: false; };
                        if (wrong) { return Attempt::NextHost(error: give e); }
                        return Attempt::Final(error: give e);
                    }
                };
                session.cache = StatementCache.make(mode: config.statementCacheMode(), capacity: config.statementCacheCapacity());
                return Attempt::Ready(connection: give session);
            }
            case Err(error: e): {
                bool refusedEarly = session.refusedBeforeAuth;
                session.lose();
                bool timedOut = match (e) { case Timeout: true; case _: false; };
                if (timedOut) { return Attempt::TimedOut(error: give e); }
                if (refusedEarly) {
                    if (e.sqlstate() == sqlstateCode(text: "57P03")) { return Attempt::NextHost(error: give e); }
                    Fallback next = plan.failed();
                    bool again = match (next) { case NewConnection: true; case _: false; };
                    if (again) { return Attempt::Retry(error: give e); }
                }
                return Attempt::Final(error: give e);
            }
        };
        return Attempt::Final(error: PgError::Closed);
    }

    // ---- the session ----

    // Run `sql` with the simple protocol: one or more statements separated by semicolons, each giving one result
    // (an empty statement gives none). Values arrive as text. If a statement fails, the server runs none after
    // it, and the error is returned in place of every result.
    public unsafe fn Result<DynamicArray<Rows>, PgError> simpleQuery(const ref string sql) {
        Result<Unit, PgError> ok = this.idle();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.arm();
        this.outbox.clear();
        if (!sendQuery(w: this.outbox, sql: sql)) {
            return Result::Err(error: PgError::Usage(detail: "the query text holds a NUL byte, which the protocol cannot carry"));
        }
        Result<Unit, PgError> sent = this.flush(deadline: this.due);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        return this.collect();
    }

    // Read the server's answer through ReadyForQuery: one result per statement, or the first error.
    unsafe fn Result<DynamicArray<Rows>, PgError> collect() {
        DynamicArray<Rows> results = DynamicArray.empty();
        isize columns = -1;                                     // the open result's column count; -1 when none is open
        DynamicArray<int16> formats = DynamicArray.empty();     // its columns' formats, for checking each row
        DynamicArray<PgError> failed = DynamicArray.empty();    // errors, in order: the first is the one returned
        bool copyRefused = false;
        bool copying = false;
        bool done = false;
        while (!done) {
            Result<BackendMessage, PgError> received = this.receive();
            BackendMessage m = match (give received) {
                case Ok(value: v): give v;
                case Err(error: e): { this.lose(); return Result::Err(error: give e); }
            };
            match (give m) {
                case RowDescription(fields: f): {
                    if (columns >= 0) { return this.violation(detail: unexpected(tag: 84ui8)); }
                    columns = f.length();
                    formats = DynamicArray.empty();
                    isize k = 0;
                    while (k < f.length()) { formats.add(item: f[k].format()); k = k + 1; }
                    results.add(item: Rows.make(fields: give f, rows: DynamicArray.empty(), tag: ""));
                }
                case DataRow(row: r): {
                    if (columns < 0) { return this.violation(detail: "server sent data (\"D\" message) without prior row description (\"T\" message)"); }
                    if (r.columnCount() != columns) { return this.violation(detail: "unexpected field count in \"D\" message"); }
                    if (!textValid(row: r, formats: formats)) {
                        this.lose();
                        return Result::Err(error: PgError::Protocol(error: ProtocolError::NotUtf8(tag: 68ui8)));
                    }
                    results[results.length() - 1].addRow(row: give r);
                }
                case CommandComplete(commandTag: t): {
                    this.noteTag(tag: t);
                    if (columns >= 0) { results[results.length() - 1].complete(tag: give t); }
                    else { results.add(item: Rows.make(fields: DynamicArray.empty(), rows: DynamicArray.empty(), tag: give t)); }
                    columns = -1;
                }
                case EmptyQueryResponse: { columns = -1; }
                case ErrorResponse(fields: f): {
                    ServerError e = ServerError.make(fields: give f);
                    bool fatal = e.isFatal();
                    failed.add(item: PgError::Server(error: give e));
                    if (fatal) { this.lose(); done = true; }
                    // A result the error cut short is not one the server completed.
                    if (columns >= 0) { Optional<Rows> partial = results.pop(); }
                    columns = -1;
                }
                case NoticeResponse(fields: f): { this.deliver(fields: give f); }
                case ParameterStatus(name: n, value: v): { this.setParameter(name: give n, value: give v); }
                case NotificationResponse(processId: p, channel: c, payload: x): {
                    this.pending.add(item: Notification.make(processId: p, channel: give c, payload: give x));
                }
                case CopyInResponse(formats: cf): {
                    // COPY has its own interface; refusing it here keeps the session usable.
                    this.outbox.clear();
                    bool framed = sendCopyFail(w: this.outbox, reason: "COPY runs through startCopyIn or copyFrom, not simpleQuery");
                    Result<Unit, PgError> refusal = this.flush(deadline: this.due);
                    match (give refusal) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                    copyRefused = true;
                }
                case CopyOutResponse(formats: cf): { copyRefused = true; copying = true; }
                case CopyData(data: d): { if (!copying) { return this.violation(detail: unexpected(tag: 100ui8)); } }
                case CopyDone: {
                    if (!copying) { return this.violation(detail: unexpected(tag: 99ui8)); }
                    copying = false;
                }
                case ReadyForQuery(status: s): { this.txStatus = s; done = true; }
                case _: { return this.violation(detail: "unexpected response from server: a message the simple query protocol does not send"); }
            };
        }
        if (copyRefused && this.live) {
            return Result::Err(error: PgError::Usage(detail: "COPY runs through startCopyIn/startCopyOut (or copyFrom/copyTo), not simpleQuery; the statement was not run, or its output was discarded"));
        }
        if (failed.length() > 0) { return Result::Err(error: failed.remove(index: 0)); }
        return Result::Ok(value: give results);
    }

    // ---- the extended protocol ----

    // Run `q`, one statement, and give its result. SQL text is parsed and described, then bound and executed: two
    // round trips (a prepared Statement's query takes one). Each parameter is sent as the type the server inferred
    // for it; each column of a type this client reads in binary comes in binary, every other one as text. A server
    // error is returned once the server is ready again, and the session goes on.
    public unsafe fn Result<Rows, PgError> query(const ref Query q) {
        bool retryable = this.txStatus == 73ui8;   // 'I': nothing has run yet that a retry could repeat
        Result<Unit, PgError> started = this.start(q: q, portal: "", run: true);
        match (give started) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        Result<Rows, PgError> r = this.readRows(limit: -1, keep: true, pipelined: false);
        if (retryable && this.stalePlan(r: r)) {
            Result<Unit, PgError> again = this.start(q: q, portal: "", run: true);
            match (give again) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
            return this.readRows(limit: -1, keep: true, pipelined: false);
        }
        return r;
    }

    // Run `q`, one statement, for its effect: the rows it affected or returned, as PQcmdTuples reads the command
    // tag (None for a command that reports no count). Any rows are read and dropped as they arrive.
    public unsafe fn Result<Optional<int64>, PgError> execute(const ref Query q) {
        bool retryable = this.txStatus == 73ui8;
        Result<Unit, PgError> started = this.start(q: q, portal: "", run: true);
        match (give started) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        Result<Rows, PgError> r = this.readRows(limit: -1, keep: false, pipelined: false);
        if (retryable && this.stalePlan(r: r)) {
            Result<Unit, PgError> again = this.start(q: q, portal: "", run: true);
            match (give again) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
            r = this.readRows(limit: -1, keep: false, pipelined: false);
        }
        return match (give r) { case Ok(value: rows): Result::Ok(value: rows.rowsAffected()); case Err(error: e): Result::Err(error: give e); };
    }

    // A cached statement whose plan the server will no longer run, because what it returns has changed (ALTER TABLE):
    // "cached plan must not change result type" (0A000). Its entry was let go when the error came; outside a
    // transaction the query is run again once, as pgjdbc does, since nothing ran.
    fn bool stalePlan(const ref Result<Rows, PgError> r) {
        if (!this.fromCache || !this.live) { return false; }
        return match (r) { case Ok(value: rows): false; case Err(error: e): isStalePlan(e: e); };
    }

    // Prepare `sql` as a named statement ("s0", "s1", … on this connection), with the parameter types and columns
    // the server describes, to run with `Query.of(statement:)` as often as needed.
    public unsafe fn Result<Statement, PgError> prepare(const ref string sql) {
        Result<Unit, PgError> ok = this.idle();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.arm();
        int64 n = this.statements;
        this.statements = this.statements + 1i64;
        string name = "s${n}";
        Result<Described, PgError> d = this.parseAndDescribe(name: name, sql: sql);
        Described shape = match (give d) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
        return Result::Ok(value: Statement.make(name: give name, sql: copy sql, types: copy shape.types(), fields: copy shape.fields()));
    }

    // Close a prepared statement on the server.
    public unsafe fn Result<Unit, PgError> closeStatement(Statement statement) {
        Result<Unit, PgError> ok = this.idle();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.arm();
        this.outbox.clear();
        bool framed = sendCloseStatement(w: this.outbox, name: statement.name());
        sendSync(w: this.outbox);
        return this.closeExchange();
    }

    // ---- chunked rows ----

    // Run `q`, and read its rows a chunk at a time with `nextRows` rather than holding them all (libpq 17's chunked
    // rows mode). Until the last chunk has been read, or `discardRows` is called, the connection is busy: any other
    // call is refused with libpq's "another command is already in progress".
    public unsafe fn Result<Unit, PgError> startRows(const ref Query q) {
        Result<Unit, PgError> started = this.start(q: q, portal: "", run: true);
        match (give started) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.streaming = true;
        return Result::Ok(value: Unit::Unit);
    }

    // The next chunk: up to `maxRows` rows (1 or more), as they arrive. The last chunk, which may have fewer rows or
    // none, carries the command tag, and after it `isStreaming()` is false. An error ends the stream.
    public unsafe fn Result<Rows, PgError> nextRows(isize maxRows) {
        if (!this.live) { return Result::Err(error: PgError::Closed); }
        if (!this.streaming) { return Result::Err(error: PgError::Usage(detail: "no rows are being read: startRows begins")); }
        if (maxRows < 1) { return Result::Err(error: PgError::Usage(detail: "nextRows needs maxRows of 1 or more")); }
        this.arm();
        return this.readRows(limit: maxRows, keep: true, pipelined: false);
    }

    // Read the rest of the rows and drop them, so the connection is free again.
    public unsafe fn Result<Unit, PgError> discardRows() {
        if (!this.streaming) { return Result::Ok(value: Unit::Unit); }
        this.arm();
        Result<Rows, PgError> r = this.readRows(limit: -1, keep: false, pipelined: false);
        return match (give r) { case Ok(value: rows): Result::Ok(value: Unit::Unit); case Err(error: e): Result::Err(error: give e); };
    }

    // A result is being read a chunk at a time.
    public const fn bool isStreaming() { return this.streaming; }

    // ---- portals ----

    // Bind `q` into a named portal ("p0", "p1", …), to read a part at a time with `fetch`. A portal lasts until the
    // transaction ends, so this needs a transaction block: outside one, each Sync ends the implicit transaction and
    // the portal with it.
    public unsafe fn Result<Portal, PgError> openPortal(const ref Query q) {
        if (this.live && !this.busy && this.txStatus != 84ui8) {   // 'T'
            return Result::Err(error: PgError::Usage(detail: "a portal needs a transaction block: begin one first, since outside a block each Sync ends the implicit transaction and closes the portal"));
        }
        int64 n = this.portals;
        string name = "p${n}";
        Result<Unit, PgError> started = this.start(q: q, portal: name, run: false);
        match (give started) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.portals = this.portals + 1i64;
        DynamicArray<FieldDescription> fields = copy this.openFields;
        Result<Rows, PgError> bound = this.readRows(limit: -1, keep: false, pipelined: false);
        match (give bound) { case Ok(value: r): { } case Err(error: e): { return Result::Err(error: give e); } };
        return Result::Ok(value: Portal.make(name: give name, fields: give fields));
    }

    // The next `maxRows` rows of `portal` (0 for all that remain). The result is `suspended()` while rows remain;
    // once the portal's command completes, `portal.isFinished()`.
    public unsafe fn Result<Rows, PgError> fetch(ref Portal portal, int32 maxRows) {
        Result<Unit, PgError> ok = this.idle();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        if (maxRows < 0) { return Result::Err(error: PgError::Usage(detail: "fetch needs maxRows of 0 (every row) or more")); }
        this.arm();
        this.outbox.clear();
        bool framed = sendExecute(w: this.outbox, portal: portal.name(), maxRows: maxRows);
        sendSync(w: this.outbox);
        Result<Unit, PgError> sent = this.flush(deadline: this.due);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.openFields = copy portal.columns();
        this.bindPending = false;
        this.rowLimited = maxRows > 0;
        this.busy = true;
        Result<Rows, PgError> r = this.readRows(limit: -1, keep: true, pipelined: false);
        bool finished = match (r) { case Ok(value: rows): !rows.suspended(); case Err(error: e): false; };
        if (finished) { portal.finish(); }
        return r;
    }

    // Close a portal on the server, before its transaction ends.
    public unsafe fn Result<Unit, PgError> closePortal(Portal portal) {
        Result<Unit, PgError> ok = this.idle();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.arm();
        this.outbox.clear();
        bool framed = sendClosePortal(w: this.outbox, name: portal.name());
        sendSync(w: this.outbox);
        return this.closeExchange();
    }

    // ---- transactions ----

    // BEGIN, with `options`. A BEGIN inside a transaction is the server's to answer (a WARNING, and no new
    // transaction).
    public unsafe fn Result<Unit, PgError> begin(const ref TransactionOptions options) {
        string sql = options.sql();
        return this.command(sql: sql);
    }

    // COMMIT. A transaction that had failed is rolled back by it, which is `RolledBack`.
    public unsafe fn Result<Unit, PgError> commit() {
        Result<DynamicArray<Rows>, PgError> r = this.simpleQuery(sql: "COMMIT");
        return match (give r) {
            case Ok(value: results): {
                bool rolledBack = results.length() > 0 && results[0].commandTag().equals(other: "ROLLBACK");
                if (rolledBack) { return Result::Err(error: PgError::RolledBack); }
                return Result::Ok(value: Unit::Unit);
            }
            case Err(error: e): Result::Err(error: give e);
        };
    }

    public unsafe fn Result<Unit, PgError> rollback() { return this.command(sql: "ROLLBACK"); }

    // SAVEPOINT, with a name this connection gives it.
    public unsafe fn Result<Savepoint, PgError> savepoint() {
        int64 n = this.savepoints + 1i64;
        this.savepoints = n;
        string name = "sp_${n}";
        Result<Unit, PgError> made = this.command(sql: "SAVEPOINT ".concat(other: name));
        match (give made) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        return Result::Ok(value: Savepoint.make(name: give name));
    }

    // RELEASE SAVEPOINT: keep what was done since it, and forget it.
    public unsafe fn Result<Unit, PgError> releaseSavepoint(Savepoint sp) { return this.command(sql: "RELEASE SAVEPOINT ".concat(other: sp.name())); }

    // ROLLBACK TO SAVEPOINT: undo what was done since it. The savepoint stays, to roll back to again or release.
    public unsafe fn Result<Unit, PgError> rollbackToSavepoint(const ref Savepoint sp) { return this.command(sql: "ROLLBACK TO SAVEPOINT ".concat(other: sp.name())); }

    // Run `body` in a transaction, as psycopg's `with conn.transaction()` and pgx's BeginFunc do: BEGIN with `options`,
    // then COMMIT if the body returns Ok, or ROLLBACK if it returns Err, whose error is then this call's. Inside an
    // open transaction it nests as a savepoint (released, or rolled back to and released), and `options` do not
    // apply. Rows the body left unread are read first. If ending the transaction fails, that error is returned.
    public unsafe fn Result<Unit, PgError> transaction(TransactionBody body, const ref TransactionOptions options) {
        Result<Unit, PgError> ok = this.idle();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        bool nested = this.txStatus != 73ui8;   // 'I'
        if (nested) {
            Result<Savepoint, PgError> taken = this.savepoint();
            Savepoint sp = match (give taken) { case Ok(value: s): give s; case Err(error: e): { return Result::Err(error: give e); } };
            Result<Unit, PgError> ran = body.run(conn: ref this);
            Result<Unit, PgError> settled = this.discardRows();
            match (give ran) {
                case Ok(value: u): { return this.releaseSavepoint(sp: give sp); }
                case Err(error: e): {
                    Result<Unit, PgError> back = this.rollbackToSavepoint(sp: sp);
                    Result<Unit, PgError> gone = this.releaseSavepoint(sp: give sp);
                    return Result::Err(error: give e);
                }
            };
        }
        Result<Unit, PgError> begun = this.begin(options: options);
        match (give begun) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        Result<Unit, PgError> ran = body.run(conn: ref this);
        Result<Unit, PgError> settled = this.discardRows();
        match (give ran) {
            case Ok(value: u): { return this.commit(); }
            case Err(error: e): {
                Result<Unit, PgError> back = this.rollback();
                return Result::Err(error: give e);
            }
        };
        return Result::Err(error: PgError::Closed);
    }

    // A statement run for its effect alone.
    unsafe fn Result<Unit, PgError> command(const ref string sql) {
        Result<DynamicArray<Rows>, PgError> r = this.simpleQuery(sql: sql);
        return match (give r) { case Ok(value: rows): Result::Ok(value: Unit::Unit); case Err(error: e): Result::Err(error: give e); };
    }

    // ---- pipeline mode ----

    // libpq's PQpipelineStatus.
    public const fn PipelineStatus pipelineStatus() {
        if (this.pipeline == 1ui8) { return PipelineStatus::On; }
        if (this.pipeline == 2ui8) { return PipelineStatus::Aborted; }
        return PipelineStatus::Off;
    }

    // PQenterPipelineMode: from now on commands are sent without waiting (sendQuery, sendPrepare, …) and their results
    // read with getResult; synchronous calls are refused until exitPipelineMode. Entering again does nothing.
    public fn Result<Unit, PgError> enterPipelineMode() {
        if (!this.live) { return Result::Err(error: PgError::Closed); }
        if (this.pipeline != 0ui8) { return Result::Ok(value: Unit::Unit); }
        if (this.busy || this.streaming || this.copyMode != 0ui8) { return Result::Err(error: PgError::Usage(detail: "cannot enter pipeline mode, connection not idle")); }
        this.pipeline = 1ui8;
        this.outbox.clear();
        return Result::Ok(value: Unit::Unit);
    }

    // PQexitPipelineMode: only once every result has been read.
    public unsafe fn Result<Unit, PgError> exitPipelineMode() {
        if (this.pipeline == 0ui8) { return Result::Ok(value: Unit::Unit); }
        if (this.queue.length() > 0) { return Result::Err(error: PgError::Usage(detail: "cannot exit pipeline mode with uncollected results")); }
        this.pipeline = 0ui8;
        if (this.outbox.view().length() > 0) { return this.flush(deadline: Deadline.none()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Queue `q` (PQsendQueryParams, PQsendQueryPrepared). A prepared statement's query, or one the statement cache
    // knows, goes as it would outside a pipeline, its parameters typed. Any other goes as PQsendQueryParams sends it:
    // the unnamed statement with each parameter's natural type (Query's encodedUndescribed), the values as text, the
    // portal described, the columns as text.
    public unsafe fn Result<Unit, PgError> sendQuery(const ref Query q) {
        Result<Unit, PgError> ok = this.pipelined();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        if (q.problem().length() > 0) { return Result::Err(error: PgError::Value(detail: copy q.problem())); }
        if (q.parameterCount() > 65535) { return Result::Err(error: PgError::Usage(detail: "number of parameters must be between 0 and 65535")); }
        this.queueCloses();
        PipelineCommand command = PipelineCommand.query(sql: copy q.sql());
        Optional<Described> known = this.knownShape(q: q);
        string unnamed = "";
        match (give known) {
            case Some(value: shape): {
                BindValues params = q.encoded(types: shape.types());
                DynamicArray<int16> formats = DynamicArray.withCapacity(capacity: shape.fields().length());
                DynamicArray<FieldDescription> columns = DynamicArray.withCapacity(capacity: shape.fields().length());
                isize i = 0;
                while (i < shape.fields().length()) {
                    int16 format = 0i16;
                    if (hasBinaryCodec(oid: shape.fields()[i].typeOid())) { format = 1i16; }
                    formats.add(item: format);
                    columns.add(item: shape.fields()[i].withFormat(format: format));
                    i = i + 1;
                }
                if (shape.reparse()) {
                    if (!sendParse(w: this.outbox, name: shape.name(), sql: shape.sql(), params: params)) { return Result::Err(error: nulInQuery()); }
                    command.expectParse();
                }
                if (!sendBind(w: this.outbox, portal: unnamed, statement: shape.name(), params: params, resultFormats: formats)) { return Result::Err(error: nulInQuery()); }
                if (shape.reparse()) { bool d = sendDescribePortal(w: this.outbox, name: unnamed); command.expectPortalDescription(); }
                command.useColumns(fields: give columns, cached: shape.reparse() || this.fromCache);
            }
            case None: {
                BindValues params = q.encodedUndescribed();
                if (!sendParse(w: this.outbox, name: unnamed, sql: q.sql(), params: params)) { return Result::Err(error: nulInQuery()); }
                DynamicArray<int16> text = DynamicArray.empty();
                text.add(item: 0i16);
                if (!sendBind(w: this.outbox, portal: unnamed, statement: unnamed, params: params, resultFormats: text)) { return Result::Err(error: nulInQuery()); }
                bool d = sendDescribePortal(w: this.outbox, name: unnamed);
                command.expectParse();
                command.expectPortalDescription();
            }
        };
        bool e = sendExecute(w: this.outbox, portal: unnamed, maxRows: 0);
        this.queue.add(item: give command);
        return this.flushPast(bytes: PIPELINE_FLUSH);
    }

    // Queue a Parse of `sql` as a named statement, and its Describe (PQsendPrepare and PQsendDescribePrepared in one):
    // its result is the Statement.
    public unsafe fn Result<Unit, PgError> sendPrepare(const ref string sql) {
        Result<Unit, PgError> ok = this.pipelined();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        int64 n = this.statements;
        this.statements = this.statements + 1i64;
        string name = "s${n}";
        BindValues none = BindValues.make();
        if (!sendParse(w: this.outbox, name: name, sql: sql, params: none)) { return Result::Err(error: nulInQuery()); }
        bool d = sendDescribeStatement(w: this.outbox, name: name);
        this.queue.add(item: PipelineCommand.prepare(name: give name, sql: copy sql));
        return this.flushPast(bytes: PIPELINE_FLUSH);
    }

    // Queue a Close of `statement` (PQsendClosePrepared): its result is Closed.
    public unsafe fn Result<Unit, PgError> sendClosePrepared(Statement statement) {
        Result<Unit, PgError> ok = this.pipelined();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        bool framed = sendCloseStatement(w: this.outbox, name: statement.name());
        this.queue.add(item: PipelineCommand.close());
        return this.flushPast(bytes: PIPELINE_FLUSH);
    }

    // PQpipelineSync: a sync point, and everything queued is sent. Its result is Sync, after the results before it.
    public unsafe fn Result<Unit, PgError> pipelineSync() {
        Result<Unit, PgError> queued = this.sendPipelineSync();
        match (give queued) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        return this.flush(deadline: this.due);
    }

    // PQsendPipelineSync: a sync point, sent with the next flush (or once enough is queued).
    public unsafe fn Result<Unit, PgError> sendPipelineSync() {
        if (!this.live) { return Result::Err(error: PgError::Closed); }
        if (this.pipeline == 0ui8) { return Result::Err(error: PgError::Usage(detail: "cannot send pipeline when not in pipeline mode")); }
        sendSync(w: this.outbox);
        this.queue.add(item: PipelineCommand.sync());
        return this.flushPast(bytes: PIPELINE_FLUSH);
    }

    // PQsendFlushRequest: ask the server to send what it has for the commands so far, without a sync point; and send
    // everything queued.
    public unsafe fn Result<Unit, PgError> sendFlushRequest() {
        if (!this.live) { return Result::Err(error: PgError::Closed); }
        if (this.pipeline == 0ui8) { return Result::Err(error: PgError::Usage(detail: "sendFlushRequest asks for a pipeline's results: enterPipelineMode begins one")); }
        sendFlush(w: this.outbox);
        return this.flush(deadline: this.due);
    }

    // The next result, in the order the commands were sent (PQgetResult), or None when none is pending. Commands up to
    // the next sync after one that failed are Aborted, and nothing is read for them. Anything still queued is sent
    // first; a result needs a sync point or a flush request after its command, or the server keeps it.
    public unsafe fn Result<Optional<PipelineResult>, PgError> getResult() {
        if (!this.live) { return Result::Err(error: PgError::Closed); }
        if (this.pipeline == 0ui8) { return Result::Err(error: PgError::Usage(detail: "getResult reads a pipeline's results: enterPipelineMode begins one")); }
        if (this.queue.length() == 0) { return Result::Ok(value: Optional::None); }
        this.arm();
        if (this.outbox.view().length() > 0) {
            Result<Unit, PgError> sent = this.flush(deadline: this.due);
            match (give sent) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        }
        PipelineCommand head = this.queue.remove(index: 0);
        if (this.pipeline == 2ui8 && !head.isSync()) { return Result::Ok(value: Optional::Some(value: PipelineResult::Aborted)); }
        if (head.isSync()) {
            Result<Unit, PgError> synced = this.readSync();
            match (give synced) {
                case Ok(value: u): { }
                case Err(error: e): {
                    if (this.live) { this.queue.insertAt(index: 0, item: PipelineCommand.sync()); }
                    return this.failedInPipeline(e: give e);
                }
            };
            this.pipeline = 1ui8;
            return Result::Ok(value: Optional::Some(value: PipelineResult::Sync));
        }
        if (head.isClose()) {
            Result<Unit, PgError> closed = this.readClose();
            return match (give closed) {
                case Ok(value: u): Result::Ok(value: Optional::Some(value: PipelineResult::Closed));
                case Err(error: e): this.failedInPipeline(e: give e);
            };
        }
        if (head.isPrepare()) {
            Result<Statement, PgError> made = this.readPrepared(name: head.name(), sql: head.sql());
            return match (give made) {
                case Ok(value: st): Result::Ok(value: Optional::Some(value: PipelineResult::Prepared(statement: give st)));
                case Err(error: e): this.failedInPipeline(e: give e);
            };
        }
        this.openFields = copy head.columns();
        this.bindPending = true;
        this.parsePending = head.parses();
        this.portalDescribing = head.describesPortal();
        this.rowLimited = false;
        this.fromCache = head.cached();
        this.cachedSql = copy head.sql();
        Result<Rows, PgError> r = this.readRows(limit: -1, keep: true, pipelined: true);
        return match (give r) {
            case Ok(value: rows): Result::Ok(value: Optional::Some(value: PipelineResult::Rows(rows: give rows)));
            case Err(error: e): this.failedInPipeline(e: give e);
        };
    }

    // A command's error: the server's is the command's result, and the pipeline is aborted until the next sync; any
    // other failure (the connection, the protocol) is the call's.
    fn Result<Optional<PipelineResult>, PgError> failedInPipeline(PgError e) {
        bool server = match (e) { case Server(error: s): true; case _: false; };
        if (!server) { return Result::Err(error: give e); }
        if (this.live) { this.pipeline = 2ui8; }
        return match (give e) {
            case Server(error: s): Result::Ok(value: Optional::Some(value: PipelineResult::Failed(error: give s)));
            case _: Result::Err(error: PgError::Closed);
        };
    }

    // A command can be queued: the connection is open and in pipeline mode.
    fn Result<Unit, PgError> pipelined() {
        if (!this.live) { return Result::Err(error: PgError::Closed); }
        if (this.pipeline == 0ui8) { return Result::Err(error: PgError::Usage(detail: "sendQuery, sendPrepare and sendClosePrepared queue commands in pipeline mode: enterPipelineMode begins one")); }
        return Result::Ok(value: Unit::Unit);
    }

    // What is known of `q` without asking the server: a prepared statement's description, or the cache's.
    unsafe fn Optional<Described> knownShape(const ref Query q) {
        this.fromCache = false;
        if (q.isPrepared()) {
            return Optional::Some(value: Described.make(name: copy q.statement(), types: copy q.parameterTypes(), fields: copy q.columns()));
        }
        CacheMode mode = this.cache.mode();
        bool off = match (mode) { case Off: true; case _: false; };
        if (off || !this.cache.lookup(sql: q.sql())) { return Optional::None; }
        this.fromCache = true;
        Described hit = Described.make(name: copy this.cache.entry(sql: q.sql()).name(), types: copy this.cache.entry(sql: q.sql()).types(),
                                       fields: copy this.cache.entry(sql: q.sql()).columns());
        bool named = match (mode) { case Statements: true; case _: false; };
        if (!named) { hit.reparseAs(sql: q.sql()); }
        return Optional::Some(value: give hit);
    }

    // Send what is queued once it passes `bytes` (libpq's pipeline flushes at its output buffer's threshold).
    unsafe fn Result<Unit, PgError> flushPast(isize bytes) {
        if (this.outbox.view().length() < bytes) { return Result::Ok(value: Unit::Unit); }
        return this.flush(deadline: this.due);
    }

    // A pipeline's sync point: ReadyForQuery, and any CloseCompletes owed before it.
    unsafe fn Result<Unit, PgError> readSync() {
        while (true) {
            Result<BackendMessage, PgError> received = this.receive();
            BackendMessage m = match (give received) { case Ok(value: v): give v; case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            if (background(m: m)) { this.absorb(m: give m); continue; }
            match (give m) {
                case ReadyForQuery(status: s): { this.txStatus = s; return Result::Ok(value: Unit::Unit); }
                case CloseComplete: { if (!this.owedClose()) { return Result::Err(error: this.broken(detail: unexpected(tag: 51ui8))); } }
                case ErrorResponse(fields: f): {
                    // An error at the sync itself (a deferred constraint at the implicit commit): a result of its own,
                    // before the sync's, as libpq returns it. The caller puts the sync back to be read next.
                    ServerError e = ServerError.make(fields: give f);
                    if (e.isFatal()) { this.lose(); }
                    return Result::Err(error: PgError::Server(error: give e));
                }
                case _: { return Result::Err(error: this.broken(detail: "unexpected response from server: a message out of place at a pipeline's sync")); }
            };
        }
        return Result::Ok(value: Unit::Unit);
    }

    // A pipeline's Close: CloseComplete, or an error.
    unsafe fn Result<Unit, PgError> readClose() {
        while (true) {
            Result<BackendMessage, PgError> received = this.receive();
            BackendMessage m = match (give received) { case Ok(value: v): give v; case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            if (background(m: m)) { this.absorb(m: give m); continue; }
            match (give m) {
                case CloseComplete: { if (!this.owedClose()) { return Result::Ok(value: Unit::Unit); } }
                case ErrorResponse(fields: f): {
                    ServerError e = ServerError.make(fields: give f);
                    if (e.isFatal()) { this.lose(); }
                    return Result::Err(error: PgError::Server(error: give e));
                }
                case _: { return Result::Err(error: this.broken(detail: "unexpected response from server: a message out of place after a Close")); }
            };
        }
        return Result::Ok(value: Unit::Unit);
    }

    // A pipeline's Parse and Describe of statement `name`: the Statement.
    unsafe fn Result<Statement, PgError> readPrepared(const ref string name, const ref string sql) {
        Result<Described, PgError> d = this.readDescription(name: name, pipelined: true);
        Described shape = match (give d) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
        return Result::Ok(value: Statement.make(name: copy name, sql: copy sql, types: copy shape.types(), fields: copy shape.fields()));
    }

    // ---- batches ----

    // Run `batch`'s queries in one round trip (pgx's SendBatch). Queries the statement cache does not know yet are
    // described first, together, in one round trip (and kept, as the cache's mode says); then every query is sent
    // typed, with one sync at the end, and the results are read in order. The batch is one implicit transaction: a
    // query that fails is Failed, the rest are Aborted, and what ran before it is rolled back. A query that cannot be
    // described (a syntax error) fails the whole batch before anything runs. With no cache (CacheMode::Off), queries
    // go as a pipeline sends an unknown one: parameters as text, columns as text.
    public unsafe fn Result<DynamicArray<BatchResult>, PgError> runBatch(const ref Batch batch) {
        Result<Unit, PgError> ok = this.idle();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.arm();
        Result<Unit, PgError> described = this.describeBatch(batch: batch);
        match (give described) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.pipeline = 1ui8;
        isize k = 0;
        while (k < batch.length()) {
            Result<Unit, PgError> sent = this.sendQuery(q: batch.at(index: k));
            k = k + 1;
            match (give sent) {
                case Ok(value: u): { }
                case Err(error: e): {
                    // Nothing was flushed past this query; what was queued is dropped with the batch.
                    this.pipeline = 0ui8;
                    this.queue = DynamicArray.empty();
                    this.outbox.clear();
                    return Result::Err(error: give e);
                }
            };
        }
        Result<Unit, PgError> synced = this.pipelineSync();
        match (give synced) { case Ok(value: u): { } case Err(error: e): { this.pipeline = 0ui8; return Result::Err(error: give e); } };
        DynamicArray<BatchResult> results = DynamicArray.withCapacity(capacity: batch.length());
        bool done = false;
        while (!done) {
            Result<Optional<PipelineResult>, PgError> next = this.getResult();
            Optional<PipelineResult> got = match (give next) { case Ok(value: o): give o; case Err(error: e): { this.pipeline = 0ui8; this.queue = DynamicArray.empty(); return Result::Err(error: give e); } };
            match (give got) {
                case Some(value: r): {
                    match (give r) {
                        case Rows(rows: rows): { results.add(item: BatchResult::Rows(rows: give rows)); }
                        case Failed(error: e): {
                            // An error at the sync (a deferred constraint) belongs to the last query.
                            if (results.length() == batch.length()) { results.remove(index: results.length() - 1); }
                            results.add(item: BatchResult::Failed(error: give e));
                        }
                        case Aborted: { results.add(item: BatchResult::Aborted); }
                        case Sync: { done = true; }
                        case _: { }
                    };
                }
                case None: { done = true; }
            };
        }
        this.pipeline = 0ui8;
        return Result::Ok(value: give results);
    }

    // Describe the batch's SQL the cache does not know yet, each text once, in one round trip: Parse and Describe of
    // each (named under CacheMode::Statements, the unnamed statement otherwise, which each Parse replaces), then Sync.
    unsafe fn Result<Unit, PgError> describeBatch(const ref Batch batch) {
        CacheMode mode = this.cache.mode();
        bool off = match (mode) { case Off: true; case _: false; };
        if (off) { return Result::Ok(value: Unit::Unit); }
        bool named = match (mode) { case Statements: true; case _: false; };
        DynamicArray<string> texts = DynamicArray.empty();
        DynamicArray<string> names = DynamicArray.empty();
        isize k = 0;
        while (k < batch.length()) {
            bool known = batch.at(index: k).isPrepared() || this.cache.lookup(sql: batch.at(index: k).sql());
            bool seen = false;
            foreach (string t in texts) { if (t.equals(other: batch.at(index: k).sql())) { seen = true; } }
            if (!known && !seen) { texts.add(item: copy batch.at(index: k).sql()); }
            k = k + 1;
        }
        if (texts.length() == 0) { return Result::Ok(value: Unit::Unit); }
        this.outbox.clear();
        isize i = 0;
        while (i < texts.length()) {
            string name = "";
            if (named) { name = this.cache.nextName(); this.cache.makeRoom(closing: ref this.closing); }
            names.add(item: copy name);
            i = i + 1;
        }
        this.queueCloses();
        BindValues none = BindValues.make();
        i = 0;
        while (i < texts.length()) {
            if (!sendParse(w: this.outbox, name: names[i], sql: texts[i], params: none)) { return Result::Err(error: nulInQuery()); }
            bool d = sendDescribeStatement(w: this.outbox, name: names[i]);
            i = i + 1;
        }
        sendSync(w: this.outbox);
        Result<Unit, PgError> sent = this.flush(deadline: this.due);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        DynamicArray<PgError> failed = DynamicArray.empty();
        i = 0;
        while (i < texts.length() && failed.length() == 0) {
            Result<Described, PgError> d = this.readDescription(name: names[i], pipelined: true);
            match (give d) {
                case Ok(value: shape): {
                    this.cache.add(sql: copy texts[i], statement: CachedStatement.make(name: copy names[i], types: copy shape.types(), fields: copy shape.fields()), closing: ref this.closing);
                }
                case Err(error: e): {
                    bool server = match (e) { case Server(error: x): true; case _: false; };
                    if (!server) { return Result::Err(error: give e); }
                    failed.add(item: give e);
                }
            };
            i = i + 1;
        }
        Result<Unit, PgError> synced = this.readSync();
        match (give synced) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        if (failed.length() > 0) { return Result::Err(error: failed.remove(index: 0)); }
        return Result::Ok(value: Unit::Unit);
    }

    // ---- COPY ----

    // Run `sql`, a COPY … FROM STDIN, and stop when the server is ready for the data (libpq's PQexec of a COPY, which
    // returns PGRES_COPY_IN). Send the data with putCopyData, then end with endCopyIn, or abandon it with failCopyIn.
    // Until then the connection is busy. A statement that is not a COPY FROM STDIN is run and refused afterwards.
    public unsafe fn Result<CopyInfo, PgError> startCopyIn(const ref string sql) { return this.startCopy(sql: sql, wanted: 1ui8); }

    // Run `sql`, a COPY … TO STDOUT, and stop when the data starts (PGRES_COPY_OUT). Read it with getCopyData until
    // Done. Until then the connection is busy.
    public unsafe fn Result<CopyInfo, PgError> startCopyOut(const ref string sql) { return this.startCopy(sql: sql, wanted: 2ui8); }

    // Send `bytes` of a COPY FROM STDIN (PQputCopyData): any cut of the data stream will do. Data is sent as it fills
    // 64 KiB, in messages of at most 1 MiB. A server that has already failed the COPY (a row it could not read) has
    // said so by then: its error is returned, and the COPY is over (the connection is ready for another command).
    public unsafe fn Result<Unit, PgError> putCopyData(ConstView<uint8> bytes) {
        if (!this.live) { return Result::Err(error: PgError::Closed); }
        if (this.copyMode != 1ui8) { return Result::Err(error: PgError::Usage(detail: "no COPY in progress")); }
        this.arm();
        isize at = 0;
        bool sent = false;
        while (at < bytes.length()) {
            isize n = bytes.length() - at;
            if (n > COPY_PIECE) { n = COPY_PIECE; }
            sendCopyData(w: this.outbox, data: bytes.slice(from: at, count: n));
            at = at + n;
            if (this.outbox.view().length() >= COPY_FLUSH) {
                Result<Unit, PgError> f = this.flush(deadline: this.due);
                match (give f) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                sent = true;
            }
        }
        if (!sent) { return Result::Ok(value: Unit::Unit); }
        return this.copyStillWanted();
    }

    // End a COPY FROM STDIN (PQputCopyEnd with no error): CopyDone, then the COPY's result, the number of rows copied.
    public unsafe fn Result<Optional<int64>, PgError> endCopyIn() {
        if (!this.live) { return Result::Err(error: PgError::Closed); }
        if (this.copyMode != 1ui8) { return Result::Err(error: PgError::Usage(detail: "no COPY in progress")); }
        this.arm();
        sendCopyDone(w: this.outbox);
        Result<Unit, PgError> f = this.flush(deadline: this.due);
        match (give f) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        return this.finishCopy();
    }

    // Abandon a COPY FROM STDIN (PQputCopyEnd with an error message): CopyFail with `reason`, which the server reports
    // back ("COPY from stdin failed: reason", 57014); nothing is copied. That answer is the expected one, so it is Ok.
    public unsafe fn Result<Unit, PgError> failCopyIn(const ref string reason) {
        if (!this.live) { return Result::Err(error: PgError::Closed); }
        if (this.copyMode != 1ui8) { return Result::Err(error: PgError::Usage(detail: "no COPY in progress")); }
        this.arm();
        if (!sendCopyFail(w: this.outbox, reason: reason)) { return Result::Err(error: PgError::Usage(detail: "the reason holds a NUL byte, which the protocol cannot carry")); }
        Result<Unit, PgError> f = this.flush(deadline: this.due);
        match (give f) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        Result<Optional<int64>, PgError> r = this.finishCopy();
        return match (give r) {
            case Ok(value: rows): Result::Ok(value: Unit::Unit);
            case Err(error: e): {
                if (e.sqlstate() == QUERY_CANCELED) { return Result::Ok(value: Unit::Unit); }
                return Result::Err(error: give e);
            }
        };
    }

    // The next piece of a COPY TO STDOUT (PQgetCopyData), or Done with the number of rows once it ends. A server error
    // ends the COPY, and is returned.
    public unsafe fn Result<CopyChunk, PgError> getCopyData() {
        if (!this.live) { return Result::Err(error: PgError::Closed); }
        if (this.copyMode != 2ui8) { return Result::Err(error: PgError::Usage(detail: "no COPY in progress")); }
        this.arm();
        while (true) {
            Result<BackendMessage, PgError> received = this.receive();
            BackendMessage m = match (give received) { case Ok(value: v): give v; case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            if (background(m: m)) { this.absorb(m: give m); continue; }
            match (give m) {
                case CopyData(data: d): { return Result::Ok(value: CopyChunk::Data(bytes: give d)); }
                case CopyDone: {
                    Result<Optional<int64>, PgError> r = this.finishCopy();
                    return match (give r) { case Ok(value: n): Result::Ok(value: CopyChunk::Done(rows: n)); case Err(error: e): Result::Err(error: give e); };
                }
                case ErrorResponse(fields: f): {
                    ServerError e = ServerError.make(fields: give f);
                    if (e.isFatal()) { this.lose(); return Result::Err(error: PgError::Server(error: give e)); }
                    Result<Optional<int64>, PgError> rest = this.finishCopy();
                    return Result::Err(error: PgError::Server(error: give e));
                }
                case _: { return Result::Err(error: this.broken(detail: "unexpected response from server: a message out of place in COPY TO STDOUT")); }
            };
        }
        return Result::Err(error: PgError::Closed);
    }

    // COPY FROM STDIN with the data read from `source` until its end (pgx's CopyFrom over an io.Reader). A read that
    // fails abandons the COPY with CopyFail, and its error is returned. Gives the number of rows copied.
    public unsafe fn Result<Optional<int64>, PgError> copyFrom(const ref string sql, Reader source) {
        Result<CopyInfo, PgError> started = this.startCopyIn(sql: sql);
        match (give started) { case Ok(value: info): { } case Err(error: e): { return Result::Err(error: give e); } };
        FixedArray<uint8> buf = FixedArray.make(size: COPY_FLUSH);
        while (true) {
            Result<isize, IoError> r = source.read(into: buf.viewMut());
            match (r) {
                case Ok(value: n): {
                    if (n == 0) { return this.endCopyIn(); }
                    Result<Unit, PgError> put = this.putCopyData(bytes: buf.slice(from: 0, count: n));
                    match (give put) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                }
                case Err(error: e): {
                    bool again = match (e.kind()) { case Interrupted: true; case _: false; };
                    if (!again) {
                        Result<Unit, PgError> abandoned = this.failCopyIn(reason: "could not read the data to copy: ".concat(other: strerror(e: e)));
                        return Result::Err(error: PgError::Io(error: e));
                    }
                }
            };
        }
        return Result::Err(error: PgError::Closed);
    }

    // COPY TO STDOUT with the data written to `sink` as it arrives (pgx's CopyTo). A write that fails leaves the rest
    // read and dropped, so the session goes on, and its error is returned. Gives the number of rows copied.
    public unsafe fn Result<Optional<int64>, PgError> copyTo(const ref string sql, Writer sink) {
        Result<CopyInfo, PgError> started = this.startCopyOut(sql: sql);
        match (give started) { case Ok(value: info): { } case Err(error: e): { return Result::Err(error: give e); } };
        Optional<IoError> failed = Optional::None;
        while (true) {
            Result<CopyChunk, PgError> next = this.getCopyData();
            CopyChunk chunk = match (give next) { case Ok(value: c): give c; case Err(error: e): { return Result::Err(error: give e); } };
            match (give chunk) {
                case Data(bytes: b): {
                    bool writing = match (failed) { case Some(value: x): false; case None: true; };
                    if (writing) {
                        Result<Unit, IoError> w = writeAll(w: sink, bytes: b.view());
                        match (w) { case Ok(value: u): { } case Err(error: e): { failed = Optional::Some(value: e); } };
                    }
                }
                case Done(rows: n): {
                    return match (failed) { case Some(value: e): Result::Err(error: PgError::Io(error: e)); case None: Result::Ok(value: n); };
                }
            };
        }
        return Result::Err(error: PgError::Closed);
    }

    // Run `sql` and read up to the COPY's start: CopyInResponse for `wanted` 1, CopyOutResponse for 2. Anything else is
    // read to its end (a COPY of the other direction is ended at once) and refused.
    unsafe fn Result<CopyInfo, PgError> startCopy(const ref string sql, uint8 wanted) {
        Result<Unit, PgError> ok = this.idle();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.arm();
        this.outbox.clear();
        if (!sendQuery(w: this.outbox, sql: sql)) {
            return Result::Err(error: PgError::Usage(detail: "the query text holds a NUL byte, which the protocol cannot carry"));
        }
        Result<Unit, PgError> sent = this.flush(deadline: this.due);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        DynamicArray<PgError> failed = DynamicArray.empty();
        bool other = false;
        bool draining = false;
        bool done = false;
        while (!done) {
            Result<BackendMessage, PgError> received = this.receive();
            BackendMessage m = match (give received) { case Ok(value: v): give v; case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            if (background(m: m)) { this.absorb(m: give m); continue; }
            match (give m) {
                case CopyInResponse(formats: cf): {
                    if (wanted == 1ui8 && !other && failed.length() == 0) {
                        this.copyMode = 1ui8;
                        this.busy = true;
                        return Result::Ok(value: CopyInfo.of(f: cf));
                    }
                    this.outbox.clear();
                    bool framed = sendCopyFail(w: this.outbox, reason: "startCopyOut was called for a COPY FROM STDIN");
                    Result<Unit, PgError> refusal = this.flush(deadline: this.due);
                    match (give refusal) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                    other = true;
                }
                case CopyOutResponse(formats: cf): {
                    if (wanted == 2ui8 && !other && failed.length() == 0) {
                        this.copyMode = 2ui8;
                        this.busy = true;
                        return Result::Ok(value: CopyInfo.of(f: cf));
                    }
                    other = true;
                    draining = true;
                }
                case CopyData(data: d): { if (!draining) { return Result::Err(error: this.broken(detail: unexpected(tag: 100ui8))); } }
                case CopyDone: {
                    if (!draining) { return Result::Err(error: this.broken(detail: unexpected(tag: 99ui8))); }
                    draining = false;
                }
                case RowDescription(fields: f): { other = true; }
                case DataRow(row: r): { other = true; }
                case CommandComplete(commandTag: t): { other = true; }
                case EmptyQueryResponse: { other = true; }
                case ErrorResponse(fields: f): {
                    ServerError e = ServerError.make(fields: give f);
                    if (e.isFatal()) { this.lose(); return Result::Err(error: PgError::Server(error: give e)); }
                    failed.add(item: PgError::Server(error: give e));
                }
                case ReadyForQuery(status: s): { this.txStatus = s; done = true; }
                case _: { return Result::Err(error: this.broken(detail: "unexpected response from server: a message out of place in a COPY's start")); }
            };
        }
        if (other) {
            string direction = "TO STDOUT";
            if (wanted == 1ui8) { direction = "FROM STDIN"; }
            return Result::Err(error: PgError::Usage(detail: "the statement did not start a COPY ".concat(other: direction)));
        }
        if (failed.length() > 0) { return Result::Err(error: failed.remove(index: 0)); }
        return Result::Err(error: PgError::Usage(detail: "the statement did not start a COPY"));
    }

    // While data is still going out, a server that failed the COPY (a row it could not read) has said so, and ignores
    // what follows: read what has arrived, without waiting. Its error ends the COPY.
    unsafe fn Result<Unit, PgError> copyStillWanted() {
        while (true) {
            Result<BackendMessage, PgError> r = this.wire.receive(deadline: Deadline.after(span: Duration.zero()));
            match (give r) {
                case Ok(value: m): {
                    if (background(m: m)) { this.absorb(m: give m); continue; }
                    match (give m) {
                        case ErrorResponse(fields: f): {
                            ServerError e = ServerError.make(fields: give f);
                            if (e.isFatal()) { this.lose(); return Result::Err(error: PgError::Server(error: give e)); }
                            Result<Optional<int64>, PgError> rest = this.finishCopy();
                            return Result::Err(error: PgError::Server(error: give e));
                        }
                        case _: { return Result::Err(error: this.broken(detail: "unexpected response from server: a message out of place in COPY FROM STDIN")); }
                    };
                }
                case Err(error: e): {
                    if (isTimeout(e: e)) { return Result::Ok(value: Unit::Unit); }
                    this.lose();
                    return Result::Err(error: give e);
                }
            };
        }
        return Result::Ok(value: Unit::Unit);
    }

    // The end of a COPY: its CommandComplete ("COPY n"), any error, then ReadyForQuery. Gives the rows the tag reports.
    unsafe fn Result<Optional<int64>, PgError> finishCopy() {
        string tag = "";
        DynamicArray<PgError> failed = DynamicArray.empty();
        bool done = false;
        while (!done) {
            Result<BackendMessage, PgError> received = this.receive();
            BackendMessage m = match (give received) { case Ok(value: v): give v; case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            if (background(m: m)) { this.absorb(m: give m); continue; }
            match (give m) {
                case CommandComplete(commandTag: t): { tag = give t; }
                case ErrorResponse(fields: f): {
                    ServerError e = ServerError.make(fields: give f);
                    if (e.isFatal()) { this.lose(); return Result::Err(error: PgError::Server(error: give e)); }
                    failed.add(item: PgError::Server(error: give e));
                }
                case ReadyForQuery(status: s): { this.txStatus = s; done = true; }
                case _: { return Result::Err(error: this.broken(detail: "unexpected response from server: a message out of place at the end of a COPY")); }
            };
        }
        this.copyMode = 0ui8;
        this.busy = false;
        if (failed.length() > 0) { return Result::Err(error: failed.remove(index: 0)); }
        Rows ended = Rows.make(fields: DynamicArray.empty(), rows: DynamicArray.empty(), tag: give tag);
        return Result::Ok(value: ended.rowsAffected());
    }

    // ---- query timeouts ----

    // A limit on how long a command may take, from the call that sends it to its result (Npgsql's CommandTimeout,
    // pgjdbc's setQueryTimeout; libpq has none). When it passes, this client cancels the command as a cancel token
    // would (a new connection to the same address, with the same encryption), and waits up to `grace` for the server's
    // answer: the call then returns the server's error (57014, "canceling statement due to user request"), and the
    // session goes on. If the server does not answer within `grace`, or the cancel cannot be sent (a session over a
    // caller's transport has no address to send it to), the connection is closed and the call returns `Timeout`.
    // None, the default, waits as long as the command runs; the server's own statement_timeout still applies
    // (`options=-cstatement_timeout=…`). A chunk of rows (nextRows) or a portal's fetch is a call of its own.
    public fn void setQueryTimeout(Optional<Duration> timeout, Duration grace) {
        this.timeoutSetting = timeout;
        this.graceSetting = grace;
    }

    public const fn Optional<Duration> queryTimeout() { return this.timeoutSetting; }

    // A command starts: its deadline is the query timeout from now.
    unsafe fn void arm() {
        this.cancelling = false;
        this.due = match (this.timeoutSetting) { case Some(value: t): Deadline.after(span: t); case None: Deadline.none(); };
    }

    // The next message of a command's result, within the query timeout. When it passes, the command is cancelled, and
    // the server's answer is waited for until the grace passes too, which ends the session.
    unsafe fn Result<BackendMessage, PgError> receive() {
        while (true) {
            Result<BackendMessage, PgError> r = this.wire.receive(deadline: this.due);
            bool late = match (r) { case Err(error: e): isTimeout(e: e); case Ok(value: m): false; };
            if (!late) { return r; }
            if (this.cancelling) { return Result::Err(error: PgError::Timeout); }
            this.cancelling = true;
            this.due = Deadline.after(span: this.graceSetting);
            Result<Unit, PgError> sent = this.cancelRunning();
            match (give sent) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: PgError::Timeout); } };
        }
        return Result::Err(error: PgError::Timeout);
    }

    // Cancel this session's command, through the route and dialer it connected with, within the grace.
    unsafe fn Result<Unit, PgError> cancelRunning() {
        if (this.cancelKey.length() == 0) { return Result::Err(error: PgError::Cancel(detail: "no cancellation key received")); }
        return match (this.route) {
            case Some(value: r): Connection::sendCancel(route: r, opener: this.dialing, pid: this.pid, key: this.cancelKey, limit: this.due);
            case None: Result::Err(error: PgError::Cancel(detail: "a session over a caller's transport (connectOver) has no address to send a cancel request to"));
        };
    }

    // ---- cancel ----

    // A token that cancels this session's running command from anywhere: another isolate, a timer (libpq's
    // PQcancelCreate). It holds a copy of the configuration, the address this session reached, and the server's
    // process id and secret key; see CancelToken. libpq's errors: "connection not open" for a closed connection, "no
    // cancellation key received" when the server sent no BackendKeyData. A session over a caller's transport
    // (`connectOver`) has no address of this client's to send a cancel request to.
    public fn Result<CancelToken, PgError> cancelToken() {
        if (!this.live) { return Result::Err(error: PgError::Cancel(detail: "connection not open")); }
        if (this.cancelKey.length() == 0) { return Result::Err(error: PgError::Cancel(detail: "no cancellation key received")); }
        return match (this.route) {
            case Some(value: r): Result::Ok(value: CancelToken.make(route: copy r, pid: this.pid, key: copy this.cancelKey));
            case None: Result::Err(error: PgError::Cancel(detail: "a session over a caller's transport (connectOver) has no address to send a cancel request to"));
        };
    }

    // Send a cancel request as libpq's PQcancelBlocking does: a new connection to the same address, with the same
    // encryption and its fallbacks (libpq 17's encrypted cancel), CancelRequest in place of the startup packet, then
    // the server closing it, all within connect_timeout. A failure is reported with libpq's lead.
    static unsafe fn Result<Unit, PgError> sendCancel(const ref CancelRoute route, ref Opener opener, int32 pid, const ref DynamicArray<uint8> key, Deadline limit) {
        ConnectError failures = ConnectError.make();
        Errand errand = Errand.cancelling(pid: pid, key: copy key, limit: limit);
        Visit v = Connection::visit(config: route.config(), hostIndex: route.hostIndex(), target: route.target(), opener: opener, failures: failures, errand: errand);
        bool sent = match (v) { case Connected(connection: c): true; case _: false; };
        if (sent) { return Result::Ok(value: Unit::Unit); }
        return Result::Err(error: PgError::Connect(error: give failures));
    }
    friend postgres::CancelToken::cancel[sendCancel];
    friend postgres::CancelToken::cancelWith[sendCancel];

    // CancelRequest, then the server's close (libpq's CONNECTION_AWAITING_RESPONSE in PQcancelPoll).
    unsafe fn Result<Unit, PgError> cancelExchange(int32 pid, const ref DynamicArray<uint8> key, Deadline deadline) {
        this.outbox.clear();
        sendCancelRequest(w: this.outbox, processId: pid, secretKey: key.view());
        Result<Unit, PgError> sent = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
        this.outbox.clear();
        match (give sent) {
            case Ok(value: u): { }
            case Err(error: e): {
                bool late = match (e) { case Timeout: true; case _: false; };
                if (late) { return Result::Err(error: give e); }
                return Result::Err(error: PgError::Cancel(detail: "could not send cancel packet: ".concat(other: e.message())));
            }
        };
        Result<bool, PgError> ended = this.wire.awaitEnd(deadline: deadline);
        return match (give ended) {
            case Ok(value: answered): {
                if (answered) { return Result::Err(error: PgError::Cancel(detail: "unexpected response from server")); }
                return Result::Ok(value: Unit::Unit);
            }
            case Err(error: e): Result::Err(error: give e);
        };
    }

    // ---- the extended protocol's steps ----

    // Ready for a command: open, and not reading another's result.
    fn Result<Unit, PgError> idle() {
        if (!this.live) { return Result::Err(error: PgError::Closed); }
        if (this.pipeline != 0ui8) { return Result::Err(error: PgError::Usage(detail: "synchronous command execution functions are not allowed in pipeline mode")); }
        if (this.busy) { return Result::Err(error: PgError::Usage(detail: "another command is already in progress")); }
        return Result::Ok(value: Unit::Unit);
    }

    // Describe `q` if it is SQL, then bind it into `portal`, and execute it there unless `run` is false. After
    // this the result is open: `openFields` are its columns, and readRows reads it.
    unsafe fn Result<Unit, PgError> start(const ref Query q, const ref string portal, bool run) {
        Result<Unit, PgError> ok = this.idle();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.arm();
        this.fromCache = false;
        Result<Described, PgError> d = this.describe(q: q);
        Described shape = match (give d) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
        return this.bindAndExecute(q: q, shape: shape, portal: portal, run: run);
    }

    // What the server says about `q`: for SQL, by Parse and Describe of the unnamed statement; for a prepared
    // statement, what it said when it was prepared.
    unsafe fn Result<Described, PgError> describe(const ref Query q) {
        if (q.problem().length() > 0) { return Result::Err(error: PgError::Value(detail: copy q.problem())); }
        if (q.parameterCount() > 65535) { return Result::Err(error: PgError::Usage(detail: "number of parameters must be between 0 and 65535")); }
        if (q.isPrepared()) {
            return Result::Ok(value: Described.make(name: copy q.statement(), types: copy q.parameterTypes(), fields: copy q.columns()));
        }
        string unnamed = "";
        CacheMode mode = this.cache.mode();
        bool off = match (mode) { case Off: true; case _: false; };
        if (off) { return this.parseAndDescribe(name: unnamed, sql: q.sql()); }
        bool named = match (mode) { case Statements: true; case _: false; };
        if (this.cache.lookup(sql: q.sql())) {
            this.fromCache = true;
            this.cachedSql = copy q.sql();
            Described hit = Described.make(name: copy this.cache.entry(sql: q.sql()).name(), types: copy this.cache.entry(sql: q.sql()).types(),
                                           fields: copy this.cache.entry(sql: q.sql()).columns());
            if (!named) { hit.reparseAs(sql: q.sql()); }
            return Result::Ok(value: give hit);
        }
        string name = "";
        if (named) { name = this.cache.nextName(); }
        this.cache.makeRoom(closing: ref this.closing);
        Result<Described, PgError> d = this.parseAndDescribe(name: name, sql: q.sql());
        match (d) {
            case Ok(value: shape): {
                this.cache.add(sql: copy q.sql(), statement: CachedStatement.make(name: copy name, types: copy shape.types(), fields: copy shape.fields()), closing: ref this.closing);
            }
            case Err(error: e): { }
        };
        return d;
    }

    // Close messages for the statements the cache let go, ahead of the next exchange; their CloseCompletes are owed.
    unsafe fn void queueCloses() {
        foreach (string name in this.closing) {
            bool framed = sendCloseStatement(w: this.outbox, name: name);
            this.closesOwed = this.closesOwed + 1;
        }
        this.closing = DynamicArray.empty();
    }

    // A CloseComplete for a Close queued by the cache, which may come ahead of an exchange's own messages.
    fn bool owedClose() {
        if (this.closesOwed == 0) { return false; }
        this.closesOwed = this.closesOwed - 1;
        return true;
    }

    // What a command tag means for the cache: DISCARD ALL and DEALLOCATE ALL drop every prepared statement.
    fn void noteTag(const ref string tag) {
        if (tag.equals(other: "DISCARD ALL") || tag.equals(other: "DEALLOCATE ALL")) {
            this.cache.clear();
            this.closing = DynamicArray.empty();
        }
    }

    // Parse `sql` as statement `name`, and describe it: ParseComplete, ParameterDescription, then RowDescription
    // or NoData, then ReadyForQuery.
    unsafe fn Result<Described, PgError> parseAndDescribe(const ref string name, const ref string sql) {
        this.outbox.clear();
        this.queueCloses();
        BindValues none = BindValues.make();
        if (!sendParse(w: this.outbox, name: name, sql: sql, params: none)) {
            return Result::Err(error: PgError::Usage(detail: "the query text holds a NUL byte, which the protocol cannot carry"));
        }
        bool framed = sendDescribeStatement(w: this.outbox, name: name);
        sendSync(w: this.outbox);
        Result<Unit, PgError> sent = this.flush(deadline: this.due);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        return this.readDescription(name: name, pipelined: false);
    }

    // ParseComplete, ParameterDescription, then RowDescription or NoData: the server's description of statement `name`,
    // then (outside a pipeline) ReadyForQuery. In a pipeline the description ends it, or an error does.
    unsafe fn Result<Described, PgError> readDescription(const ref string name, bool pipelined) {
        bool parsed = false;
        bool described = false;
        bool shaped = false;   // RowDescription or NoData
        DynamicArray<uint32> types = DynamicArray.empty();
        DynamicArray<FieldDescription> fields = DynamicArray.empty();
        DynamicArray<PgError> failed = DynamicArray.empty();
        bool done = false;
        while (!done) {
            if (pipelined && (shaped || failed.length() > 0)) { break; }
            Result<BackendMessage, PgError> received = this.receive();
            BackendMessage m = match (give received) { case Ok(value: v): give v; case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            if (background(m: m)) { this.absorb(m: give m); continue; }
            match (give m) {
                case CloseComplete: { if (parsed || !this.owedClose()) { return Result::Err(error: this.broken(detail: unexpected(tag: 51ui8))); } }
                case ParseComplete: {
                    if (parsed || failed.length() > 0) { return Result::Err(error: this.broken(detail: unexpected(tag: 49ui8))); }
                    parsed = true;
                }
                case ParameterDescription(oids: o): {
                    if (!parsed || described) { return Result::Err(error: this.broken(detail: unexpected(tag: 116ui8))); }
                    types = give o;
                    described = true;
                }
                case RowDescription(fields: f): {
                    if (!described || shaped) { return Result::Err(error: this.broken(detail: unexpected(tag: 84ui8))); }
                    fields = give f;
                    shaped = true;
                }
                case NoData: {
                    if (!described || shaped) { return Result::Err(error: this.broken(detail: unexpected(tag: 110ui8))); }
                    shaped = true;
                }
                case ErrorResponse(fields: f): {
                    ServerError e = ServerError.make(fields: give f);
                    if (e.isFatal()) { this.lose(); return Result::Err(error: PgError::Server(error: give e)); }
                    failed.add(item: PgError::Server(error: give e));
                }
                case ReadyForQuery(status: s): {
                    if (pipelined) { return Result::Err(error: this.broken(detail: unexpected(tag: 90ui8))); }
                    this.txStatus = s;
                    done = true;
                }
                case _: { return Result::Err(error: this.broken(detail: "unexpected response from server: a message out of place while describing a statement")); }
            };
        }
        if (failed.length() > 0) { return Result::Err(error: failed.remove(index: 0)); }
        if (!shaped) { return Result::Err(error: this.broken(detail: "the server did not describe the statement before it was ready")); }
        return Result::Ok(value: Described.make(name: copy name, types: give types, fields: give fields));
    }

    // Bind `q`'s parameters, each encoded as the type described for it, into `portal`, asking for each column in
    // binary when this client reads its type that way; then Execute it there unless `run` is false; then Sync.
    unsafe fn Result<Unit, PgError> bindAndExecute(const ref Query q, const ref Described shape, const ref string portal, bool run) {
        BindValues params = q.encoded(types: shape.types());
        DynamicArray<int16> formats = DynamicArray.withCapacity(capacity: shape.fields().length());
        DynamicArray<FieldDescription> columns = DynamicArray.withCapacity(capacity: shape.fields().length());
        isize i = 0;
        while (i < shape.fields().length()) {
            int16 format = 0i16;
            if (hasBinaryCodec(oid: shape.fields()[i].typeOid())) { format = 1i16; }
            formats.add(item: format);
            columns.add(item: shape.fields()[i].withFormat(format: format));
            i = i + 1;
        }
        this.outbox.clear();
        this.queueCloses();
        if (shape.reparse()) {
            if (!sendParse(w: this.outbox, name: shape.name(), sql: shape.sql(), params: params)) {
                return Result::Err(error: PgError::Usage(detail: "the query text holds a NUL byte, which the protocol cannot carry"));
            }
        }
        if (!sendBind(w: this.outbox, portal: portal, statement: shape.name(), params: params, resultFormats: formats)) {
            return Result::Err(error: PgError::Usage(detail: "a portal or statement name holds a NUL byte"));
        }
        if (shape.reparse()) { bool described = sendDescribePortal(w: this.outbox, name: portal); }
        if (run) { bool framed = sendExecute(w: this.outbox, portal: portal, maxRows: 0); }
        sendSync(w: this.outbox);
        Result<Unit, PgError> sent = this.flush(deadline: this.due);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.openFields = give columns;
        this.bindPending = true;
        this.parsePending = shape.reparse();
        this.portalDescribing = shape.reparse();
        this.rowLimited = false;
        this.busy = true;
        return Result::Ok(value: Unit::Unit);
    }

    // Read the open result: BindComplete (when a Bind was sent), DataRows, the command's end (CommandComplete,
    // EmptyQueryResponse or PortalSuspended), then ReadyForQuery. With `limit` > 0, return once that many rows have
    // come and leave the rest open for the next call. A server error ends the result and is returned once the
    // server is ready; `keep` false drops the rows as they arrive.
    unsafe fn Result<Rows, PgError> readRows(isize limit, bool keep, bool pipelined) {
        DynamicArray<RowValues> rows = DynamicArray.empty();
        DynamicArray<int16> formats = DynamicArray.withCapacity(capacity: this.openFields.length());
        isize k = 0;
        while (k < this.openFields.length()) { formats.add(item: this.openFields[k].format()); k = k + 1; }
        string tag = "";
        bool suspended = false;
        bool ended = false;   // the command's end, or its error, has come
        DynamicArray<PgError> failed = DynamicArray.empty();
        bool copyRefused = false;
        bool copying = false;
        bool chunk = false;   // `limit` rows have come: the result stays open
        bool done = false;
        while (!done) {
            if (!ended && limit > 0 && rows.length() >= limit) { chunk = true; break; }
            // In a pipeline a command's result ends with the command: its ReadyForQuery belongs to a sync of its own.
            if (ended && pipelined) { break; }
            Result<BackendMessage, PgError> received = this.receive();
            BackendMessage m = match (give received) { case Ok(value: v): give v; case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            if (background(m: m)) { this.absorb(m: give m); continue; }
            match (give m) {
                case CloseComplete: { if (!this.bindPending || !this.owedClose()) { return Result::Err(error: this.broken(detail: unexpected(tag: 51ui8))); } }
                case ParseComplete: {
                    if (!this.parsePending || ended) { return Result::Err(error: this.broken(detail: unexpected(tag: 49ui8))); }
                    this.parsePending = false;
                }
                case BindComplete: {
                    if (!this.bindPending || this.parsePending || ended) { return Result::Err(error: this.broken(detail: unexpected(tag: 50ui8))); }
                    this.bindPending = false;
                }
                case RowDescription(fields: f): {
                    // The portal's own description (a describe-only cache's run): the columns as the server has them now.
                    if (!this.portalDescribing || this.bindPending || ended) { return Result::Err(error: this.broken(detail: unexpected(tag: 84ui8))); }
                    this.portalDescribing = false;
                    if (this.fromCache && !sameColumns(a: this.openFields, b: f)) { this.cache.forget(sql: this.cachedSql, closing: ref this.closing); }
                    this.openFields = give f;
                    formats = DynamicArray.withCapacity(capacity: this.openFields.length());
                    isize c = 0;
                    while (c < this.openFields.length()) { formats.add(item: this.openFields[c].format()); c = c + 1; }
                }
                case NoData: {
                    if (!this.portalDescribing || this.bindPending || ended) { return Result::Err(error: this.broken(detail: unexpected(tag: 110ui8))); }
                    this.portalDescribing = false;
                    if (this.fromCache && this.openFields.length() > 0) { this.cache.forget(sql: this.cachedSql, closing: ref this.closing); }
                    this.openFields = DynamicArray.empty();
                    formats = DynamicArray.empty();
                }
                case DataRow(row: r): {
                    if (this.bindPending || this.portalDescribing || ended) { return Result::Err(error: this.broken(detail: unexpected(tag: 68ui8))); }
                    if (r.columnCount() != this.openFields.length()) { return Result::Err(error: this.broken(detail: "unexpected field count in \"D\" message")); }
                    if (!textValid(row: r, formats: formats)) {
                        this.lose();
                        return Result::Err(error: PgError::Protocol(error: ProtocolError::NotUtf8(tag: 68ui8)));
                    }
                    if (keep) { rows.add(item: give r); } else { RowValues dropped = give r; }
                }
                case CommandComplete(commandTag: t): {
                    if (this.bindPending || this.portalDescribing || ended) { return Result::Err(error: this.broken(detail: unexpected(tag: 67ui8))); }
                    this.noteTag(tag: t);
                    tag = give t;
                    ended = true;
                }
                case EmptyQueryResponse: {
                    if (this.bindPending || ended) { return Result::Err(error: this.broken(detail: unexpected(tag: 73ui8))); }
                    ended = true;
                }
                case PortalSuspended: {
                    if (this.bindPending || ended || !this.rowLimited) { return Result::Err(error: this.broken(detail: unexpected(tag: 115ui8))); }
                    suspended = true;
                    ended = true;
                }
                case ErrorResponse(fields: f): {
                    ServerError e = ServerError.make(fields: give f);
                    if (e.isFatal()) { this.lose(); return Result::Err(error: PgError::Server(error: give e)); }
                    failed.add(item: PgError::Server(error: give e));
                    ended = true;
                }
                case CopyInResponse(formats: cf): {
                    // COPY has its own interface; refusing it here keeps the session usable.
                    this.outbox.clear();
                    bool framed = sendCopyFail(w: this.outbox, reason: "COPY runs through startCopyIn or copyFrom, not query");
                    Result<Unit, PgError> refusal = this.flush(deadline: this.due);
                    match (give refusal) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                    copyRefused = true;
                }
                case CopyOutResponse(formats: cf): { copyRefused = true; copying = true; }
                case CopyData(data: d): { if (!copying) { return Result::Err(error: this.broken(detail: unexpected(tag: 100ui8))); } }
                case CopyDone: {
                    if (!copying) { return Result::Err(error: this.broken(detail: unexpected(tag: 99ui8))); }
                    copying = false;
                }
                case ReadyForQuery(status: s): {
                    if (pipelined || (this.bindPending && failed.length() == 0)) { return Result::Err(error: this.broken(detail: unexpected(tag: 90ui8))); }
                    this.txStatus = s;
                    done = true;
                }
                case _: { return Result::Err(error: this.broken(detail: "unexpected response from server: a message out of place in a query's result")); }
            };
        }
        if (chunk) { return Result::Ok(value: Rows.make(fields: copy this.openFields, rows: give rows, tag: "")); }
        this.busy = false;
        this.streaming = false;
        this.bindPending = false;
        this.parsePending = false;
        this.portalDescribing = false;
        if (failed.length() > 0) {
            if (this.fromCache && isStalePlan(e: failed[0])) { this.cache.forget(sql: this.cachedSql, closing: ref this.closing); }
            return Result::Err(error: failed.remove(index: 0));
        }
        if (copyRefused) { return Result::Err(error: PgError::Usage(detail: "COPY runs through startCopyIn/startCopyOut (or copyFrom/copyTo), not query; the statement was not run, or its output was discarded")); }
        Rows result = Rows.make(fields: copy this.openFields, rows: give rows, tag: give tag);
        if (suspended) { result.suspend(); }
        return Result::Ok(value: give result);
    }

    // Close (statement or portal) and Sync: CloseComplete, then ReadyForQuery.
    unsafe fn Result<Unit, PgError> closeExchange() {
        Result<Unit, PgError> sent = this.flush(deadline: this.due);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        bool closed = false;
        DynamicArray<PgError> failed = DynamicArray.empty();
        bool done = false;
        while (!done) {
            Result<BackendMessage, PgError> received = this.receive();
            BackendMessage m = match (give received) { case Ok(value: v): give v; case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            if (background(m: m)) { this.absorb(m: give m); continue; }
            match (give m) {
                case CloseComplete: {
                    if (closed) { return Result::Err(error: this.broken(detail: unexpected(tag: 51ui8))); }
                    closed = true;
                }
                case ErrorResponse(fields: f): {
                    ServerError e = ServerError.make(fields: give f);
                    if (e.isFatal()) { this.lose(); return Result::Err(error: PgError::Server(error: give e)); }
                    failed.add(item: PgError::Server(error: give e));
                }
                case ReadyForQuery(status: s): { this.txStatus = s; done = true; }
                case _: { return Result::Err(error: this.broken(detail: "unexpected response from server: a message out of place after a Close")); }
            };
        }
        if (failed.length() > 0) { return Result::Err(error: failed.remove(index: 0)); }
        if (!closed) { return Result::Err(error: this.broken(detail: "the server was ready before it confirmed the Close")); }
        return Result::Ok(value: Unit::Unit);
    }

    // What the server sends outside any result: a notice, a parameter's new value, a notification.
    fn void absorb(BackendMessage m) {
        match (give m) {
            case NoticeResponse(fields: f): { this.deliver(fields: give f); }
            case ParameterStatus(name: n, value: v): { this.setParameter(name: give n, value: give v); }
            case NotificationResponse(processId: p, channel: c, payload: x): { this.pending.add(item: Notification.make(processId: p, channel: give c, payload: give x)); }
            case _: { }
        };
    }

    // A message the protocol does not allow here: the session cannot recover its place, so it ends.
    unsafe fn PgError broken(const ref string detail) {
        this.lose();
        return PgError::Protocol(error: ProtocolError::Violation(detail: copy detail));
    }

    // Send Terminate and close the transport. Every later call returns `Closed`. Closing a closed connection does
    // nothing.
    public unsafe fn void close() {
        if (!this.live) { return; }
        this.outbox.clear();
        sendTerminate(w: this.outbox);
        Result<Unit, PgError> sent = this.wire.send(bytes: this.outbox.view(), deadline: Deadline.after(span: Duration.fromSecs(s: 1i64)));
        this.lose();
    }

    // The value of a run-time parameter the server reported (ParameterStatus): server_version, TimeZone,
    // application_name, … kept current as the server sends changes.
    public const fn Optional<string> parameter(const ref string name) {
        isize i = 0;
        while (i < this.paramNames.length()) {
            if (this.paramNames[i].equals(other: name)) { return Optional::Some(value: copy this.paramValues[i]); }
            i = i + 1;
        }
        return Optional::None;
    }

    // The server's version as libpq's PQserverVersion gives it: 180004 for 18.4, 190000 for 19beta4, 90624 for
    // 9.6.24; 0 if the server did not report one.
    public const fn int32 serverVersion() {
        Optional<string> v = this.parameter(name: "server_version");
        return match (v) { case Some(value: text): versionNumber(text: text); case None: 0; };
    }

    public const fn TransactionStatus transactionStatus() {
        if (!this.live) { return TransactionStatus::Unknown; }
        if (this.busy || this.streaming || this.queue.length() > 0) { return TransactionStatus::Active; }
        if (this.txStatus == 84ui8) { return TransactionStatus::InTransaction; }
        if (this.txStatus == 69ui8) { return TransactionStatus::Failed; }
        return TransactionStatus::Idle;
    }

    // The server process serving this session (pg_backend_pid()).
    public const fn int32 processId() { return this.pid; }
    // The protocol version in use, as PROTOCOL_3_0 or PROTOCOL_3_2.
    public const fn int32 protocolVersion() { return this.protocol; }
    public const fn bool isClosed() { return !this.live; }

    // Notices go to `handler` from now on, instead of std::log.
    public fn void setNoticeHandler(Owned<NoticeHandler> handler) { this.handler = Optional::Some(value: give handler); }
    public fn void clearNoticeHandler() { this.handler = Optional::None; }

    // The LISTEN/NOTIFY notifications received so far, oldest first, as libpq's PQnotifies queues them. They
    // arrive with query results; taking them empties the queue.
    public fn DynamicArray<Notification> takeNotifications() {
        DynamicArray<Notification> taken = DynamicArray.empty();
        bool more = true;
        while (more) {
            Optional<Notification> last = this.pending.pop();
            match (give last) { case Some(value: n): { taken.insertAt(index: 0, item: give n); } case None: { more = false; } };
        }
        return taken;
    }

    // The next LISTEN/NOTIFY notification: the oldest one already received, else the next to arrive within `timeout`
    // (None waits as long as it takes). Notices and parameter changes are taken in on the way. Returns None when the
    // time passes first; the session stays open. libpq leaves this wait to the application (poll PQsocket, then
    // PQconsumeInput and PQnotifies); this is that loop. A server that ends the session while it waits (a FATAL
    // error, an administrator's termination) returns its error.
    public unsafe fn Result<Optional<Notification>, PgError> waitForNotification(Optional<Duration> timeout) {
        Result<Unit, PgError> ok = this.idle();
        match (give ok) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        if (this.pending.length() > 0) { return Result::Ok(value: Optional::Some(value: this.pending.remove(index: 0))); }
        Deadline until = match (timeout) { case Some(value: t): Deadline.after(span: t); case None: Deadline.none(); };
        while (true) {
            Result<BackendMessage, PgError> received = this.wire.receive(deadline: until);
            match (give received) {
                case Ok(value: m): {
                    if (background(m: m)) { this.absorb(m: give m); }
                    else {
                        match (give m) {
                            case ErrorResponse(fields: f): {
                                ServerError e = ServerError.make(fields: give f);
                                this.lose();
                                return Result::Err(error: PgError::Server(error: give e));
                            }
                            case _: { return Result::Err(error: this.broken(detail: "unexpected response from server: a message other than a notice or a notification while idle")); }
                        };
                    }
                    if (this.pending.length() > 0) { return Result::Ok(value: Optional::Some(value: this.pending.remove(index: 0))); }
                }
                case Err(error: e): {
                    if (isTimeout(e: e)) { return Result::Ok(value: Optional::None); }
                    this.lose();
                    return Result::Err(error: give e);
                }
            };
        }
        return Result::Ok(value: Optional::None);
    }

    // ---- target_session_attrs ----

    // libpq's CONNECTION_CHECK_TARGET (fe-connect.c): whether this server is the kind `target` accepts. The server's
    // reported default_transaction_read_only and in_hot_standby decide when it sent both (14 and later); else it is
    // asked, within the connect's deadline: SHOW transaction_read_only, or pg_is_in_recovery(). A mismatch is
    // PgError::Target with libpq's words, and the connect moves on to the next host.
    unsafe fn Result<Unit, PgError> checkTarget(SessionTarget target, Deadline deadline) {
        bool any = match (target) { case Any: true; case _: false; };
        if (any) { return Result::Ok(value: Unit::Unit); }
        bool access = match (target) { case ReadWrite: true; case ReadOnly: true; case _: false; };
        if (access) {
            Optional<string> dtro = this.parameter(name: "default_transaction_read_only");
            Optional<string> standbyNow = this.parameter(name: "in_hot_standby");
            bool known = match (dtro) { case Some(value: x): match (standbyNow) { case Some(value: y): true; case None: false; }; case None: false; };
            bool readOnly = false;
            if (known) {
                bool a = match (dtro) { case Some(value: x): x.equals(other: "on"); case None: false; };
                bool b = match (standbyNow) { case Some(value: y): y.equals(other: "on"); case None: false; };
                readOnly = a || b;
            } else {
                Result<string, PgError> shown = this.probe(sql: "SHOW transaction_read_only", deadline: deadline);
                match (give shown) {
                    case Ok(value: v): { readOnly = v.startsWith(prefix: "on"); }
                    case Err(error: e): {
                        if (isTimeout(e: e) || !this.live) { return Result::Err(error: give e); }
                        return Result::Err(error: PgError::Target(detail: "\"SHOW transaction_read_only\" failed"));
                    }
                };
            }
            bool wantsWrite = match (target) { case ReadWrite: true; case _: false; };
            if (wantsWrite && readOnly) { return Result::Err(error: PgError::Target(detail: "session is read-only")); }
            if (!wantsWrite && !readOnly) { return Result::Err(error: PgError::Target(detail: "session is not read-only")); }
            return Result::Ok(value: Unit::Unit);
        }
        bool standby = false;
        Optional<string> reported = this.parameter(name: "in_hot_standby");
        bool knows = match (reported) { case Some(value: x): true; case None: false; };
        if (this.serverVersion() > 0 && this.serverVersion() < 90000) { standby = false; }
        else if (knows) { standby = match (reported) { case Some(value: x): x.equals(other: "on"); case None: false; }; }
        else {
            // The query is sent qualified; libpq's message names it unqualified.
            Result<string, PgError> recovering = this.probe(sql: "SELECT pg_catalog.pg_is_in_recovery()", deadline: deadline);
            match (give recovering) {
                case Ok(value: v): { standby = v.startsWith(prefix: "t"); }
                case Err(error: e): {
                    if (isTimeout(e: e) || !this.live) { return Result::Err(error: give e); }
                    return Result::Err(error: PgError::Target(detail: "\"SELECT pg_is_in_recovery()\" failed"));
                }
            };
        }
        bool wantsPrimary = match (target) { case Primary: true; case _: false; };
        if (wantsPrimary && standby) { return Result::Err(error: PgError::Target(detail: "server is in hot standby mode")); }
        if (!wantsPrimary && !standby) { return Result::Err(error: PgError::Target(detail: "server is not in hot standby mode")); }
        return Result::Ok(value: Unit::Unit);
    }

    // The first value of `sql`'s first row, as text, within `deadline` (the connect's).
    unsafe fn Result<string, PgError> probe(const ref string sql, Deadline deadline) {
        this.outbox.clear();
        if (!sendQuery(w: this.outbox, sql: sql)) { return Result::Err(error: nulInQuery()); }
        Result<Unit, PgError> sent = this.flush(deadline: deadline);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.due = deadline;
        this.cancelling = false;
        Result<DynamicArray<Rows>, PgError> r = this.collect();
        DynamicArray<Rows> results = match (give r) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
        if (results.length() == 0 || results[0].rowCount() == 0 || results[0].isNull(row: 0, column: 0)) {
            return Result::Err(error: PgError::Target(detail: "no value"));
        }
        Result<string, Utf8Error> text = utf8Decode(bytes: results[0].bytes(row: 0, column: 0));
        return match (give text) { case Ok(value: t): Result::Ok(value: give t); case Err(error: e): Result::Err(error: PgError::Target(detail: "no value")); };
    }

    // ---- startup ----

    // From the StartupMessage to ReadyForQuery: authentication, then the session's parameters and cancel key.
    // `hostIndex` is the host the password file was read for (-1 for a caller's transport).
    unsafe fn Result<Unit, PgError> startup(const ref Config config, isize hostIndex, Deadline deadline) {
        this.outbox.clear();
        if (!sendStartup(w: this.outbox, version: config.maxProtocolVersion(), names: config.startupNames(), values: config.startupValues())) {
            return Result::Err(error: PgError::Usage(detail: "a connection setting holds a NUL byte, which the protocol cannot carry"));
        }
        this.protocol = config.maxProtocolVersion();
        Result<Unit, PgError> sent = this.flush(deadline: deadline);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };

        string secret = config.password();
        if (secret.length() == 0 && hostIndex >= 0) {
            Optional<string> fromFile = config.host(index: hostIndex).filePasswordFor();
            match (give fromFile) { case Some(value: p): { secret = give p; } case None: { } };
        }
        bool authenticated = false;
        bool finished = false;          // libpq's client_finished_auth
        bool negotiated = false;
        int32 saslStage = 0;            // 0 none, 1 client-first sent, 2 client-final sent, 3 server verified
        DynamicArray<ScramClient> scram = DynamicArray.empty();   // zero or one
        while (true) {
            Result<BackendMessage, PgError> received = this.wire.receive(deadline: deadline);
            BackendMessage m = match (give received) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
            if (!authenticated) {
                match (give m) {
                    case AuthenticationOk: {
                        bool bound = saslStage == 3 && scram.length() > 0 && scram[0].mechanism().equals(other: "SCRAM-SHA-256-PLUS");
                        Result<Unit, PgError> allowed = this.expectedOk(config: config, finished: finished, bound: bound);
                        match (give allowed) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        if (saslStage == 1 || saslStage == 2) {
                            return Result::Err(error: PgError::Auth(detail: "server did not complete authentication: it sent AuthenticationOk before proving that it knows the password"));
                        }
                        authenticated = true;
                    }
                    case AuthenticationCleartextPassword: {
                        Result<Unit, PgError> allowed = expected(config: config, code: AUTH_PASSWORD, finished: finished);
                        match (give allowed) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        if (secret.length() == 0) { return Result::Err(error: noPassword()); }
                        this.outbox.clear();
                        if (!sendPassword(w: this.outbox, text: secret)) { return Result::Err(error: PgError::Usage(detail: "the password holds a NUL byte, which the protocol cannot carry")); }
                        Result<Unit, PgError> s = this.flush(deadline: deadline);
                        match (give s) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        finished = true;
                    }
                    case AuthenticationMd5Password(salt: salt): {
                        Result<Unit, PgError> allowed = expected(config: config, code: AUTH_MD5, finished: finished);
                        match (give allowed) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        if (secret.length() == 0) { return Result::Err(error: noPassword()); }
                        string response = md5Password(user: config.user(), password: secret, salt: salt);
                        this.outbox.clear();
                        if (!sendPassword(w: this.outbox, text: response)) { return Result::Err(error: PgError::Usage(detail: "the md5 response holds a NUL byte")); }
                        Result<Unit, PgError> s = this.flush(deadline: deadline);
                        match (give s) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        finished = true;
                    }
                    case AuthenticationSasl(mechanisms: offered): {
                        Result<Unit, PgError> allowed = expected(config: config, code: AUTH_SASL, finished: finished);
                        match (give allowed) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        Result<Unit, PgError> begun = this.beginSasl(config: config, offered: offered, secret: secret, scram: ref scram, deadline: deadline);
                        match (give begun) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        saslStage = 1;
                    }
                    case AuthenticationSaslContinue(data: d): {
                        Result<Unit, PgError> allowed = expected(config: config, code: AUTH_SASL_CONT, finished: finished);
                        match (give allowed) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        if (saslStage == 0) { return Result::Err(error: PgError::Auth(detail: "fe_sendauth: invalid authentication request from server: AUTH_REQ_SASL_CONT without AUTH_REQ_SASL")); }
                        if (saslStage != 1) { return Result::Err(error: violation(detail: "unexpected response from server: a second AuthenticationSASLContinue")); }
                        Result<string, PgError> serverFirst = saslText(data: d);
                        string first = match (give serverFirst) { case Ok(value: t): give t; case Err(error: e): { return Result::Err(error: give e); } };
                        Result<string, AuthError> answer = scram[0].clientFinal(serverFirst: first);
                        string reply = match (give answer) { case Ok(value: t): give t; case Err(error: e): { return Result::Err(error: PgError::Auth(detail: e.message())); } };
                        this.outbox.clear();
                        saslResponse(w: this.outbox, data: reply.bytes());
                        Result<Unit, PgError> s = this.flush(deadline: deadline);
                        match (give s) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        saslStage = 2;
                    }
                    case AuthenticationSaslFinal(data: d): {
                        Result<Unit, PgError> allowed = expected(config: config, code: AUTH_SASL_FIN, finished: finished);
                        match (give allowed) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        if (saslStage != 2) { return Result::Err(error: PgError::Auth(detail: "AuthenticationSASLFinal received from server, but SASL authentication was not completed")); }
                        Result<string, PgError> serverFinal = saslText(data: d);
                        string last = match (give serverFinal) { case Ok(value: t): give t; case Err(error: e): { return Result::Err(error: give e); } };
                        Result<Unit, AuthError> verified = scram[0].verifyServerFinal(serverFinal: last);
                        match (give verified) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: PgError::Auth(detail: e.message())); } };
                        saslStage = 3;
                        finished = true;
                    }
                    case AuthenticationUnsupported(method: code): {
                        Result<Unit, PgError> allowed = expected(config: config, code: code, finished: finished);
                        match (give allowed) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        return Result::Err(error: PgError::Auth(detail: unsupportedMethod(code: code)));
                    }
                    case NegotiateProtocolVersion(newestVersion: v, unrecognized: names): {
                        if (negotiated) { return Result::Err(error: negotiation(what: "received duplicate protocol negotiation message")); }
                        negotiated = true;
                        Result<Unit, PgError> agreed = this.negotiate(config: config, offered: v, unrecognized: names);
                        match (give agreed) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                    }
                    case ErrorResponse(fields: f): {
                        // Before authentication completes, libpq tries the next encryption method (or host) on a
                        // refusal; the caller decides by this.
                        this.refusedBeforeAuth = true;
                        return Result::Err(error: PgError::Server(error: ServerError.make(fields: give f)));
                    }
                    case NoticeResponse(fields: f): { this.deliver(fields: give f); }
                    case _: {
                        return Result::Err(error: violation(detail: "expected authentication request from server, but received a message of another kind"));
                    }
                };
            } else {
                match (give m) {
                    case BackendKeyData(processId: p, secretKey: k): {
                        if (this.protocol == PROTOCOL_3_0 && k.length() != 4) {
                            isize n = k.length();
                            return Result::Err(error: violation(detail: "received invalid BackendKeyData message: cancel key with length ${n} not allowed in protocol version 3.0 (must be 4 bytes)"));
                        }
                        this.pid = p;
                        this.cancelKey = give k;
                    }
                    case ParameterStatus(name: n, value: v): { this.setParameter(name: give n, value: give v); }
                    case NoticeResponse(fields: f): { this.deliver(fields: give f); }
                    case ErrorResponse(fields: f): { return Result::Err(error: PgError::Server(error: ServerError.make(fields: give f))); }
                    case ReadyForQuery(status: s): {
                        this.txStatus = s;
                        Optional<string> encoding = this.parameter(name: "client_encoding");
                        match (give encoding) {
                            case Some(value: e): {
                                if (!e.equals(other: "UTF8")) {
                                    return Result::Err(error: violation(detail: "the server's client_encoding is ".concat(other: e).concat(other: "; this client requires UTF8")));
                                }
                            }
                            case None: { }
                        };
                        return Result::Ok(value: Unit::Unit);
                    }
                    case _: {
                        return Result::Err(error: violation(detail: "unexpected response from server: a message the server does not send after AuthenticationOk"));
                    }
                };
            }
        }
        return Result::Err(error: PgError::Closed);
    }

    // pg_SASL_init: choose a mechanism the server offered and this client may use, and send the client-first
    // message. Over TLS, SCRAM-SHA-256-PLUS is chosen whenever it is offered and channel_binding is not disable, and
    // the login is bound to the server's certificate (RFC 5929 tls-server-end-point); offered over plaintext it is a
    // sign of a stripped TLS layer, and refused.
    unsafe fn Result<Unit, PgError> beginSasl(const ref Config config, const ref DynamicArray<string> offered, const ref string secret, ref DynamicArray<ScramClient> scram, Deadline deadline) {
        bool ssl = this.sslInUse();
        if (config.channelBinding() == ChannelBindingMode::Require && !ssl) { return Result::Err(error: PgError::Auth(detail: "channel binding required, but SSL not in use")); }
        if (scram.length() > 0) { return Result::Err(error: PgError::Auth(detail: "duplicate SASL authentication request")); }
        string chosen = "";
        isize i = 0;
        while (i < offered.length()) {
            if (offered[i].equals(other: "SCRAM-SHA-256-PLUS")) {
                if (!ssl) { return Result::Err(error: PgError::Auth(detail: "server offered SCRAM-SHA-256-PLUS authentication over a non-SSL connection")); }
                if (config.channelBinding() != ChannelBindingMode::Disable) { chosen = "SCRAM-SHA-256-PLUS"; }
            } else if (offered[i].equals(other: "SCRAM-SHA-256") && chosen.length() == 0) { chosen = "SCRAM-SHA-256"; }
            else if (offered[i].equals(other: "OAUTHBEARER") && chosen.length() == 0) { chosen = "OAUTHBEARER"; }
            i = i + 1;
        }
        if (chosen.length() == 0) { return Result::Err(error: PgError::Auth(detail: "none of the server's SASL authentication mechanisms are supported")); }
        Optional<string> refused = config.requireAuth().refuseMechanism(mechanism: chosen);
        match (give refused) { case Some(value: r): { return Result::Err(error: PgError::Auth(detail: give r)); } case None: { } };
        if (config.channelBinding() == ChannelBindingMode::Require && !chosen.equals(other: "SCRAM-SHA-256-PLUS")) {
            return Result::Err(error: PgError::Auth(detail: "channel binding is required, but server did not offer an authentication method that supports channel binding"));
        }
        if (chosen.equals(other: "OAUTHBEARER")) {
            return Result::Err(error: PgError::Auth(detail: "the server requested OAuth authentication (OAUTHBEARER), which this client does not support"));
        }
        bool keys = config.scramClientKey().length() > 0;
        if (!keys && secret.length() == 0) { return Result::Err(error: noPassword()); }
        // build_client_first_message's GS2 header: p=tls-server-end-point for -PLUS; y over TLS when channel binding
        // is allowed but the server did not offer it; n otherwise.
        ChannelBinding binding = ChannelBinding::NotSupported;
        if (chosen.equals(other: "SCRAM-SHA-256-PLUS")) {
            DynamicArray<uint8> hash = this.endPointHash();
            if (hash.length() == 0) { return Result::Err(error: PgError::Auth(detail: "could not generate peer certificate hash")); }
            binding = ChannelBinding::TlsServerEndPoint(hash: give hash);
        } else if (ssl && config.channelBinding() != ChannelBindingMode::Disable) {
            binding = ChannelBinding::NotOffered;
        }
        // The client name in SCRAM is empty: the server takes the user from the StartupMessage.
        string anonymous = "";
        ScramClient client = ScramClient.make(user: anonymous, password: secret, binding: give binding);
        if (keys) { client.useKeys(clientKey: config.scramClientKey().view(), serverKey: config.scramServerKey().view()); }
        string first = client.clientFirst();
        string mechanism = client.mechanism();
        scram.add(item: give client);
        this.outbox.clear();
        if (!saslInitialResponse(w: this.outbox, mechanism: mechanism, data: first.bytes())) {
            return Result::Err(error: PgError::Usage(detail: "the SASL mechanism name holds a NUL byte"));
        }
        return this.flush(deadline: deadline);
    }

    // The server certificate's tls-server-end-point hash, empty without TLS.
    fn DynamicArray<uint8> endPointHash() {
        DynamicArray<uint8> hash = DynamicArray.empty();
        match (this.tls) {
            case Some(value: t): { isize i = 0; while (i < t.endPoint().length()) { hash.add(item: t.endPoint()[i]); i = i + 1; } }
            case None: { }
        };
        return hash;
    }

    // check_expected_areq for AuthenticationOk, in libpq's order: sslcertmode=require (the server must have asked for
    // a certificate, and been sent one), require_auth, then channel_binding=require (the SCRAM exchange must have
    // finished bound to the channel).
    fn Result<Unit, PgError> expectedOk(const ref Config config, bool finished, bool bound) {
        bool requireCert = match (config.tls().certMode()) { case Require: true; case _: false; };
        if (requireCert) {
            bool requested = match (this.tls) { case Some(value: t): t.certificateRequested(); case None: false; };
            bool sent = match (this.tls) { case Some(value: t): t.certificateSent(); case None: false; };
            if (!requested) { return Result::Err(error: PgError::Auth(detail: "server did not request an SSL certificate")); }
            if (!sent) { return Result::Err(error: PgError::Auth(detail: "server accepted connection without a valid SSL certificate")); }
        }
        Optional<string> refused = config.requireAuth().refuse(code: AUTH_OK, finished: finished);
        match (give refused) { case Some(value: r): { return Result::Err(error: PgError::Auth(detail: give r)); } case None: { } };
        if (config.channelBinding() == ChannelBindingMode::Require && !bound) {
            return Result::Err(error: PgError::Auth(detail: "channel binding required, but server authenticated client without channel binding"));
        }
        return Result::Ok(value: Unit::Unit);
    }

    // Whether the session is encrypted (libpq's PQsslInUse).
    public const fn bool sslInUse() { return match (this.tls) { case Some(value: t): true; case None: false; }; }

    // libpq's PQsslAttribute: "library" ("Mbed TLS"), "key_bits", "cipher" (Mbed TLS's name for it), "compression"
    // (always "off": TLS compression is never negotiated), "protocol" ("TLSv1.2", "TLSv1.3") and "alpn" ("" when none
    // was agreed). None for every attribute of an unencrypted session, and for a name it does not know.
    public const fn Optional<string> sslAttribute(const ref string name) {
        return match (this.tls) {
            case None: Optional::None;
            case Some(value: t): {
                if (name.equals(other: "library")) { return Optional::Some(value: "Mbed TLS"); }
                if (name.equals(other: "key_bits")) { isize bits = t.keyBits(); return Optional::Some(value: "${bits}"); }
                if (name.equals(other: "cipher")) { return Optional::Some(value: copy t.cipher()); }
                if (name.equals(other: "compression")) { return Optional::Some(value: "off"); }
                if (name.equals(other: "protocol")) { return Optional::Some(value: copy t.protocol()); }
                if (name.equals(other: "alpn")) { return Optional::Some(value: copy t.alpn()); }
                return Optional::None;
            }
        };
    }

    // libpq's PQsslAttributeNames: the attributes `sslAttribute` answers, none for an unencrypted session.
    public const fn DynamicArray<string> sslAttributeNames() {
        DynamicArray<string> names = DynamicArray.empty();
        if (!this.sslInUse()) { return names; }
        names.add(item: "library"); names.add(item: "key_bits"); names.add(item: "cipher");
        names.add(item: "compression"); names.add(item: "protocol"); names.add(item: "alpn");
        return names;
    }

    // pqGetNegotiateProtocolVersion3: the server's newest version must be one this client asked for or below, and
    // at least min_protocol_version; this client requests no protocol options, so none may come back unrecognized.
    fn Result<Unit, PgError> negotiate(const ref Config config, int32 offered, const ref DynamicArray<string> unrecognized) {
        if (offered > this.protocol) { return Result::Err(error: negotiation(what: "received invalid protocol negotiation message: server requested downgrade to a higher-numbered version")); }
        if (offered < PROTOCOL_3_0) { return Result::Err(error: negotiation(what: "received invalid protocol negotiation message: server requested downgrade to pre-3.0 protocol version")); }
        if (offered == PROTOCOL_3_0 + 1) { return Result::Err(error: negotiation(what: "received invalid protocol negotiation message: server requested downgrade to non-existent 3.1 protocol version")); }
        if (offered == this.protocol && unrecognized.length() == 0) { return Result::Err(error: negotiation(what: "received invalid protocol negotiation message: server negotiated but asks for no changes")); }
        if (offered < config.minProtocolVersion()) {
            int32 theirMinor = offered & 65535;
            int32 minMinor = config.minProtocolVersion() & 65535;
            return Result::Err(error: negotiation(what: "server only supports protocol version 3.${theirMinor}, but \"min_protocol_version\" was set to 3.${minMinor}"));
        }
        this.protocol = offered;
        if (unrecognized.length() > 0) {
            string name = copy unrecognized[0];
            if (!name.startsWith(prefix: "_pq_.")) {
                return Result::Err(error: negotiation(what: "received invalid protocol negotiation message: server reported unsupported parameter name without a \"_pq_.\" prefix (\"".concat(other: name).concat(other: "\")")));
            }
            return Result::Err(error: negotiation(what: "received invalid protocol negotiation message: server reported an unsupported parameter that was not requested (\"".concat(other: name).concat(other: "\")")));
        }
        return Result::Ok(value: Unit::Unit);
    }

    // ---- helpers ----

    // Send what is queued. A server that ended the session usually said why first: if a write fails, a FATAL
    // ErrorResponse already waiting is the error reported, as libpq reports it.
    unsafe fn Result<Unit, PgError> flush(Deadline deadline) {
        Result<Unit, PgError> sent = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
        this.outbox.clear();
        match (give sent) {
            case Ok(value: u): { return Result::Ok(value: Unit::Unit); }
            case Err(error: e): {
                bool io = match (e) { case Io(error: x): true; case Tls(detail: d, cause: c): true; case _: false; };
                if (io) {
                    Result<BackendMessage, PgError> waiting = this.wire.receive(deadline: Deadline.after(span: Duration.fromMillis(ms: 0i64)));
                    match (give waiting) {
                        case Ok(value: m): {
                            match (give m) {
                                case ErrorResponse(fields: f): { this.lose(); return Result::Err(error: PgError::Server(error: ServerError.make(fields: give f))); }
                                case _: { }
                            };
                        }
                        case Err(error: x): { }
                    };
                }
                this.lose();
                return Result::Err(error: give e);
            }
        };
    }

    // A message the protocol does not allow here: the session cannot recover its place, so it ends.
    unsafe fn Result<DynamicArray<Rows>, PgError> violation(const ref string detail) {
        this.lose();
        return Result::Err(error: PgError::Protocol(error: ProtocolError::Violation(detail: copy detail)));
    }

    fn void deliver(ErrorFields fields) {
        ServerError notice = ServerError.make(fields: give fields);
        match (this.handler) {
            case Some(value: h): { h.notice(notice: notice); }
            case None: { logNotice(notice: notice); }
        };
    }

    fn void setParameter(string name, string value) {
        isize found = -1;
        isize i = 0;
        while (i < this.paramNames.length() && found < 0) {
            if (this.paramNames[i].equals(other: name)) { found = i; }
            i = i + 1;
        }
        if (found >= 0) { this.paramValues[found] = give value; return; }
        this.paramNames.add(item: give name);
        this.paramValues.add(item: give value);
    }

    // The session is over: the transport is shut and every later call is `Closed`.
    unsafe fn void lose() {
        this.busy = false;
        this.streaming = false;
        this.bindPending = false;
        this.copyMode = 0ui8;
        this.parsePending = false;
        this.portalDescribing = false;
        this.pipeline = 0ui8;
        this.queue = DynamicArray.empty();
        if (!this.live) { return; }
        this.live = false;
        this.wire.shutdown();
    }

    unsafe ~Connection() { this.close(); }
}

// What the server said about a statement it parsed: its name, its parameters' types, its result columns.
type resource Described {
    string label;
    DynamicArray<uint32> paramTypes;
    DynamicArray<FieldDescription> columns;
    bool parseAgain = false;   // a describe-only cache's entry: Parse the unnamed statement with the Bind
    string text;
    public ctor make(string name, DynamicArray<uint32> types, DynamicArray<FieldDescription> fields) {
        this.label = give name; this.paramTypes = give types; this.columns = give fields; this.parseAgain = false; this.text = "";
    }
    public fn void reparseAs(const ref string sql) { this.parseAgain = true; this.text = copy sql; }
    public const fn bool reparse() { return this.parseAgain; }
    public const fn const ref string sql() { return this.text; }
    public const fn const ref string name() { return this.label; }
    public const fn const ref DynamicArray<uint32> types() { return this.paramTypes; }
    public const fn const ref DynamicArray<FieldDescription> fields() { return this.columns; }
}

// What a connection is opened for: a session (startup), or a cancel request for another session's command, which
// libpq sends over a connection made as a session's is (the same encryption and fallbacks), in place of startup.
type resource Errand {
    bool cancel = false;
    int32 pid = 0;
    DynamicArray<uint8> key;
    Deadline bound;
    SessionTarget kind = SessionTarget::Any;   // for a session: the server target_session_attrs accepts
    public ctor session(SessionTarget target) { this.cancel = false; this.pid = 0; this.key = DynamicArray.empty(); this.bound = Deadline.none(); this.kind = target; }
    public ctor cancelling(int32 pid, DynamicArray<uint8> key, Deadline limit) { this.cancel = true; this.pid = pid; this.key = give key; this.bound = limit; this.kind = SessionTarget::Any; }
    public const fn SessionTarget target() { return this.kind; }
    public const fn Deadline limit() { return this.bound; }
    public const fn bool isCancel() { return this.cancel; }
    public const fn int32 processId() { return this.pid; }
    public const fn const ref DynamicArray<uint8> secretKey() { return this.key; }
}

fn bool isTimeout(const ref PgError e) { return match (e) { case Timeout: true; case _: false; }; }

// The server's refusal to run a cached plan whose result has changed shape (RevalidateCachedQuery).
fn bool isStalePlan(const ref PgError e) {
    return match (e) {
        case Server(error: s): s.sqlstate() == FEATURE_NOT_SUPPORTED && s.primary().equals(other: "cached plan must not change result type");
        case _: false;
    };
}

// The same columns, by type: what a cached description said, against what the portal says now.
fn bool sameColumns(const ref DynamicArray<FieldDescription> a, const ref DynamicArray<FieldDescription> b) {
    if (a.length() != b.length()) { return false; }
    isize i = 0;
    while (i < a.length()) {
        if (a[i].typeOid() != b[i].typeOid()) { return false; }
        i = i + 1;
    }
    return true;
}

// A pipeline's commands go out once this much is queued (libpq's OUTBUFFER_THRESHOLD).
comptime isize PIPELINE_FLUSH = 65536;

fn PgError nulInQuery() { return PgError::Usage(detail: "the query text or a name holds a NUL byte, which the protocol cannot carry"); }

// A command sent in pipeline mode whose result is still to be read: what the reader must expect for it.
type resource PipelineCommand implements Sendable {
    uint8 kind = 0ui8;          // 0 query, 1 prepare, 2 close, 3 sync
    DynamicArray<FieldDescription> fields;
    bool parseFirst = false;    // a Parse went ahead of its Bind
    bool portalDescribed = false;
    bool fromCache = false;
    string text;
    string label;
    ctor blank(uint8 kind) {
        this.kind = kind; this.fields = DynamicArray.empty(); this.parseFirst = false; this.portalDescribed = false;
        this.fromCache = false; this.text = ""; this.label = "";
    }
    public ctor query(string sql) { this.kind = 0ui8; this.fields = DynamicArray.empty(); this.parseFirst = false; this.portalDescribed = false; this.fromCache = false; this.text = give sql; this.label = ""; }
    public ctor prepare(string name, string sql) { this.kind = 1ui8; this.fields = DynamicArray.empty(); this.parseFirst = false; this.portalDescribed = false; this.fromCache = false; this.text = give sql; this.label = give name; }
    public ctor close() { this.kind = 2ui8; this.fields = DynamicArray.empty(); this.parseFirst = false; this.portalDescribed = false; this.fromCache = false; this.text = ""; this.label = ""; }
    public ctor sync() { this.kind = 3ui8; this.fields = DynamicArray.empty(); this.parseFirst = false; this.portalDescribed = false; this.fromCache = false; this.text = ""; this.label = ""; }
    public fn void expectParse() { this.parseFirst = true; }
    public fn void expectPortalDescription() { this.portalDescribed = true; }
    public fn void useColumns(DynamicArray<FieldDescription> fields, bool cached) { this.fields = give fields; this.fromCache = cached; }
    public const fn bool isSync() { return this.kind == 3ui8; }
    public const fn bool isClose() { return this.kind == 2ui8; }
    public const fn bool isPrepare() { return this.kind == 1ui8; }
    public const fn bool parses() { return this.parseFirst; }
    public const fn bool describesPortal() { return this.portalDescribed; }
    public const fn bool cached() { return this.fromCache; }
    public const fn const ref DynamicArray<FieldDescription> columns() { return this.fields; }
    public const fn const ref string sql() { return this.text; }
    public const fn const ref string name() { return this.label; }
}

// COPY data goes out once 64 KiB is queued, in CopyData messages of at most 1 MiB.
comptime isize COPY_FLUSH = 65536;
comptime isize COPY_PIECE = 1048576;

// A message that can come at any point of an exchange: a notice, a parameter's new value, a notification.
fn bool background(const ref BackendMessage m) {
    return match (m) {
        case NoticeResponse(fields: f): true;
        case ParameterStatus(name: n, value: v): true;
        case NotificationResponse(processId: p, channel: c, payload: x): true;
        case _: false;
    };
}

// The password file to name when a wrong password came from it: the host's file password is the one used only
// when the connection string and PGPASSWORD gave none.
fn string passfileFor(const ref Config config, isize hostIndex) {
    if (config.password().length() > 0) { return ""; }
    Optional<string> fromFile = config.host(index: hostIndex).filePasswordFor();
    return match (fromFile) { case Some(value: p): copy config.passfile(); case None: ""; };
}

// check_expected_areq for an authentication request other than AuthenticationOk (Connection.expectedOk has that one):
// require_auth, then channel_binding=require, which allows only SASL.
fn Result<Unit, PgError> expected(const ref Config config, int32 code, bool finished) {
    Optional<string> refused = config.requireAuth().refuse(code: code, finished: finished);
    match (give refused) { case Some(value: r): { return Result::Err(error: PgError::Auth(detail: give r)); } case None: { } };
    if (config.channelBinding() == ChannelBindingMode::Require) {
        if (code == AUTH_SASL || code == AUTH_SASL_CONT || code == AUTH_SASL_FIN) { return Result::Ok(value: Unit::Unit); }
        return Result::Err(error: PgError::Auth(detail: "channel binding required but not supported by server's authentication request"));
    }
    return Result::Ok(value: Unit::Unit);
}

// What one address came to: a session, the next address, the next host, or the end of the connect (libpq's
// try_next_addr, try_next_host and error_return).
type enum Visit { Connected(Connection connection), NextAddress, ToNextHost, Stop }

// What one connection came to: a session, or a failure and what libpq does next.
type enum Attempt { Ready(Connection connection), Retry(PgError error), Final(PgError error), TimedOut(PgError error), NextHost(PgError error) }

fn PgError noPassword() { return PgError::Auth(detail: "fe_sendauth: no password supplied"); }

fn PgError negotiation(const ref string what) { return violation(detail: what); }

fn PgError violation(const ref string detail) { return PgError::Protocol(error: ProtocolError::Violation(detail: copy detail)); }

// libpq's message for a message out of place, naming its type byte.
unsafe fn string unexpected(uint8 tag) {
    DynamicArray<uint8> one = DynamicArray.empty();
    one.add(item: tag);
    Result<string, Utf8Error> c = utf8Decode(bytes: one.view());
    string shown = match (give c) { case Ok(value: s): give s; case Err(error: e): "?"; };
    return "unexpected response from server; first received character was \"".concat(other: shown).concat(other: "\"");
}

// pg_fe_sendauth's messages for a method this client does not speak.
fn string unsupportedMethod(int32 code) {
    if (code == 1) { return "Kerberos 4 authentication not supported"; }
    if (code == 2) { return "Kerberos 5 authentication not supported"; }
    if (code == 4) { return "Crypt authentication not supported"; }
    if (code == 7 || code == 8) { return "GSSAPI authentication not supported"; }
    return "authentication method ${code} not supported";
}

// libpq's emitHostIdentityInfo for a TCP address.
fn string identity(const ref string host, const ref string address, const ref string port) {
    string text = "connection to server at \"".concat(other: host).concat(other: "\"");
    if (address.length() > 0 && !address.equals(other: host)) { text = text.concat(other: " (").concat(other: address).concat(other: ")"); }
    return text.concat(other: ", port ").concat(other: port).concat(other: " failed: ");
}

// A SASL payload as text: SCRAM's messages are UTF-8.
unsafe fn Result<string, PgError> saslText(const ref DynamicArray<uint8> data) {
    Result<string, Utf8Error> t = utf8Decode(bytes: data.view());
    return match (give t) {
        case Ok(value: s): Result::Ok(value: give s);
        case Err(error: e): Result::Err(error: PgError::Protocol(error: ProtocolError::NotUtf8(tag: 82ui8)));
    };
}

// Every text-format value of a row is UTF-8: what the server sends in client_encoding UTF8, and what a value read
// as text relies on.
unsafe fn bool textValid(const ref RowValues row, const ref DynamicArray<int16> formats) {
    isize c = 0;
    while (c < row.columnCount()) {
        if (formats[c] == 0i16 && !row.isNull(column: c)) {
            if (!validate(bytes: row.value(column: c))) { return false; }
        }
        c = c + 1;
    }
    return true;
}

// pqSaveParameterStatus's reading of server_version: up to three dot-separated integers, as sscanf("%d.%d.%d")
// reads them.
fn int32 versionNumber(const ref string text) { return versionFrom(b: text.bytes()); }

fn int32 versionFrom(ConstView<uint8> b) {
    InlineArray<int32>#(3) parts = [0; 3];
    isize count = 0;
    isize i = 0;
    while (count < 3) {
        isize start = i;
        int32 v = 0;
        while (i < b.length() && b[i] >= 48ui8 && b[i] <= 57ui8 && v < 100000) { v = v * 10 + cast<int32>(b[i] - 48ui8); i = i + 1; }
        if (i == start) { break; }
        parts[cast<usize>(count)] = v;
        count = count + 1;
        if (i >= b.length() || b[i] != 46ui8) { break; }   // '.'
        i = i + 1;
    }
    if (count == 3) { return (100 * parts[0] + parts[1]) * 100 + parts[2]; }
    if (count == 2) {
        if (parts[0] >= 10) { return 10000 * parts[0] + parts[1]; }
        return (100 * parts[0] + parts[1]) * 100;
    }
    if (count == 1) { return 10000 * parts[0]; }
    return 0;
}
