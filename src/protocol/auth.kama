import { std::collections::DynamicArray, std::collections::ConstView, std::collections::FixedArray,
         std::math::sin, std::math::abs, std::math::floor,
         std::digest::pbkdf2, std::digest::sha256::Sha256, std::digest::sha256::hmacSha256, std::digest::sha256::sha256,
         std::encoding::base64::encode as b64encode, std::encoding::base64::decode as b64decode,
         std::encoding::base64::DecodeError, std::encoding::hex::encode as hexEncode, std::random::entropy };
export { Md5, md5, md5Password, ScramClient, ChannelBinding, AuthError };

// Password authentication: the `md5` method's response, and a SCRAM-SHA-256 client (RFC 5802, RFC 7677) with
// tls-server-end-point channel binding (RFC 5929) — SCRAM-SHA-256-PLUS. HMAC, PBKDF2 and SHA-256 are kama's
// std::digest; MD5 is here because only this deprecated method needs it.

// What can go wrong in a SASL exchange. The messages are libpq's (fe-auth-scram.c).
type enum AuthError implements Error {
    // The server's nonce does not extend ours: a replay, or a server that is not following SCRAM.
    NonceMismatch,
    // A server message that does not parse; `what` says which part, in libpq's words.
    BadServerMessage(string what),
    // The server ended the exchange with an error attribute (e=…).
    ServerRejected(string reason),
    // The server's signature does not prove it knows the password: it is not the server we think it is.
    SignatureMismatch;

    public const fn string message() {
        return match (this) {
            case NonceMismatch: "invalid SCRAM response (nonce mismatch)";
            case BadServerMessage(what: w): "malformed SCRAM message (".concat(other: w).concat(other: ")");
            case ServerRejected(reason: r): "error received from server in SCRAM exchange: ".concat(other: r);
            case SignatureMismatch: "incorrect server signature";
        };
    }
}

// ---- MD5 (RFC 1321) ------------------------------------------------------------------------------------------

// The 64 additive constants: T[i] = floor(|sin(i + 1)| · 2^32), as RFC 1321 §3.4 defines them. Computed rather
// than transcribed; every RFC test vector runs all 64 steps, so a wrong one fails every vector.
fn InlineArray<uint32>#(64) md5Table() {
    InlineArray<uint32>#(64) t = [0ui32; 64];
    isize i = 0;
    while (i < 64) {
        float64 angle = cast<float64>(i + 1);
        float64 sine = sin(x: angle);
        float64 magnitude = abs(x: sine);
        float64 scaled = magnitude * 4294967296.0;
        float64 whole = floor(x: scaled);
        t[cast<usize>(i)] = cast<uint32>(whole);
        i = i + 1;
    }
    return t;
}

fn uint32 md5Shift(isize i) {
    isize round = i / 16;
    isize j = i % 4;
    if (round == 0) { if (j == 0) { return 7ui32; } if (j == 1) { return 12ui32; } if (j == 2) { return 17ui32; } return 22ui32; }
    if (round == 1) { if (j == 0) { return 5ui32; } if (j == 1) { return 9ui32; } if (j == 2) { return 14ui32; } return 20ui32; }
    if (round == 2) { if (j == 0) { return 4ui32; } if (j == 1) { return 11ui32; } if (j == 2) { return 16ui32; } return 23ui32; }
    if (j == 0) { return 6ui32; } if (j == 1) { return 10ui32; } if (j == 2) { return 15ui32; } return 21ui32;
}

fn uint32 rotl(uint32 x, uint32 n) { return (x << n) | (x >> (32ui32 - n)); }

type value Md5 {
    InlineArray<uint32>#(4) h;
    InlineArray<uint32>#(64) k;
    InlineArray<uint8>#(64) block;
    isize filled = 0;
    uint64 total = 0ui64;

    public ctor make() {
        this.h = [1732584193ui32, 4023233417ui32, 2562383102ui32, 271733878ui32];   // A, B, C, D of §3.3
        this.k = md5Table();
        this.block = [0ui8; 64];
        this.filled = 0;
        this.total = 0ui64;
    }

    public fn void update(ConstView<uint8> bytes) {
        isize i = 0;
        while (i < bytes.length()) {
            this.block[cast<usize>(this.filled)] = bytes[i];
            this.filled = this.filled + 1;
            if (this.filled == 64) { this.compress(); this.filled = 0; }
            i = i + 1;
        }
        this.total = this.total + cast<uint64>(bytes.length());
    }

    public fn InlineArray<uint8>#(16) finish() {
        uint64 bits = this.total * 8ui64;
        this.block[cast<usize>(this.filled)] = 128ui8;
        this.filled = this.filled + 1;
        if (this.filled > 56) {
            while (this.filled < 64) { this.block[cast<usize>(this.filled)] = 0ui8; this.filled = this.filled + 1; }
            this.compress();
            this.filled = 0;
        }
        while (this.filled < 56) { this.block[cast<usize>(this.filled)] = 0ui8; this.filled = this.filled + 1; }
        isize b = 0;
        while (b < 8) { this.block[cast<usize>(56 + b)] = truncate<uint8>(bits >> cast<uint64>(b * 8)); b = b + 1; }
        this.compress();
        InlineArray<uint8>#(16) digest = [0ui8; 16];
        isize w = 0;
        while (w < 4) {
            uint32 v = this.h[cast<usize>(w)];
            digest[cast<usize>(w * 4)]     = truncate<uint8>(v);
            digest[cast<usize>(w * 4 + 1)] = truncate<uint8>(v >> 8ui32);
            digest[cast<usize>(w * 4 + 2)] = truncate<uint8>(v >> 16ui32);
            digest[cast<usize>(w * 4 + 3)] = truncate<uint8>(v >> 24ui32);
            w = w + 1;
        }
        return digest;
    }

    fn void compress() {
        InlineArray<uint32>#(16) m = [0ui32; 16];
        isize i = 0;
        while (i < 16) {
            usize o = cast<usize>(i * 4);
            m[cast<usize>(i)] = cast<uint32>(this.block[o]) | (cast<uint32>(this.block[o + 1]) << 8ui32)
                              | (cast<uint32>(this.block[o + 2]) << 16ui32) | (cast<uint32>(this.block[o + 3]) << 24ui32);
            i = i + 1;
        }
        uint32 a = this.h[0]; uint32 b = this.h[1]; uint32 c = this.h[2]; uint32 d = this.h[3];
        i = 0;
        while (i < 64) {
            uint32 f = 0ui32;
            isize g = 0;
            if (i < 16)      { f = (b & c) | (~b & d); g = i; }
            else if (i < 32) { f = (d & b) | (~d & c); g = (5 * i + 1) % 16; }
            else if (i < 48) { f = b ^ c ^ d;          g = (3 * i + 5) % 16; }
            else             { f = c ^ (b | ~d);       g = (7 * i) % 16; }
            uint32 rotated = rotl(x: a + f + this.k[cast<usize>(i)] + m[cast<usize>(g)], n: md5Shift(i: i));
            a = d; d = c; c = b; b = b + rotated;
            i = i + 1;
        }
        this.h[0] = this.h[0] + a; this.h[1] = this.h[1] + b; this.h[2] = this.h[2] + c; this.h[3] = this.h[3] + d;
    }
}

fn InlineArray<uint8>#(16) md5(ConstView<uint8> bytes) {
    Md5 m = Md5.make();
    m.update(bytes: bytes);
    return m.finish();
}

// The `md5` method's response: "md5" followed by md5(hex(md5(password ‖ user)) ‖ salt) in hex — what libpq's
// pg_password_sendauth sends. (The inner hex string is also what pg_authid stores for an md5 role.)
unsafe fn string md5Password(const ref string user, const ref string password, InlineArray<uint8>#(4) salt) {
    Md5 inner = Md5.make();
    inner.update(bytes: password.bytes());
    inner.update(bytes: user.bytes());
    InlineArray<uint8>#(16) first = inner.finish();
    string firstHex = hexEncode(bytes: first.view());
    Md5 outer = Md5.make();
    outer.update(bytes: firstHex.bytes());
    outer.update(bytes: salt.view());
    InlineArray<uint8>#(16) second = outer.finish();
    string secondHex = hexEncode(bytes: second.view());
    return "md5".concat(other: secondHex);
}

// ---- SCRAM-SHA-256 ------------------------------------------------------------------------------------------

// What the client says about channel binding, in the GS2 header of its first message.
type enum ChannelBinding {
    // "n": the client does not support channel binding (no TLS, or a TLS stack without the binding data).
    NotSupported,
    // "y": the client supports it but the server did not offer SCRAM-SHA-256-PLUS. A server that did offer it
    // will see this and refuse, which is how a downgrade is detected.
    NotOffered,
    // "p=tls-server-end-point": bind the login to this TLS session's server certificate hash (RFC 5929).
    TlsServerEndPoint(DynamicArray<uint8> hash)
}

type resource ScramClient {
    string password;
    string gs2Header;
    DynamicArray<uint8> bindingData;   // empty unless channel binding is used
    string clientFirstBare;
    string clientNonce;
    DynamicArray<uint8> expectedServerSignature;
    DynamicArray<uint8> givenClientKey;   // libpq's scram_client_key and scram_server_key: empty unless given
    DynamicArray<uint8> givenServerKey;
    int32 stage = 0;                   // 0 before client-first, 1 after it, 2 after client-final, 3 verified

    // A client for `user` ("" is what PostgreSQL clients send: the server takes the name from the startup
    // packet) with a fresh 18-byte random nonce, as libpq uses.
    public unsafe ctor make(const ref string user, const ref string password, ChannelBinding binding) {
        FixedArray<uint8> raw = FixedArray.make(size: 18);
        entropy(into: raw.viewMut());
        string nonce = b64encode(bytes: raw.view());
        this.init(user: user, password: password, binding: give binding, nonce: give nonce);
    }

    // The same with a given nonce: for the RFC's test exchange, never for a real login.
    public ctor withNonce(const ref string user, const ref string password, ChannelBinding binding, string nonce) {
        this.init(user: user, password: password, binding: give binding, nonce: give nonce);
    }

    fn void init(const ref string user, const ref string password, ChannelBinding binding, string nonce) {
        this.password = saslPrep(password: password);
        this.bindingData = DynamicArray.empty();
        match (give binding) {
            case NotSupported: { this.gs2Header = "n,,"; }
            case NotOffered: { this.gs2Header = "y,,"; }
            case TlsServerEndPoint(hash: h): { this.gs2Header = "p=tls-server-end-point,,"; this.bindingData = give h; }
        };
        string escaped = saslName(name: user);
        string bareStart = "n=".concat(other: escaped).concat(other: ",r=");
        this.clientFirstBare = bareStart.concat(other: nonce);
        this.clientNonce = give nonce;
        this.expectedServerSignature = DynamicArray.empty();
        this.givenClientKey = DynamicArray.empty();
        this.givenServerKey = DynamicArray.empty();
        this.stage = 0;
    }

    // SCRAM's ClientKey and ServerKey, given instead of being derived from the password (libpq's scram_client_key
    // and scram_server_key, which postgres_fdw passes through). Each is used on its own: an empty one is derived.
    public fn void useKeys(ConstView<uint8> clientKey, ConstView<uint8> serverKey) {
        this.givenClientKey = DynamicArray.empty();
        appendBytes(to: ref this.givenClientKey, from: clientKey);
        this.givenServerKey = DynamicArray.empty();
        appendBytes(to: ref this.givenServerKey, from: serverKey);
    }

    // The mechanism this client speaks: SCRAM-SHA-256-PLUS when it binds to the channel.
    public const fn string mechanism() {
        if (this.bindingData.length() > 0) { return "SCRAM-SHA-256-PLUS"; }
        return "SCRAM-SHA-256";
    }

    // client-first-message: the GS2 header and the bare message.
    public fn string clientFirst() {
        this.stage = 1;
        return this.gs2Header.concat(other: this.clientFirstBare);
    }

    // client-final-message, from the server-first-message: proves the password without sending it.
    public unsafe fn Result<string, AuthError> clientFinal(const ref string serverFirst) {
        if (this.stage != 1) { panic(msg: "ScramClient.clientFinal: call clientFirst first"); }
        Optional<string> rAttr = attribute(message: serverFirst, name: "r");
        Optional<string> sAttr = attribute(message: serverFirst, name: "s");
        Optional<string> iAttr = attribute(message: serverFirst, name: "i");
        if (serverFirst.startsWith(prefix: "m=")) { return bad(what: "attribute \"r\" expected"); }
        string serverNonce = match (give rAttr) { case Some(value: v): give v; case None: { return bad(what: "attribute \"r\" expected"); } };
        string saltText = match (give sAttr) { case Some(value: v): give v; case None: { return bad(what: "attribute \"s\" expected"); } };
        string iterText = match (give iAttr) { case Some(value: v): give v; case None: { return bad(what: "attribute \"i\" expected"); } };
        if (!serverNonce.startsWith(prefix: this.clientNonce) || serverNonce.length() <= this.clientNonce.length()) {
            return Result::Err(error: AuthError::NonceMismatch);
        }
        Result<DynamicArray<uint8>, DecodeError> saltBytes = b64decode(text: saltText);
        DynamicArray<uint8> salt = match (give saltBytes) { case Ok(value: v): give v; case Err(error: e): { return bad(what: "invalid salt"); } };
        int32 iterations = parsePositive(b: iterText.bytes());
        if (iterations < 1) { return bad(what: "invalid iteration count"); }

        // SaltedPassword := Hi(Normalize(password), salt, i); the keys and signatures of RFC 5802 §3.
        FixedArray<uint8> salted = FixedArray.make(size: 32);
        if (this.givenClientKey.length() != 32 || this.givenServerKey.length() != 32) {
            pbkdf2(hash: Sha256.make(), password: this.password.bytes(), salt: salt.view(), iterations: iterations, into: salted.viewMut());
        }
        string clientKeyLabel = "Client Key";
        string serverKeyLabel = "Server Key";
        InlineArray<uint8>#(32) clientKey = hmacSha256(key: salted.view(), message: clientKeyLabel.bytes());
        if (this.givenClientKey.length() == 32) {
            isize k = 0;
            while (k < 32) { clientKey[cast<usize>(k)] = this.givenClientKey[k]; k = k + 1; }
        }
        InlineArray<uint8>#(32) storedKey = sha256(bytes: clientKey.view());
        InlineArray<uint8>#(32) serverKey = hmacSha256(key: salted.view(), message: serverKeyLabel.bytes());
        if (this.givenServerKey.length() == 32) {
            isize k = 0;
            while (k < 32) { serverKey[cast<usize>(k)] = this.givenServerKey[k]; k = k + 1; }
        }

        // c= is the GS2 header and, when bound, the binding data, base64-encoded.
        DynamicArray<uint8> cbind = DynamicArray.empty();
        appendBytes(to: ref cbind, from: this.gs2Header.bytes());
        appendBytes(to: ref cbind, from: this.bindingData.view());
        string cAttr = b64encode(bytes: cbind.view());
        string finalWithoutProof = "c=".concat(other: cAttr).concat(other: ",r=").concat(other: serverNonce);
        string authMessage = this.clientFirstBare.concat(other: ",").concat(other: serverFirst).concat(other: ",").concat(other: finalWithoutProof);

        InlineArray<uint8>#(32) clientSignature = hmacSha256(key: storedKey.view(), message: authMessage.bytes());
        InlineArray<uint8>#(32) proof = [0ui8; 32];
        isize i = 0;
        while (i < 32) { proof[cast<usize>(i)] = clientKey[cast<usize>(i)] ^ clientSignature[cast<usize>(i)]; i = i + 1; }
        InlineArray<uint8>#(32) serverSignature = hmacSha256(key: serverKey.view(), message: authMessage.bytes());
        this.expectedServerSignature = DynamicArray.withCapacity(capacity: 32);
        appendBytes(to: ref this.expectedServerSignature, from: serverSignature.view());

        // The salted password is the credential itself: clear it before it goes out of scope.
        i = 0;
        while (i < 32) { salted[i] = 0ui8; i = i + 1; }
        this.stage = 2;
        string proofText = b64encode(bytes: proof.view());
        return Result::Ok(value: finalWithoutProof.concat(other: ",p=").concat(other: proofText));
    }

    // The server-final-message must carry the signature only a server that knows the password can compute.
    public fn Result<Unit, AuthError> verifyServerFinal(const ref string serverFinal) {
        if (this.stage != 2) { panic(msg: "ScramClient.verifyServerFinal: call clientFinal first"); }
        Optional<string> eAttr = attribute(message: serverFinal, name: "e");
        match (give eAttr) { case Some(value: reason): { return Result::Err(error: AuthError::ServerRejected(reason: give reason)); } case None: { } };
        Optional<string> vAttr = attribute(message: serverFinal, name: "v");
        string sig = match (give vAttr) { case Some(value: v): give v; case None: { return Result::Err(error: AuthError::BadServerMessage(what: "attribute \"v\" expected")); } };
        Result<DynamicArray<uint8>, DecodeError> got = b64decode(text: sig);
        DynamicArray<uint8> bytes = match (give got) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: AuthError::BadServerMessage(what: "invalid server signature")); } };
        if (!constantTimeEqual(a: bytes.view(), b: this.expectedServerSignature.view())) {
            return Result::Err(error: AuthError::SignatureMismatch);
        }
        this.stage = 3;
        return Result::Ok(value: Unit::Unit);
    }
}

fn Result<string, AuthError> bad(const ref string what) { return Result::Err(error: AuthError::BadServerMessage(what: copy what)); }

fn void appendBytes(ref DynamicArray<uint8> to, ConstView<uint8> from) {
    isize i = 0;
    while (i < from.length()) { to.add(item: from[i]); i = i + 1; }
}

// The value of `name=` among a SCRAM message's comma-separated attributes.
fn Optional<string> attribute(const ref string message, const ref string name) {
    string prefix = name.concat(other: "=");
    foreach (string part in message.split(separator: ",")) {
        if (part.startsWith(prefix: prefix)) { return Optional::Some(value: part.substring(start: prefix.length(), end: part.length())); }
    }
    return Optional::None;
}

// A decimal int32 > 0, or 0 if the bytes are not one.
fn int32 parsePositive(ConstView<uint8> b) {
    if (b.length() == 0 || b.length() > 10) { return 0; }
    int64 v = 0i64;
    isize i = 0;
    while (i < b.length()) {
        if (b[i] < 48ui8 || b[i] > 57ui8) { return 0; }
        v = v * 10i64 + cast<int64>(b[i] - 48ui8);
        i = i + 1;
    }
    if (v < 1i64 || v > 2147483647i64) { return 0; }
    return cast<int32>(v);
}

// RFC 5802 saslname: ',' and '=' are escaped as =2C and =3D.
fn string saslName(const ref string name) { return name.replace(old: "=", with: "=3D").replace(old: ",", with: "=2C"); }

// SASLprep (RFC 4013), as far as this client goes: printable ASCII is its own preparation, and anything else
// is used as given — what libpq also does when preparation fails. A non-ASCII password that SASLprep would
// change (a non-ASCII space, a character NFKC folds) must be set on the server in its prepared form.
fn string saslPrep(const ref string password) { return copy password; }

fn bool constantTimeEqual(ConstView<uint8> a, ConstView<uint8> b) {
    if (a.length() != b.length()) { return false; }
    uint8 diff = 0ui8;
    isize i = 0;
    while (i < a.length()) { diff = diff | (a[i] ^ b[i]); i = i + 1; }
    return diff == 0ui8;
}
