// src/interfaces/libpq/fe-protocol3.c, fe-connect.c and src/include/libpq/protocol.h. Do not edit: change the
// script and run it again.
//
// What libpq believes of a backend message header before it reads the body. Its messages are kept as libpq's
// format strings, which postgres::protocol::cFormat prints as C's printf does.
export { isLongMessageType, isCopyOutMessageType, isStartupMessageType, MIN_MESSAGE_LENGTH, SHORT_MESSAGE_LIMIT,
         AUTH_REQUEST_MIN, AUTH_REQUEST_MAX, NEGOTIATE_MIN, NEGOTIATE_MAX, STARTUP_ERROR_MIN, STARTUP_ERROR_MAX,
         syncLossFormat, unexpectedFormat, expectedAuthFormat, invalidAuthText, invalidNegotiationText,
         invalidErrorText };

// The types whose length may be over SHORT_MESSAGE_LIMIT (VALID_LONG_MESSAGE_TYPE).
fn bool isLongMessageType(uint8 tag) {
    // CopyData 'd', DataRow 'D', ErrorResponse 'E', FunctionCallResponse 'V', NoticeResponse 'N', NotificationResponse 'A', RowDescription 'T', ParameterDescription 't'
    return tag == 100ui8 || tag == 68ui8 || tag == 69ui8 || tag == 86ui8 || tag == 78ui8 || tag == 65ui8 || tag == 84ui8 || tag == 116ui8;
}

// The types getCopyDataMessage takes itself during COPY OUT, so with no check on a short type's length.
fn bool isCopyOutMessageType(uint8 tag) {
    // NotificationResponse 'A', NoticeResponse 'N', ParameterStatus 'S', CopyData 'd'
    return tag == 65ui8 || tag == 78ui8 || tag == 83ui8 || tag == 100ui8;
}

// The types PQconnectPoll accepts while it waits for an authentication request.
fn bool isStartupMessageType(uint8 tag) {
    // AuthenticationRequest 'R', ErrorResponse 'E', NegotiateProtocolVersion 'v'
    return tag == 82ui8 || tag == 69ui8 || tag == 118ui8;
}

// pqParseInput3: a length under MIN_MESSAGE_LENGTH, or over SHORT_MESSAGE_LIMIT for a type that is not long, is
// lost synchronization.
comptime int32 MIN_MESSAGE_LENGTH = 4;
comptime int32 SHORT_MESSAGE_LIMIT = 30000;
// PQconnectPoll: an authentication request, a NegotiateProtocolVersion and an ErrorResponse before authentication
// must have a length within these. An ErrorResponse outside them is a pre-3.0 server's error text.
comptime int32 AUTH_REQUEST_MIN = 8;
comptime int32 AUTH_REQUEST_MAX = 2000;
comptime int32 NEGOTIATE_MIN = 8;
comptime int32 NEGOTIATE_MAX = 2000;
comptime int32 STARTUP_ERROR_MIN = 8;
comptime int32 STARTUP_ERROR_MAX = 30000;

fn string syncLossFormat() { return "lost synchronization with server: got message type \"%c\", length %d"; }
fn string unexpectedFormat() { return "unexpected response from server; first received character was \"%c\""; }
fn string expectedAuthFormat() { return "expected authentication request from server, but received %c"; }
fn string invalidAuthText() { return "received invalid authentication request"; }
fn string invalidNegotiationText() { return "received invalid protocol negotiation message"; }
fn string invalidErrorText() { return "received invalid error message"; }
