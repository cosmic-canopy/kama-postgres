import { std::collections::DynamicArray, std::collections::ConstView, std::encoding::utf8::decode,
         std::encoding::utf8::Utf8Error, postgres::protocol::FieldDescription, postgres::protocol::RowValues };
export { SimpleResult };

// One statement's result from `Connection.simpleQuery`: its columns, its rows, and its command tag. The simple
// protocol sends every value as text (a binary cursor's FETCH aside); each text value was checked as UTF-8 when it
// arrived, so reading one cannot fail. A column or row index out of range panics, as an index does on a
// collection.
type resource SimpleResult {
    DynamicArray<FieldDescription> fields;
    DynamicArray<RowValues> rows;
    string tag;

    public ctor make(DynamicArray<FieldDescription> fields, DynamicArray<RowValues> rows, string tag) {
        this.fields = give fields; this.rows = give rows; this.tag = give tag;
    }

    // A connection fills a result as the messages arrive: the RowDescription first, then each DataRow, then the
    // CommandComplete that names it.
    fn void addRow(RowValues row) { this.rows.add(item: give row); }
    fn void complete(string tag) { this.tag = give tag; }
    friend postgres::Connection::simpleQuery[addRow, complete];

    public const fn isize columnCount() { return this.fields.length(); }
    public const fn const ref FieldDescription column(isize index) { return this.fields[index]; }
    // The first column called `name`, compared exactly; None if there is none.
    public const fn Optional<isize> columnIndex(const ref string name) {
        isize i = 0;
        while (i < this.fields.length()) { if (this.fields[i].name().equals(other: name)) { return Optional::Some(value: i); } i = i + 1; }
        return Optional::None;
    }

    public const fn isize rowCount() { return this.rows.length(); }
    public const fn bool isNull(isize row, isize column) { return this.rows[row].isNull(column: column); }

    // A value as text; None for NULL. A column in binary format (a binary cursor's) has no text: read its bytes.
    public unsafe const fn Optional<string> text(isize row, isize column) {
        if (this.fields[column].format() != 0i16) { panic(msg: "SimpleResult.text: the column is binary; read it with bytes()"); }
        if (this.rows[row].isNull(column: column)) { return Optional::None; }
        Result<string, Utf8Error> s = decode(bytes: this.rows[row].value(column: column));
        return match (give s) {
            case Ok(value: t): Optional::Some(value: give t);
            case Err(error: e): { panic(msg: "SimpleResult.text: a value that was checked on arrival is not UTF-8"); return Optional::None; }
        };
    }

    // A value's bytes as the server sent them; empty for NULL (ask `isNull` to tell NULL from empty).
    public unsafe const fn ConstView<uint8> bytes(isize row, isize column) { return this.rows[row].value(column: column); }

    // The command tag, e.g. "SELECT 3", "INSERT 0 1", "CREATE TABLE".
    public const fn const ref string commandTag() { return this.tag; }

    // The rows the command affected or returned, as libpq's PQcmdTuples reads them from the tag: for INSERT,
    // UPDATE, DELETE, MERGE, SELECT, FETCH, MOVE and COPY. None for any other command.
    public const fn Optional<int64> rowsAffected() { return countFromTag(tag: this.tag); }
}

fn Optional<int64> countFromTag(const ref string tag) {
    isize start = -1;
    if (tag.startsWith(prefix: "INSERT ")) {
        // INSERT oid rows: skip the oid.
        isize i = 7;
        while (i < tag.length() && tag[i] != 32ui8) { i = i + 1; }
        if (i >= tag.length()) { return Optional::None; }
        start = i + 1;
    } else if (tag.startsWith(prefix: "SELECT ") || tag.startsWith(prefix: "DELETE ") || tag.startsWith(prefix: "UPDATE ")) {
        start = 7;
    } else if (tag.startsWith(prefix: "FETCH ") || tag.startsWith(prefix: "MERGE ")) {
        start = 6;
    } else if (tag.startsWith(prefix: "MOVE ") || tag.startsWith(prefix: "COPY ")) {
        start = 5;
    } else {
        return Optional::None;
    }
    // At most 18 digits, so the count fits an int64 without a check per digit; no table has 10^18 rows.
    if (start >= tag.length() || tag.length() - start > 18) { return Optional::None; }
    int64 n = 0i64;
    isize i = start;
    while (i < tag.length()) {
        uint8 c = tag[i];
        if (c < 48ui8 || c > 57ui8) { return Optional::None; }
        n = n * 10i64 + cast<int64>(c - 48ui8);
        i = i + 1;
    }
    return Optional::Some(value: n);
}
