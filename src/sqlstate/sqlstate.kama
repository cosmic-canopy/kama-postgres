// The five-character text of a packed code, e.g. "23505".
fn string sqlstateText(int32 code) {
    InlineArray<uint8>#(5) chars = [0ui8; 5];
    isize i = 0;
    while (i < 5) { chars[cast<usize>(i)] = truncate<uint8>(((code >> cast<int32>(6 * i)) & 63) + 48); i = i + 1; }
    return textOf(b: chars.view());
}

unsafe fn string textOf(ConstView<uint8> b) { return kama_string_from_raw(src: b.dataPtr(), start: 0, len: b.length()); }
extern fn string kama_string_from_raw(UnsafeConstPtr<uint8> src, isize start, isize len);

// The packed code for five characters of [0-9A-Z], or -1 if `text` is not one.
fn int32 sqlstateCode(const ref string text) { return codeOf(b: text.bytes()); }

fn int32 codeOf(ConstView<uint8> b) {
    if (b.length() != 5) { return -1; }
    int32 code = 0;
    isize i = 0;
    while (i < 5) {
        uint8 c = b[i];
        if (!((c >= 48ui8 && c <= 57ui8) || (c >= 65ui8 && c <= 90ui8))) { return -1; }
        code = code + ((cast<int32>(c) - 48) << cast<int32>(6 * i));
        i = i + 1;
    }
    return code;
}

// The class of a code: its first two characters, as a code with the last three "000" (23505 -> 23000,
// INTEGRITY_CONSTRAINT_VIOLATION). Every code in a class shares this.
fn int32 sqlstateClass(int32 code) { return code & 4095; }

// The condition name PL/pgSQL uses for a code ("unique_violation"), if it has one.
fn Optional<string> conditionName(int32 code) {
    if (code == 0) { return Optional::Some(value: "successful_completion"); }
    if (code == 64) { return Optional::Some(value: "warning"); }
    if (code == 318767168) { return Optional::Some(value: "dynamic_result_sets_returned"); }
    if (code == 134217792) { return Optional::Some(value: "implicit_zero_bit_padding"); }
