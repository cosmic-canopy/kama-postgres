import { std::collections::DynamicArray, std::collections::ConstView,
         postgres::types::DecodeError, postgres::types::FORMAT_TEXT, postgres::types::FORMAT_BINARY,
         postgres::types::utf8Text, postgres::types::BOX };
export { ArrayValues, decodeArray, formatArray, arrayDelimiter };

// Arrays of one dimension: PostgreSQL's array_send/array_recv layout, and array_in/array_out's text. The
// elements are kept as the bytes of their own type, in the array's format, for that type's codec to read. An
// array of more than one dimension is `Unsupported`: kama's DynamicArray has one.

// The elements of a one-dimensional array: each one's bytes in `format`, or NULL.
type resource ArrayValues implements Sendable {
    uint32 elemOid = 0ui32;
    int16 fmt = 0i16;
    int32 lower = 1;
    DynamicArray<uint8> body;
    DynamicArray<isize> starts;
    DynamicArray<int32> lengths;   // -1 for NULL

    ctor make(uint32 elementOid, int16 format, int32 lowerBound) {
        this.elemOid = elementOid; this.fmt = format; this.lower = lowerBound;
        this.body = DynamicArray.empty(); this.starts = DynamicArray.empty(); this.lengths = DynamicArray.empty();
    }
    fn void add(ConstView<uint8> value) {
        this.starts.add(item: this.body.length());
        this.lengths.add(item: cast<int32>(value.length()));
        isize i = 0;
        while (i < value.length()) { this.body.add(item: value[i]); i = i + 1; }
    }
    fn void addNull() { this.starts.add(item: this.body.length()); this.lengths.add(item: -1); }
    friend decodeArray[make, add, addNull];
    friend textElements[make, add, addNull];

    // The element type's OID: what the binary form names, or what the caller said for text.
    public const fn uint32 elementOid() { return this.elemOid; }
    // The format the elements are in: the array's own.
    public const fn int16 format() { return this.fmt; }
    // The index of the first element, 1 unless the value was written `[0:2]={…}`.
    public const fn int32 lowerBound() { return this.lower; }
    public const fn isize count() { return this.lengths.length(); }
    public const fn bool isNull(isize index) { return this.lengths[index] < 0; }
    public unsafe const fn ConstView<uint8> value(isize index) {
        int32 n = this.lengths[index];
        if (n < 0) { return this.body.slice(from: 0, count: 0); }
        return this.body.slice(from: this.starts[index], count: cast<isize>(n));
    }
}

// The character between elements in an array's text: ';' for box, ',' for every other built-in type.
fn uint8 arrayDelimiter(uint32 elementOid) { if (elementOid == BOX) { return 59ui8; } return 44ui8; }

fn int32 i32At(ConstView<uint8> b, isize at) {
    return truncate<int32>((cast<uint32>(b[at]) << 24ui32) | (cast<uint32>(b[at + 1]) << 16ui32) | (cast<uint32>(b[at + 2]) << 8ui32) | cast<uint32>(b[at + 3]));
}

fn Result<ArrayValues, DecodeError> malformed(const ref string what) { return Result::Err(error: DecodeError::Unsupported(type: "array", what: copy what)); }

// An array value. `elementOid` is the element type the column's type names; a binary value names its own, which
// must agree when both are known.
unsafe fn Result<ArrayValues, DecodeError> decodeArray(int16 format, ConstView<uint8> raw, uint32 elementOid) {
    if (format == FORMAT_BINARY) {
        if (raw.length() < 12) { return Result::Err(error: DecodeError::BadLength(type: "array", got: raw.length())); }
        int32 ndim = i32At(b: raw, at: 0);
        int32 flags = i32At(b: raw, at: 4);
        uint32 wireOid = cast<uint32>(i32At(b: raw, at: 8)) ;
        if (flags != 0 && flags != 1) { return malformed(what: "a header flag other than has-nulls"); }
        if (elementOid != 0ui32 && wireOid != elementOid) { return malformed(what: "an element type other than the column's"); }
        if (ndim == 0) {
            if (raw.length() != 12) { return Result::Err(error: DecodeError::BadLength(type: "array", got: raw.length())); }
            return Result::Ok(value: ArrayValues.make(elementOid: wireOid, format: FORMAT_BINARY, lowerBound: 1));
        }
        if (ndim > 1) { return malformed(what: "an array of ${ndim} dimensions; this client reads one"); }
        if (ndim < 0 || raw.length() < 20) { return Result::Err(error: DecodeError::BadLength(type: "array", got: raw.length())); }
        int32 count = i32At(b: raw, at: 12);
        int32 lower = i32At(b: raw, at: 16);
        // Each element is at least its 4-byte length, so the count is bounded by what remains.
        if (count < 0 || cast<isize>(count) * 4 > raw.length() - 20) { return Result::Err(error: DecodeError::BadLength(type: "array", got: raw.length())); }
        ArrayValues a = ArrayValues.make(elementOid: wireOid, format: FORMAT_BINARY, lowerBound: lower);
        isize at = 20;
        int32 i = 0;
        while (i < count) {
            if (at + 4 > raw.length()) { return Result::Err(error: DecodeError::BadLength(type: "array", got: raw.length())); }
            int32 len = i32At(b: raw, at: at);
            at = at + 4;
            if (len == -1) {
                if (flags == 0) { return malformed(what: "a NULL element in an array whose header says it has none"); }
                a.addNull();
            } else {
                if (len < 0 || cast<isize>(len) > raw.length() - at) { return Result::Err(error: DecodeError::BadLength(type: "array", got: raw.length())); }
                a.add(value: raw.slice(from: at, count: cast<isize>(len)));
                at = at + cast<isize>(len);
            }
            i = i + 1;
        }
        if (at != raw.length()) { return malformed(what: "bytes after the last element"); }
        return Result::Ok(value: give a);
    }
    Result<string, DecodeError> t = utf8Text(raw: raw);
    string text = match (give t) { case Ok(value: s): give s; case Err(error: e): { return Result::Err(error: give e); } };
    return textElements(b: text.bytes(), text: text, elementOid: elementOid);
}

fn bool arraySpace(uint8 c) { return c == 32ui8 || c == 9ui8 || c == 10ui8 || c == 13ui8 || c == 11ui8 || c == 12ui8; }

fn Result<ArrayValues, DecodeError> badArray(const ref string text) { return Result::Err(error: DecodeError::BadText(type: "array", text: copy text)); }

// array_in, for one dimension: an optional "[lo:hi]=" decoration, then "{", the elements, "}". An element is
// quoted ("…", with \" and \\) or bare (backslash escapes allowed, surrounding space dropped); a bare NULL, in any
// case, is NULL.
unsafe fn Result<ArrayValues, DecodeError> textElements(ConstView<uint8> b, const ref string text, uint32 elementOid) {
    uint8 delim = arrayDelimiter(elementOid: elementOid);
    isize i = 0;
    while (i < b.length() && arraySpace(c: b[i])) { i = i + 1; }
    int32 lower = 1;
    int32 upper = 0;
    bool decorated = false;
    if (i < b.length() && b[i] == 91ui8) {                       // '['
        decorated = true;
        i = i + 1;
        int32 sign = 1;
        if (i < b.length() && b[i] == 45ui8) { sign = -1; i = i + 1; }
        int64 lo = 0i64;
        isize digits = i;
        while (i < b.length() && b[i] >= 48ui8 && b[i] <= 57ui8 && lo < 10000000000i64) { lo = lo * 10i64 + cast<int64>(b[i] - 48ui8); i = i + 1; }
        if (i == digits || i >= b.length() || b[i] != 58ui8) { return badArray(text: text); }   // ':'
        i = i + 1;
        int32 hsign = 1;
        if (i < b.length() && b[i] == 45ui8) { hsign = -1; i = i + 1; }
        int64 hi = 0i64;
        digits = i;
        while (i < b.length() && b[i] >= 48ui8 && b[i] <= 57ui8 && hi < 10000000000i64) { hi = hi * 10i64 + cast<int64>(b[i] - 48ui8); i = i + 1; }
        if (i == digits || i + 1 >= b.length() || b[i] != 93ui8) { return badArray(text: text); }   // ']'
        i = i + 1;
        if (b[i] == 91ui8) { return Result::Err(error: DecodeError::Unsupported(type: "array", what: "an array of more than one dimension; this client reads one")); }
        if (b[i] != 61ui8) { return badArray(text: text); }   // '='
        i = i + 1;
        if (lo > 2147483647i64 || hi > 2147483647i64) { return badArray(text: text); }
        lower = sign * cast<int32>(lo);
        upper = hsign * cast<int32>(hi);
        while (i < b.length() && arraySpace(c: b[i])) { i = i + 1; }
    }
    if (i >= b.length() || b[i] != 123ui8) { return badArray(text: text); }   // '{'
    i = i + 1;
    ArrayValues a = ArrayValues.make(elementOid: elementOid, format: FORMAT_TEXT, lowerBound: lower);
    while (i < b.length() && arraySpace(c: b[i])) { i = i + 1; }
    if (i < b.length() && b[i] == 125ui8) {                       // "{}"
        i = i + 1;
    } else {
        bool more = true;
        while (more) {
            while (i < b.length() && arraySpace(c: b[i])) { i = i + 1; }
            if (i >= b.length()) { return badArray(text: text); }
            if (b[i] == 123ui8) { return Result::Err(error: DecodeError::Unsupported(type: "array", what: "an array of more than one dimension; this client reads one")); }
            DynamicArray<uint8> element = DynamicArray.empty();
            bool quoted = false;
            bool escaped = false;   // a bare element with an escape is never NULL
            if (b[i] == 34ui8) {                                  // '"'
                quoted = true;
                i = i + 1;
                bool closed = false;
                while (i < b.length() && !closed) {
                    if (b[i] == 92ui8) {                          // '\'
                        if (i + 1 >= b.length()) { return badArray(text: text); }
                        element.add(item: b[i + 1]);
                        i = i + 2;
                    } else if (b[i] == 34ui8) { closed = true; i = i + 1; }
                    else { element.add(item: b[i]); i = i + 1; }
                }
                if (!closed) { return badArray(text: text); }
                while (i < b.length() && arraySpace(c: b[i])) { i = i + 1; }
            } else {
                isize keep = 0;   // the element's length up to its last character that is not trailing space
                while (i < b.length() && b[i] != delim && b[i] != 125ui8) {
                    if (b[i] == 34ui8 || b[i] == 123ui8) { return badArray(text: text); }
                    if (b[i] == 92ui8) {
                        if (i + 1 >= b.length()) { return badArray(text: text); }
                        element.add(item: b[i + 1]);
                        escaped = true;
                        i = i + 2;
                        keep = element.length();
                    } else {
                        element.add(item: b[i]);
                        if (!arraySpace(c: b[i])) { keep = element.length(); }
                        i = i + 1;
                    }
                }
                while (element.length() > keep) { Optional<uint8> dropped = element.pop(); }
                if (element.length() == 0) { return badArray(text: text); }
            }
            bool isNull = !quoted && !escaped && element.length() == 4
                && (element[0] == 78ui8 || element[0] == 110ui8) && (element[1] == 85ui8 || element[1] == 117ui8)
                && (element[2] == 76ui8 || element[2] == 108ui8) && (element[3] == 76ui8 || element[3] == 108ui8);
            if (isNull) { a.addNull(); } else { a.add(value: element.view()); }
            if (i >= b.length()) { return badArray(text: text); }
            if (b[i] == 125ui8) { more = false; i = i + 1; }
            else if (b[i] == delim) { i = i + 1; }
            else { return badArray(text: text); }
        }
    }
    while (i < b.length() && arraySpace(c: b[i])) { i = i + 1; }
    if (i != b.length()) { return badArray(text: text); }
    if (decorated && cast<int64>(upper) - cast<int64>(lower) + 1i64 != cast<int64>(a.count())) { return badArray(text: text); }
    return Result::Ok(value: give a);
}

// array_out: the text of a one-dimensional array whose elements' texts are `texts` (a NULL at `nulls[i]`). An
// element is quoted when it is empty, is NULL spelled as text, or holds a quote, a backslash, a brace, the
// delimiter or white space; inside quotes, a quote and a backslash are escaped. A lower bound other than 1 is
// written as PostgreSQL writes it, "[0:2]={…}".
fn string formatArray(const ref DynamicArray<string> texts, const ref DynamicArray<bool> nulls, int32 lowerBound, uint8 delimiter) {
    DynamicArray<uint8> acc = DynamicArray.empty();
    if (lowerBound != 1 && texts.length() > 0) {
        int64 upper = cast<int64>(lowerBound) + cast<int64>(texts.length()) - 1i64;
        string head = "[${lowerBound}:${upper}]=";
        appendBytes(to: ref acc, from: head.bytes());
    }
    acc.add(item: 123ui8);
    isize i = 0;
    while (i < texts.length()) {
        if (i > 0) { acc.add(item: delimiter); }
        if (nulls[i]) { string n = "NULL"; appendBytes(to: ref acc, from: n.bytes()); }
        else { appendElement(to: ref acc, e: texts[i].bytes(), isNullWord: texts[i].toLower().equals(other: "null"), delimiter: delimiter); }
        i = i + 1;
    }
    acc.add(item: 125ui8);
    return textFromBytes(b: acc.view());
}

fn void appendElement(ref DynamicArray<uint8> to, ConstView<uint8> e, bool isNullWord, uint8 delimiter) {
    bool quote = e.length() == 0 || isNullWord;
    isize k = 0;
    while (k < e.length() && !quote) {
        uint8 c = e[k];
        if (c == 34ui8 || c == 92ui8 || c == 123ui8 || c == 125ui8 || c == delimiter || arraySpace(c: c)) { quote = true; }
        k = k + 1;
    }
    if (quote) { to.add(item: 34ui8); }
    k = 0;
    while (k < e.length()) {
        if (quote && (e[k] == 34ui8 || e[k] == 92ui8)) { to.add(item: 92ui8); }
        to.add(item: e[k]);
        k = k + 1;
    }
    if (quote) { to.add(item: 34ui8); }
}

fn void appendBytes(ref DynamicArray<uint8> to, ConstView<uint8> from) {
    isize i = 0;
    while (i < from.length()) { to.add(item: from[i]); i = i + 1; }
}

// The elements are UTF-8 text, and so is everything added around them.
unsafe fn string textFromBytes(ConstView<uint8> b) {
    Result<string, DecodeError> t = utf8Text(raw: b);
    return match (give t) { case Ok(value: s): give s; case Err(error: e): ""; };
}
