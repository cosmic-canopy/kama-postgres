// GENERATED by tools/gen-win32-errors.sh from PostgreSQL REL_18_STABLE (c45ba888d7af7b38e33832a0e240e34ca98ef866),
// src/interfaces/libpq/win32.c and src/port/win32error.c; the constants from mingw-w64 v13.0.0
// (de62c283f3383bd825c98518cb0a42ba071d4ac2), winerror.h and errno.h; and the texts of the UCRT's strerror, asked of
// it. Do not edit: change the script and run it again.
//
// How libpq words a failure the operating system reports on Windows. postgres::wire::strerror uses these there.
export { winsockText, errnoOfWin32, crtStrerror };

// libpq's WSErrors table: what winsock_strerror says for a Winsock code, or None for one it does not list.
fn Optional<string> winsockText(int32 code) {
    if (code == 0) { return Optional::Some(value: "No error"); }   // 0
    if (code == 10004) { return Optional::Some(value: "Interrupted system call"); }   // WSAEINTR
    if (code == 10009) { return Optional::Some(value: "Bad file number"); }   // WSAEBADF
    if (code == 10013) { return Optional::Some(value: "Permission denied"); }   // WSAEACCES
    if (code == 10014) { return Optional::Some(value: "Bad address"); }   // WSAEFAULT
    if (code == 10022) { return Optional::Some(value: "Invalid argument"); }   // WSAEINVAL
    if (code == 10024) { return Optional::Some(value: "Too many open sockets"); }   // WSAEMFILE
    if (code == 10035) { return Optional::Some(value: "Operation would block"); }   // WSAEWOULDBLOCK
    if (code == 10036) { return Optional::Some(value: "Operation now in progress"); }   // WSAEINPROGRESS
    if (code == 10037) { return Optional::Some(value: "Operation already in progress"); }   // WSAEALREADY
    if (code == 10038) { return Optional::Some(value: "Socket operation on non-socket"); }   // WSAENOTSOCK
    if (code == 10039) { return Optional::Some(value: "Destination address required"); }   // WSAEDESTADDRREQ
    if (code == 10040) { return Optional::Some(value: "Message too long"); }   // WSAEMSGSIZE
    if (code == 10041) { return Optional::Some(value: "Protocol wrong type for socket"); }   // WSAEPROTOTYPE
    if (code == 10042) { return Optional::Some(value: "Bad protocol option"); }   // WSAENOPROTOOPT
    if (code == 10043) { return Optional::Some(value: "Protocol not supported"); }   // WSAEPROTONOSUPPORT
    if (code == 10044) { return Optional::Some(value: "Socket type not supported"); }   // WSAESOCKTNOSUPPORT
    if (code == 10045) { return Optional::Some(value: "Operation not supported on socket"); }   // WSAEOPNOTSUPP
    if (code == 10046) { return Optional::Some(value: "Protocol family not supported"); }   // WSAEPFNOSUPPORT
    if (code == 10047) { return Optional::Some(value: "Address family not supported"); }   // WSAEAFNOSUPPORT
    if (code == 10048) { return Optional::Some(value: "Address already in use"); }   // WSAEADDRINUSE
    if (code == 10049) { return Optional::Some(value: "Cannot assign requested address"); }   // WSAEADDRNOTAVAIL
    if (code == 10050) { return Optional::Some(value: "Network is down"); }   // WSAENETDOWN
    if (code == 10051) { return Optional::Some(value: "Network is unreachable"); }   // WSAENETUNREACH
    if (code == 10052) { return Optional::Some(value: "Net connection reset"); }   // WSAENETRESET
    if (code == 10053) { return Optional::Some(value: "Software caused connection abort"); }   // WSAECONNABORTED
    if (code == 10054) { return Optional::Some(value: "Connection reset by peer"); }   // WSAECONNRESET
    if (code == 10055) { return Optional::Some(value: "No buffer space available"); }   // WSAENOBUFS
    if (code == 10056) { return Optional::Some(value: "Socket is already connected"); }   // WSAEISCONN
    if (code == 10057) { return Optional::Some(value: "Socket is not connected"); }   // WSAENOTCONN
    if (code == 10058) { return Optional::Some(value: "Cannot send after socket shutdown"); }   // WSAESHUTDOWN
    if (code == 10059) { return Optional::Some(value: "Too many references, cannot splice"); }   // WSAETOOMANYREFS
    if (code == 10060) { return Optional::Some(value: "Connection timed out"); }   // WSAETIMEDOUT
    if (code == 10061) { return Optional::Some(value: "Connection refused"); }   // WSAECONNREFUSED
    if (code == 10062) { return Optional::Some(value: "Too many levels of symbolic links"); }   // WSAELOOP
    if (code == 10063) { return Optional::Some(value: "File name too long"); }   // WSAENAMETOOLONG
    if (code == 10064) { return Optional::Some(value: "Host is down"); }   // WSAEHOSTDOWN
    if (code == 10065) { return Optional::Some(value: "No route to host"); }   // WSAEHOSTUNREACH
    if (code == 10066) { return Optional::Some(value: "Directory not empty"); }   // WSAENOTEMPTY
    if (code == 10067) { return Optional::Some(value: "Too many processes"); }   // WSAEPROCLIM
    if (code == 10068) { return Optional::Some(value: "Too many users"); }   // WSAEUSERS
    if (code == 10069) { return Optional::Some(value: "Disc quota exceeded"); }   // WSAEDQUOT
    if (code == 10070) { return Optional::Some(value: "Stale NFS file handle"); }   // WSAESTALE
    if (code == 10071) { return Optional::Some(value: "Too many levels of remote in path"); }   // WSAEREMOTE
    if (code == 10091) { return Optional::Some(value: "Network system is unavailable"); }   // WSASYSNOTREADY
    if (code == 10092) { return Optional::Some(value: "Winsock version out of range"); }   // WSAVERNOTSUPPORTED
    if (code == 10093) { return Optional::Some(value: "WSAStartup not yet called"); }   // WSANOTINITIALISED
    if (code == 10101) { return Optional::Some(value: "Graceful shutdown in progress"); }   // WSAEDISCON
    if (code == 11001) { return Optional::Some(value: "Host not found"); }   // WSAHOST_NOT_FOUND
    if (code == 11002) { return Optional::Some(value: "NA Host not found / SERVFAIL"); }   // WSATRY_AGAIN
    if (code == 11003) { return Optional::Some(value: "Non recoverable FORMERR||REFUSED||NOTIMP"); }   // WSANO_RECOVERY
    if (code == 11004) { return Optional::Some(value: "No host data of that type was found"); }   // WSANO_DATA
    return Optional::None;
}

// _dosmaperr: the errno PostgreSQL's Windows port gives a Win32 code. The first entry for a code wins, as in its
// loop, and a code it does not list is EINVAL.
fn int32 errnoOfWin32(int32 code) {
    if (code == 0) { return 0; }
    if (code == 1) { return 22; }   // ERROR_INVALID_FUNCTION -> EINVAL
    if (code == 2) { return 2; }   // ERROR_FILE_NOT_FOUND -> ENOENT
    if (code == 3) { return 2; }   // ERROR_PATH_NOT_FOUND -> ENOENT
    if (code == 4) { return 24; }   // ERROR_TOO_MANY_OPEN_FILES -> EMFILE
    if (code == 5) { return 13; }   // ERROR_ACCESS_DENIED -> EACCES
    if (code == 6) { return 9; }   // ERROR_INVALID_HANDLE -> EBADF
    if (code == 7) { return 12; }   // ERROR_ARENA_TRASHED -> ENOMEM
    if (code == 8) { return 12; }   // ERROR_NOT_ENOUGH_MEMORY -> ENOMEM
    if (code == 9) { return 12; }   // ERROR_INVALID_BLOCK -> ENOMEM
    if (code == 10) { return 7; }   // ERROR_BAD_ENVIRONMENT -> E2BIG
    if (code == 11) { return 8; }   // ERROR_BAD_FORMAT -> ENOEXEC
    if (code == 12) { return 22; }   // ERROR_INVALID_ACCESS -> EINVAL
    if (code == 13) { return 22; }   // ERROR_INVALID_DATA -> EINVAL
    if (code == 15) { return 2; }   // ERROR_INVALID_DRIVE -> ENOENT
    if (code == 16) { return 13; }   // ERROR_CURRENT_DIRECTORY -> EACCES
    if (code == 17) { return 18; }   // ERROR_NOT_SAME_DEVICE -> EXDEV
    if (code == 18) { return 2; }   // ERROR_NO_MORE_FILES -> ENOENT
    if (code == 33) { return 13; }   // ERROR_LOCK_VIOLATION -> EACCES
    if (code == 32) { return 13; }   // ERROR_SHARING_VIOLATION -> EACCES
    if (code == 53) { return 2; }   // ERROR_BAD_NETPATH -> ENOENT
    if (code == 65) { return 13; }   // ERROR_NETWORK_ACCESS_DENIED -> EACCES
    if (code == 67) { return 2; }   // ERROR_BAD_NET_NAME -> ENOENT
    if (code == 80) { return 17; }   // ERROR_FILE_EXISTS -> EEXIST
    if (code == 82) { return 13; }   // ERROR_CANNOT_MAKE -> EACCES
    if (code == 83) { return 13; }   // ERROR_FAIL_I24 -> EACCES
    if (code == 87) { return 22; }   // ERROR_INVALID_PARAMETER -> EINVAL
    if (code == 89) { return 11; }   // ERROR_NO_PROC_SLOTS -> EAGAIN
    if (code == 108) { return 13; }   // ERROR_DRIVE_LOCKED -> EACCES
    if (code == 109) { return 32; }   // ERROR_BROKEN_PIPE -> EPIPE
    if (code == 112) { return 28; }   // ERROR_DISK_FULL -> ENOSPC
    if (code == 114) { return 9; }   // ERROR_INVALID_TARGET_HANDLE -> EBADF
    if (code == 6) { return 22; }   // ERROR_INVALID_HANDLE -> EINVAL
    if (code == 128) { return 10; }   // ERROR_WAIT_NO_CHILDREN -> ECHILD
    if (code == 129) { return 10; }   // ERROR_CHILD_NOT_COMPLETE -> ECHILD
    if (code == 130) { return 9; }   // ERROR_DIRECT_ACCESS_HANDLE -> EBADF
    if (code == 131) { return 22; }   // ERROR_NEGATIVE_SEEK -> EINVAL
    if (code == 132) { return 13; }   // ERROR_SEEK_ON_DEVICE -> EACCES
    if (code == 145) { return 41; }   // ERROR_DIR_NOT_EMPTY -> ENOTEMPTY
    if (code == 158) { return 13; }   // ERROR_NOT_LOCKED -> EACCES
    if (code == 161) { return 2; }   // ERROR_BAD_PATHNAME -> ENOENT
    if (code == 164) { return 11; }   // ERROR_MAX_THRDS_REACHED -> EAGAIN
    if (code == 167) { return 13; }   // ERROR_LOCK_FAILED -> EACCES
    if (code == 183) { return 17; }   // ERROR_ALREADY_EXISTS -> EEXIST
    if (code == 206) { return 2; }   // ERROR_FILENAME_EXCED_RANGE -> ENOENT
    if (code == 215) { return 11; }   // ERROR_NESTING_NOT_ALLOWED -> EAGAIN
    if (code == 1816) { return 12; }   // ERROR_NOT_ENOUGH_QUOTA -> ENOMEM
    if (code == 303) { return 2; }   // ERROR_DELETE_PENDING -> ENOENT
    if (code == 123) { return 2; }   // ERROR_INVALID_NAME -> ENOENT
    if (code == 1921) { return 2; }   // ERROR_CANT_RESOLVE_FILENAME -> ENOENT
    return 22;   // EINVAL
}

// The UCRT's strerror for each errno errnoOfWin32 gives.
fn string crtStrerror(int32 n) {
    if (n == 2) { return "No such file or directory"; }
    if (n == 7) { return "Arg list too long"; }
    if (n == 8) { return "Exec format error"; }
    if (n == 9) { return "Bad file descriptor"; }
    if (n == 10) { return "No child processes"; }
    if (n == 11) { return "Resource temporarily unavailable"; }
    if (n == 12) { return "Not enough space"; }
    if (n == 13) { return "Permission denied"; }
    if (n == 17) { return "File exists"; }
    if (n == 18) { return "Improper link"; }
    if (n == 22) { return "Invalid argument"; }
    if (n == 24) { return "Too many open files"; }
    if (n == 28) { return "No space left on device"; }
    if (n == 32) { return "Broken pipe"; }
    if (n == 41) { return "Directory not empty"; }
    return "Unknown error";
}
