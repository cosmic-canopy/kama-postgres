import { std::collections::FixedArray, std::collections::DynamicArray, std::collections::ConstView, std::io::IoError,
         std::io::IoErrorKind, std::memory::Owned, std::net::Interest, std::time::Instant,
         std::time::Duration, std::time::monotonicNow, std::encoding::utf8::decode as utf8Decode, std::encoding::utf8::Utf8Error,
         postgres::Transport, postgres::Ready, postgres::PgError, postgres::ServerError,
         postgres::protocol::Frame, postgres::protocol::Framing, postgres::protocol::frame, postgres::protocol::decode,
         postgres::protocol::BackendMessage, postgres::protocol::ProtocolError, postgres::protocol::ErrorFields,
         postgres::protocol::HEADER_BYTES, postgres::protocol::STARTUP_ERROR_MAX, postgres::protocol::invalidErrorText };
export { Wire, Deadline, strerror, serverClosedText };

// postgres::wire — messages over a `Transport`: framing the bytes that arrive into backend messages, and writing
// frontend bytes out, each step bounded by a deadline. Internal: a connection is the only user.

// What libpq prints for an I/O failure, strerror's words: the operating system's own text for its code ("Connection
// refused"), or, for an error kama raised itself, the kind's.
fn string strerror(const ref IoError e) {
    Optional<string> words = e.osMessage();
    return match (give words) { case Some(value: w): give w; case None: e.message(); };
}

// libpq's words for a connection the server dropped: pqReadData at EOF, and pqsecure_raw_read and pqsecure_raw_write
// on EPIPE and ECONNRESET.
fn string serverClosedText() {
    return "server closed the connection unexpectedly\n\tThis probably means the server terminated abnormally\n\tbefore or while processing the request.";
}

// What the wire was doing when the transport failed, which decides libpq's words for it.
type enum Doing { Reading, Writing, Waiting }

// When a wait must end: never, or at an instant of the monotonic clock.
type value Deadline implements Sendable {
    bool bounded = false;
    Instant at;

    public ctor none() { this.bounded = false; this.at = Instant.of(rawNanos: 0ui64); }
    public unsafe ctor after(Duration span) { this.bounded = true; this.at = monotonicNow() + span; }

    public const fn bool isBounded() { return this.bounded; }

    // Whichever of the two ends first.
    public const fn Deadline sooner(Deadline other) {
        if (!other.bounded) { return this; }
        if (!this.bounded) { return other; }
        if (other.at < this.at) { return other; }
        return this;
    }

    // What `Transport.wait` takes: -1 for no limit, else the milliseconds left, rounded up so a wait never ends
    // just short of the deadline and spins; 0 once it has passed.
    public unsafe const fn int32 remainingMs() {
        if (!this.bounded) { return -1; }
        Instant now = monotonicNow();
        if (now >= this.at) { return 0; }
        int64 nanos = (this.at - now).asNanos();
        int64 ms = (nanos + 999999i64) / 1000000i64;
        if (ms > 2147483647i64) { return 2147483647; }
        return cast<int32>(ms);
    }
}

// The receive buffer starts at libpq's size and grows as a message's bytes arrive, up to the protocol's 1 GiB cap.
// Once it has drained, a buffer grown past RETAIN_BYTES is given back.
comptime isize INITIAL_BYTES = 16384;
comptime isize RETAIN_BYTES = 1048576;

type resource Wire implements Sendable {
    Owned<Transport> link;
    FixedArray<uint8> buf;
    isize start = 0;   // the first byte not yet consumed
    isize end = 0;     // one past the last byte read
    isize readCap = -1;   // Limits.readBuffer: the most bytes held while a write waits; -1 for no bound

    public ctor over(Owned<Transport> transport) {
        this.link = give transport;
        this.buf = FixedArray.make(size: INITIAL_BYTES);
        this.start = 0;
        this.end = 0;
        this.readCap = -1;
    }

    // Over a transport some of whose bytes were read before this Wire existed (the answer to an SSLRequest was
    // read alone, and the server may already have sent more): `preread` is what was read past it, first in line.
    public ctor resume(Owned<Transport> transport, ConstView<uint8> preread) {
        this.link = give transport;
        isize size = INITIAL_BYTES;
        while (size < preread.length()) { size = size * 2; }
        this.buf = FixedArray.make(size: size);
        isize i = 0;
        while (i < preread.length()) { this.buf[i] = preread[i]; i = i + 1; }
        this.start = 0;
        this.end = preread.length();
        this.readCap = -1;
    }

    // Limits.readBuffer: the most bytes this wire holds while a write waits (None for no bound).
    public fn void setReadLimit(Optional<isize> bytes) {
        isize cap = match (bytes) { case Some(value: n): n; case None: -1; };
        this.readCap = cap;
    }

    // The next message from the server, read where `framing` says (before authentication, in a session, during COPY
    // OUT). The bytes of every message are checked before anything is believed (postgres::protocol): a malformed one
    // is `Protocol`, and the connection cannot recover its framing after it.
    public unsafe fn Result<BackendMessage, PgError> receive(Deadline deadline, Framing framing) {
        bool startup = match (framing) { case Startup: true; case _: false; };
        isize scanned = 1;   // a pre-3.0 error's bytes already searched for its NUL, from `start`
        while (true) {
            Frame f = frame(buf: this.buf.slice(from: this.start, count: this.end - this.start), framing: framing);
            match (give f) {
                case Complete(tag: t, total: n): {
                    Result<BackendMessage, ProtocolError> m = decode(tag: t, body: this.buf.slice(from: this.start + HEADER_BYTES, count: n - HEADER_BYTES));
                    this.consume(n: n);
                    return match (give m) {
                        case Ok(value: v): Result::Ok(value: give v);
                        case Err(error: e): {
                            // PQconnectPoll's words for an ErrorResponse it cannot read before authentication.
                            if (startup && t == 69ui8) { return Result::Err(error: PgError::Protocol(error: ProtocolError::Violation(detail: invalidErrorText()))); }
                            := Result::Err(error: PgError::Protocol(error: give e));
                        }
                    };
                }
                case Incomplete(needed: k): {
                    Result<Unit, PgError> filled = this.fill(needed: k, deadline: deadline);
                    match (give filled) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                }
                case Invalid(error: e): { return Result::Err(error: PgError::Protocol(error: give e)); }
                case OldError: {
                    Optional<Result<BackendMessage, PgError>> read = this.oldError(scanned: scanned);
                    match (give read) {
                        case Some(value: r): { return give r; }
                        case None: {
                            scanned = this.end - this.start;
                            Result<Unit, PgError> more = this.fill(needed: this.end - this.start + 1, deadline: deadline);
                            match (give more) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                        }
                    };
                }
            };
        }
    }

    // A pre-3.0 server's error before authentication, as PQconnectPoll reads it: the text after the 'E' up to a NUL,
    // returned as the server's error. None while no NUL has come and there is room for more; past STARTUP_ERROR_MAX
    // bytes without one, the message is refused. The search goes on from the `scanned` bytes already searched.
    //
    // Stricter than libpq in one case: an empty text, which libpq reports as an empty error, is refused in its words
    // for an error it cannot read. What it holds is a v3 header with a length under 8, and nothing a person can act on.
    unsafe fn Optional<Result<BackendMessage, PgError>> oldError(isize scanned) {
        isize i = this.start + scanned;
        while (i < this.end && this.buf[i] != 0ui8) { i = i + 1; }
        if (i == this.start + 1) {
            this.consume(n: 2);
            return Optional::Some(value: Result::Err(error: PgError::Protocol(error: ProtocolError::Violation(detail: invalidErrorText()))));
        }
        if (i < this.end) {
            Result<string, Utf8Error> text = utf8Decode(bytes: this.buf.slice(from: this.start + 1, count: i - this.start - 1));
            this.consume(n: i + 1 - this.start);
            return match (give text) {
                case Ok(value: t): {
                    DynamicArray<uint8> codes = DynamicArray.empty();
                    DynamicArray<string> texts = DynamicArray.empty();
                    codes.add(item: 77ui8);   // 'M': the text is all the server said
                    texts.add(item: give t);
                    := Optional::Some(value: Result::Err(error: PgError::Server(error: ServerError.make(fields: ErrorFields.make(codes: give codes, texts: give texts)))));
                }
                case Err(error: e): Optional::Some(value: Result::Err(error: PgError::Protocol(error: ProtocolError::NotUtf8(tag: 69ui8))));
            };
        }
        if (this.end - this.start - 1 > cast<isize>(STARTUP_ERROR_MAX)) {
            return Optional::Some(value: Result::Err(error: PgError::Protocol(error: ProtocolError::Violation(detail: invalidErrorText()))));
        }
        return Optional::None;
    }

    // Write all of `bytes`, waiting for the transport as often as it needs, until `deadline`. While a write must wait,
    // whatever the server sends is read into the buffer, as libpq's pqSendSome reads: a server writing results for
    // the commands it already has stops reading once its own output fills, so a client that only wrote would wait
    // forever on a long pipeline or COPY. Once the server has stopped sending (EOF, an error), only writing is waited
    // for; the reader meets the end when it gets there.
    //
    // What arrives meanwhile is held, up to Limits.readBuffer: past it the server is sending without end while it will
    // not take what is written, and the write fails with PgError::Limit.
    public unsafe fn Result<Unit, PgError> send(ConstView<uint8> bytes, Deadline deadline) {
        isize sent = 0;
        bool reading = true;
        while (sent < bytes.length()) {
            Result<isize, IoError> w = this.link.write(bytes: bytes.slice(from: sent, count: bytes.length() - sent));
            bool wait = false;
            match (w) {
                case Ok(value: n): { if (n > 0) { sent = sent + n; } else { wait = true; } }
                case Err(error: e): {
                    match (e.kind()) { case WouldBlock: { wait = true; } case Interrupted: { } case _: { return Result::Err(error: this.failure(error: e, doing: Doing::Writing)); } };
                }
            };
            if (wait) {
                Interest want = Interest::Write;
                if (reading) { want = Interest::ReadWrite; }
                Result<Ready, IoError> ready = this.link.wait(interest: want, timeoutMs: deadline.remainingMs());
                Ready r = match (ready) { case Ok(value: v): v; case Err(error: e): { return Result::Err(error: this.failure(error: e, doing: Doing::Waiting)); } };
                if (!r.writable && !(reading && r.readable)) { return Result::Err(error: PgError::Timeout); }
                if (reading && r.readable) {
                    reading = this.drain();
                    if (this.readCap >= 0 && this.end - this.start > this.readCap) {
                        isize cap = this.readCap;
                        return Result::Err(error: PgError::Limit(detail: "the server sent more than ${cap} bytes while a write waited (Limits.readBuffer); the connection is closed"));
                    }
                }
            }
        }
        return Result::Ok(value: Unit::Unit);
    }

    // One read of whatever has arrived, into the buffer, which grows to take it. False once the server has stopped
    // sending: at EOF, or on an error, which a later read reports.
    unsafe fn bool drain() {
        this.makeRoom(needed: this.end - this.start + INITIAL_BYTES);
        Result<isize, IoError> r = this.link.read(into: this.buf.sliceMut(from: this.end, count: this.buf.length() - this.end));
        match (r) {
            case Ok(value: n): {
                if (n == 0) { return false; }
                this.end = this.end + n;
            }
            case Err(error: e): {
                match (e.kind()) { case WouldBlock: { } case Interrupted: { } case _: { return false; } };
            }
        };
        return true;
    }

    // For a cancel request's connection, once the request is sent: wait for the server to close it, as libpq's
    // PQcancelPoll waits. Ok(false) when it has, having sent nothing; Ok(true) if it sent anything, which a server
    // answering a cancel request never does. A TLS session must end with close_notify: a truncated one is the
    // failure libpq reports too.
    public unsafe fn Result<bool, PgError> awaitEnd(Deadline deadline) {
        if (this.end > this.start) { return Result::Ok(value: true); }
        while (true) {
            this.makeRoom(needed: INITIAL_BYTES);
            Result<isize, IoError> r = this.link.read(into: this.buf.sliceMut(from: this.end, count: this.buf.length() - this.end));
            bool wait = false;
            match (r) {
                case Ok(value: n): {
                    if (n == 0) { return Result::Ok(value: false); }
                    this.end = this.end + n;
                    return Result::Ok(value: true);
                }
                case Err(error: e): {
                    match (e.kind()) { case WouldBlock: { wait = true; } case Interrupted: { } case _: { return Result::Err(error: this.failure(error: e, doing: Doing::Reading)); } };
                }
            };
            if (wait) {
                Result<Unit, PgError> ready = this.await(interest: Interest::Read, deadline: deadline);
                match (give ready) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
            }
        }
    }

    // Bytes received and not yet taken as messages.
    public const fn isize buffered() { return this.end - this.start; }

    // Stop the transport in both directions. Buffered bytes are dropped with it.
    public unsafe fn void shutdown() {
        this.link.shutdown();
        this.start = 0;
        this.end = 0;
    }

    // Read until at least `needed` bytes from `start` are buffered. The buffer grows only as bytes arrive, doubling up
    // to what is needed, so a header that declares a large message costs nothing until its body comes.
    unsafe fn Result<Unit, PgError> fill(isize needed, Deadline deadline) {
        while (this.end - this.start < needed) {
            if (this.end == this.buf.length()) {
                isize want = (this.end - this.start) * 2;
                if (want < INITIAL_BYTES) { want = INITIAL_BYTES; }
                if (want > needed) { want = needed; }
                this.makeRoom(needed: want);
            }
            Result<isize, IoError> r = this.link.read(into: this.buf.sliceMut(from: this.end, count: this.buf.length() - this.end));
            bool wait = false;
            match (r) {
                case Ok(value: n): {
                    if (n == 0) { return Result::Err(error: this.failure(error: IoError.of(kind: IoErrorKind::UnexpectedEof), doing: Doing::Reading)); }
                    this.end = this.end + n;
                }
                case Err(error: e): {
                    match (e.kind()) { case WouldBlock: { wait = true; } case Interrupted: { } case _: { return Result::Err(error: this.failure(error: e, doing: Doing::Reading)); } };
                }
            };
            if (wait) {
                Result<Unit, PgError> ready = this.await(interest: Interest::Read, deadline: deadline);
                match (give ready) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
            }
        }
        return Result::Ok(value: Unit::Unit);
    }

    unsafe fn Result<Unit, PgError> await(Interest interest, Deadline deadline) {
        Result<Ready, IoError> w = this.link.wait(interest: interest, timeoutMs: deadline.remainingMs());
        Ready r = match (w) { case Ok(value: v): v; case Err(error: e): { return Result::Err(error: this.failure(error: e, doing: Doing::Waiting)); } };
        // Only the side asked for counts: a transport ready for the other one has not let this one proceed.
        bool ready = match (interest) { case Read: r.readable; case Write: r.writable; case ReadWrite: r.readable || r.writable; case _: r.readable || r.writable; };
        if (!ready) { return Result::Err(error: PgError::Timeout); }
        return Result::Ok(value: Unit::Unit);
    }

    // A failure the transport reported, in its own words when it has them (a TLS transport's), else in libpq's for a
    // socket (pqsecure_raw_read, pqsecure_raw_write, pqSocketCheck): a server that hung up, whatever the wire was doing,
    // is "server closed the connection unexpectedly…", and anything else names what failed, with the OS's words.
    fn PgError failure(IoError error, Doing doing) {
        Optional<PgError> own = this.link.explain(error: error);
        match (give own) { case Some(value: p): { return give p; } case None: { } };
        bool dropped = match (error.kind()) { case UnexpectedEof: true; case BrokenPipe: true; case ConnectionReset: true; case _: false; };
        if (dropped) { return PgError::Lost(detail: serverClosedText(), cause: error); }
        string lead = match (doing) {
            case Reading: "could not receive data from server: ";
            case Writing: "could not send data to server: ";
            case Waiting: "select() failed: ";
        };
        return PgError::Lost(detail: lead.concat(other: strerror(e: error)), cause: error);
    }

    // Space for `needed` bytes from `start`: the unread bytes move to the front, and the buffer doubles until
    // they fit.
    unsafe fn void makeRoom(isize needed) {
        if (this.start + needed <= this.buf.length()) { return; }
        isize size = this.buf.length();
        while (size < needed) { size = size * 2; }
        isize unread = this.end - this.start;
        if (size == this.buf.length()) {
            isize i = 0;
            while (i < unread) { this.buf[i] = this.buf[this.start + i]; i = i + 1; }
        } else {
            FixedArray<uint8> grown = FixedArray.make(size: size);
            isize i = 0;
            while (i < unread) { grown[i] = this.buf[this.start + i]; i = i + 1; }
            this.buf = give grown;
        }
        this.start = 0;
        this.end = unread;
    }

    fn void consume(isize n) {
        this.start = this.start + n;
        if (this.start < this.end) { return; }
        this.start = 0;
        this.end = 0;
        if (this.buf.length() > RETAIN_BYTES) { this.buf = FixedArray.make(size: INITIAL_BYTES); }
    }
}
