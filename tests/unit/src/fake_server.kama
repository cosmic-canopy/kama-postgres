// A PostgreSQL server played from a script, as a Transport: no network, no clock. The client's bytes are framed
// into messages as they arrive, and each message takes the next step of the script, which may check it and
// queues the server's reply. Replies are handed to the client `chunk` bytes per read, and the client's writes are
// accepted `writeLimit` bytes at a time, so framing and partial writes are exercised on every test.
//
// When the script has nothing more to say, a read reports WouldBlock and `wait` reports a timeout (a silent
// server), or, after `Hangup`, a read reports the end of the stream.
//
// TLS: an SSLRequest is answered 'N' without taking a step, as a server with ssl=off answers it, unless the script's
// next step is `SslAnswer`, or the server was made with `secure`: then it answers 'S' and runs Mbed TLS as the server
// (@kama/tls, over the in-memory `ServerSide`), and the steps see the plaintext. A secure server that accepts direct
// negotiation takes a TLS ClientHello in place of an SSLRequest; one that does not hangs up on it, as a server older
// than 17 does.
import { std::collections::DynamicArray, std::collections::View, std::collections::ConstView,
         std::collections::FixedArray, std::io::IoError, std::io::IoErrorKind, std::net::Interest, std::net::Ready,
         std::net::ReliableStream, std::concurrent::Sender, std::concurrent::SendResult,
         tls::TlsStream, tls::TlsConfig, tls::TlsError, tls::Progress,
         std::encoding::base64::encode as b64encode, std::encoding::base64::decode as b64decode,
         std::encoding::base64::DecodeError, std::encoding::utf8::decode as utf8Decode,
         std::encoding::utf8::Utf8Error, std::encoding::hex::encode as hexEncode, std::digest::pbkdf2, std::digest::sha256::Sha256,
         std::digest::sha256::hmacSha256, std::digest::sha256::sha256,
         postgres::Transport, postgres::PgError, postgres::protocol::MessageWriter, postgres::protocol::md5Password };
export { FakeServer, Step, Wire, ServerSide };

// What the server does with the next message from the client.
type enum Step implements Sendable {
    // Reply with these bytes, whatever the message was.
    Send(DynamicArray<uint8> bytes),
    // The message must be a PasswordMessage holding exactly `text`; then reply with `then`. Otherwise reply
    // FATAL 28P01, as a server does for a wrong password.
    Password(string text, DynamicArray<uint8> then),
    // The message must be SASLInitialResponse for SCRAM-SHA-256; reply AuthenticationSASLContinue with the
    // server-first-message. `extend` false answers with a nonce that does not extend the client's.
    ScramFirst(string password, bool extend),
    // The message must be the client-final-message, with a proof that the password is right (else FATAL 28P01).
    // Reply with AuthenticationSASLFinal, `signature` saying which: "right", "wrong", or "error" (an e=
    // attribute); "none" skips SASLFinal and sends `then` at once. Then `then`.
    ScramFinal(string signature, DynamicArray<uint8> then),
    // The message must be of type `tag` and, unless `body` is "", have exactly these bytes after its length, in hex
    // (spaces ignored); then reply with `then`. Otherwise reply FATAL 08P01 naming what was expected, and hang up.
    Expect(uint8 tag, string body, DynamicArray<uint8> then),
    // Close the connection: right after the previous step's reply, or, as the first step, after the first message.
    Hangup,
    // Say nothing.
    Silent,
    // Answer an SSLRequest with exactly these bytes ('E', a byte that is no answer, 'S' and more, 'N' and more). An
    // answer starting 'S' starts TLS when the server is secure.
    SslAnswer(DynamicArray<uint8> bytes),
    // The SASLInitialResponse must use `header` ("p" for SCRAM-SHA-256-PLUS with p=tls-server-end-point, "y" or "n"
    // for SCRAM-SHA-256), then as ScramFirst.
    ScramFirstBound(string password, string header),
    // Reply with `then`, then end the TLS session in order (close_notify) and close the connection.
    TlsClose(DynamicArray<uint8> then),
    // Reply with `then`, damaged in transit: its last record will not authenticate.
    TlsGarble(DynamicArray<uint8> then),
    // The message must be a CancelRequest whose body (after its length) is `body`, in hex; then the server closes
    // the connection as PostgreSQL does after one (over TLS, with close_notify). Otherwise FATAL 08P01, as Expect.
    Cancel(string body),
    // Reply with `then`, late: the client's next wait for it ends without it (as when a query timeout passes), and
    // it is there for the wait after.
    Late(DynamicArray<uint8> then)
}

// The server's side of the TLS session: what the client sent waits in `inbound` for the engine, and what the engine
// writes collects in `outbound` until the fake hands it to the client. Always non-blocking; no Shared, so the fake
// stays Sendable.
type resource ServerSide implements ReliableStream, Sendable {
    DynamicArray<uint8> inbound;
    isize inAt = 0;
    DynamicArray<uint8> outbound;

    public ctor make() { this.inbound = DynamicArray.empty(); this.inAt = 0; this.outbound = DynamicArray.empty(); }

    public fn void feed(ConstView<uint8> bytes) { isize i = 0; while (i < bytes.length()) { this.inbound.add(item: bytes[i]); i = i + 1; } }
    public fn void feedArray(const ref DynamicArray<uint8> bytes) { foreach (uint8 b in bytes) { this.inbound.add(item: b); } }
    // Hand what the engine wrote to `into`.
    public fn void drain(ref DynamicArray<uint8> into) { foreach (uint8 b in this.outbound) { into.add(item: b); } this.outbound = DynamicArray.empty(); }

    public fn Result<isize, IoError> read(View<uint8> into) {
        isize available = this.inbound.length() - this.inAt;
        if (available == 0) { return Result::Err(error: IoError.of(kind: IoErrorKind::WouldBlock)); }
        isize n = available;
        if (n > into.length()) { n = into.length(); }
        isize i = 0;
        while (i < n) { into[i] = this.inbound[this.inAt + i]; i = i + 1; }
        this.inAt = this.inAt + n;
        if (this.inAt == this.inbound.length()) { this.inbound = DynamicArray.empty(); this.inAt = 0; }
        return Result::Ok(value: n);
    }
    public fn Result<isize, IoError> write(ConstView<uint8> bytes) {
        isize i = 0;
        while (i < bytes.length()) { this.outbound.add(item: bytes[i]); i = i + 1; }
        return Result::Ok(value: bytes.length());
    }
    public fn Result<Unit, IoError> flush() { return Result::Ok(value: Unit::Unit); }
    public fn Result<Unit, IoError> setNonBlocking(bool on) { return Result::Ok(value: Unit::Unit); }
}

// Backend messages, built as the protocol documentation lays them out.
type resource Wire {
    MessageWriter w;
    public ctor make() { this.w = MessageWriter.make(); }
    public fn DynamicArray<uint8> bytes() { return copied(v: this.w.view()); }
    public fn void auth(int32 code) { this.w.begin(tag: 82ui8); this.w.putI32(v: code); this.w.end(); }
    public fn void authMd5(uint8 a, uint8 b, uint8 c, uint8 d) {
        this.w.begin(tag: 82ui8); this.w.putI32(v: 5); this.w.putU8(v: a); this.w.putU8(v: b); this.w.putU8(v: c); this.w.putU8(v: d); this.w.end();
    }
    public fn void authSasl(const ref DynamicArray<string> mechanisms) {
        this.w.begin(tag: 82ui8); this.w.putI32(v: 10);
        isize i = 0;
        while (i < mechanisms.length()) { bool ok = this.w.putCString(s: mechanisms[i]); i = i + 1; }
        this.w.putU8(v: 0ui8);
        this.w.end();
    }
    public fn void authSaslData(int32 code, const ref string data) {
        this.w.begin(tag: 82ui8); this.w.putI32(v: code); this.w.putBytes(b: data.bytes()); this.w.end();
    }
    public fn void parameter(const ref string name, const ref string value) {
        this.w.begin(tag: 83ui8); bool a = this.w.putCString(s: name); bool b = this.w.putCString(s: value); this.w.end();
    }
    public fn void backendKey(int32 pid, isize keyLength) {
        this.w.begin(tag: 75ui8); this.w.putI32(v: pid);
        isize i = 0;
        while (i < keyLength) { this.w.putU8(v: truncate<uint8>(i + 1)); i = i + 1; }
        this.w.end();
    }
    public fn void ready(uint8 status) { this.w.begin(tag: 90ui8); this.w.putU8(v: status); this.w.end(); }
    // An ErrorResponse ('E') or NoticeResponse ('N') with severity, SQLSTATE and message.
    public fn void report(uint8 tag, const ref string severity, const ref string code, const ref string message) {
        this.w.begin(tag: tag);
        this.w.putU8(v: 83ui8); bool a = this.w.putCString(s: severity);
        this.w.putU8(v: 86ui8); bool b = this.w.putCString(s: severity);
        this.w.putU8(v: 67ui8); bool c = this.w.putCString(s: code);
        this.w.putU8(v: 77ui8); bool d = this.w.putCString(s: message);
        this.w.putU8(v: 0ui8);
        this.w.end();
    }
    public fn void negotiate(int32 version, const ref DynamicArray<string> unrecognized) {
        this.w.begin(tag: 118ui8); this.w.putI32(v: version); this.w.putI32(v: cast<int32>(unrecognized.length()));
        isize i = 0;
        while (i < unrecognized.length()) { bool ok = this.w.putCString(s: unrecognized[i]); i = i + 1; }
        this.w.end();
    }
    // A RowDescription of text columns of type text (OID 25).
    public fn void columns(const ref DynamicArray<string> names) {
        this.w.begin(tag: 84ui8); this.w.putI16(v: cast<int16>(names.length()));
        isize i = 0;
        while (i < names.length()) {
            bool ok = this.w.putCString(s: names[i]);
            this.w.putI32(v: 0); this.w.putI16(v: 0i16); this.w.putI32(v: 25); this.w.putI16(v: -1i16); this.w.putI32(v: -1); this.w.putI16(v: 0i16);
            i = i + 1;
        }
        this.w.end();
    }
    // A DataRow; a value of "\u{1}NULL" stands for NULL.
    public fn void row(const ref DynamicArray<string> values) {
        this.w.begin(tag: 68ui8); this.w.putI16(v: cast<int16>(values.length()));
        isize i = 0;
        while (i < values.length()) {
            if (values[i].equals(other: "NULL!")) { this.w.putI32(v: -1); }
            else { this.w.putI32(v: cast<int32>(values[i].length())); this.w.putBytes(b: values[i].bytes()); }
            i = i + 1;
        }
        this.w.end();
    }
    // A DataRow with one value of raw bytes.
    public fn void rawRow(ConstView<uint8> value) {
        this.w.begin(tag: 68ui8); this.w.putI16(v: 1i16); this.w.putI32(v: cast<int32>(value.length())); this.w.putBytes(b: value); this.w.end();
    }
    public fn void complete(const ref string tag) { this.w.begin(tag: 67ui8); bool ok = this.w.putCString(s: tag); this.w.end(); }
    public fn void emptyQuery() { this.w.begin(tag: 73ui8); this.w.end(); }
    public fn void notification(int32 pid, const ref string channel, const ref string payload) {
        this.w.begin(tag: 65ui8); this.w.putI32(v: pid); bool a = this.w.putCString(s: channel); bool b = this.w.putCString(s: payload); this.w.end();
    }
    public fn void copyResponse(uint8 tag) { this.w.begin(tag: tag); this.w.putU8(v: 0ui8); this.w.putI16(v: 1i16); this.w.putI16(v: 0i16); this.w.end(); }
    public fn void copyData(const ref string data) { this.w.begin(tag: 100ui8); this.w.putBytes(b: data.bytes()); this.w.end(); }
    public fn void copyDone() { this.w.begin(tag: 99ui8); this.w.end(); }
    // Raw bytes, for a message no server would send.
    public fn void raw(ConstView<uint8> b) { this.w.putBytes(b: b); }

    // The extended protocol's replies.
    public fn void parseComplete() { this.w.begin(tag: 49ui8); this.w.end(); }
    public fn void bindComplete() { this.w.begin(tag: 50ui8); this.w.end(); }
    public fn void closeComplete() { this.w.begin(tag: 51ui8); this.w.end(); }
    public fn void noData() { this.w.begin(tag: 110ui8); this.w.end(); }
    public fn void portalSuspended() { this.w.begin(tag: 115ui8); this.w.end(); }
    // ParameterDescription: each parameter's type.
    public fn void parameterTypes(const ref DynamicArray<uint32> oids) {
        this.w.begin(tag: 116ui8); this.w.putI16(v: cast<int16>(oids.length()));
        isize i = 0;
        while (i < oids.length()) { this.w.putU32(v: oids[i]); i = i + 1; }
        this.w.end();
    }
    // A RowDescription of columns of the given types, as a statement's Describe gives it (format 0).
    public fn void typedColumns(const ref DynamicArray<string> names, const ref DynamicArray<uint32> oids) {
        this.w.begin(tag: 84ui8); this.w.putI16(v: cast<int16>(names.length()));
        isize i = 0;
        while (i < names.length()) {
            bool ok = this.w.putCString(s: names[i]);
            this.w.putI32(v: 0); this.w.putI16(v: 0i16); this.w.putU32(v: oids[i]); this.w.putI16(v: -1i16); this.w.putI32(v: -1); this.w.putI16(v: 0i16);
            i = i + 1;
        }
        this.w.end();
    }
    // A RowDescription as a portal's Describe gives it: each column in the format it was bound for.
    public fn void boundColumns(const ref DynamicArray<string> names, const ref DynamicArray<uint32> oids, int16 format) {
        this.w.begin(tag: 84ui8); this.w.putI16(v: cast<int16>(names.length()));
        isize i = 0;
        while (i < names.length()) {
            bool ok = this.w.putCString(s: names[i]);
            this.w.putI32(v: 0); this.w.putI16(v: 0i16); this.w.putU32(v: oids[i]); this.w.putI16(v: -1i16); this.w.putI32(v: -1); this.w.putI16(v: format);
            i = i + 1;
        }
        this.w.end();
    }
    // A DataRow of int4 values in binary.
    public fn void intRow(const ref DynamicArray<int32> values) {
        this.w.begin(tag: 68ui8); this.w.putI16(v: cast<int16>(values.length()));
        isize i = 0;
        while (i < values.length()) { this.w.putI32(v: 4); this.w.putI32(v: values[i]); i = i + 1; }
        this.w.end();
    }
}

fn DynamicArray<uint8> copied(ConstView<uint8> v) {
    DynamicArray<uint8> b = DynamicArray.empty();
    isize i = 0;
    while (i < v.length()) { b.add(item: v[i]); i = i + 1; }
    return b;
}

// The fixed parts of the fake's SCRAM exchange.
fn string serverNonceTail() { return "fakeServerNonce"; }

type resource FakeServer implements Transport, Sendable {
    DynamicArray<Step> steps;
    isize next = 0;
    DynamicArray<uint8> toClient;
    isize readAt = 0;
    DynamicArray<uint8> fromClient;
    isize parsedAt = 0;
    bool startupSeen = false;
    bool hungUp = false;
    bool discarding = false;   // hung up on a direct ClientHello: what the client still sends is lost, as on a socket
    isize chunk = 1;
    isize writeLimit = 3;
    string clientFirstBare;
    string serverFirst;
    string scramPassword;
    string gs2Header;
    DynamicArray<TlsConfig> tlsConfig;               // zero or one: a secure server's configuration
    DynamicArray<TlsStream<ServerSide>> engine;      // zero or one: the session, once TLS has started
    bool tlsMode = false;
    bool established = false;
    bool directAccepted = false;
    DynamicArray<uint8> endPoint;                    // the server certificate's tls-server-end-point hash
    string sniWanted;                                // "" checks nothing; "-" wants no SNI; else that name
    // Policy mode: a server as 005_negotiate_encryption.pl configures one, with no script. Each step of the
    // negotiation is decided by its settings and pg_hba lines, and logged as an event to `events`.
    bool policy = false;
    string injection;                                // an injection point attached, "none" for none
    DynamicArray<string> hbaTypes;
    DynamicArray<string> hbaUsers;
    bool overSocket = false;
    DynamicArray<Sender<string>> events;             // zero or one
    // A server blocked on its own output: with more than `backlog` bytes of its replies unread by the client, it
    // takes none of the client's bytes (a write would block, and the transport is not writable) until the client
    // reads. -1: never.
    isize backlog = -1;
    DynamicArray<uint8> held;   // a late reply (Step::Late), given to the client after one wait in vain

    public ctor make(DynamicArray<Step> steps, isize chunk, isize writeLimit) {
        this.steps = give steps; this.next = 0;
        this.toClient = DynamicArray.empty(); this.readAt = 0;
        this.fromClient = DynamicArray.empty(); this.parsedAt = 0;
        this.startupSeen = false; this.hungUp = false;
        this.chunk = chunk; this.writeLimit = writeLimit;
        this.clientFirstBare = ""; this.serverFirst = ""; this.scramPassword = ""; this.gs2Header = "n,,";
        this.tlsConfig = DynamicArray.empty(); this.engine = DynamicArray.empty();
        this.tlsMode = false; this.established = false; this.directAccepted = false;
        this.endPoint = DynamicArray.empty(); this.sniWanted = "";
        this.policy = false; this.injection = "none"; this.hbaTypes = DynamicArray.empty(); this.hbaUsers = DynamicArray.empty();
        this.overSocket = false; this.events = DynamicArray.empty(); this.backlog = -1; this.held = DynamicArray.empty();
    }

    // `make`, blocked on its own output past `backlog` bytes of unread replies (see `backlog`).
    public ctor jammed(DynamicArray<Step> steps, isize chunk, isize writeLimit, isize backlog) {
        this.steps = give steps; this.next = 0;
        this.toClient = DynamicArray.empty(); this.readAt = 0;
        this.fromClient = DynamicArray.empty(); this.parsedAt = 0;
        this.startupSeen = false; this.hungUp = false;
        this.chunk = chunk; this.writeLimit = writeLimit;
        this.clientFirstBare = ""; this.serverFirst = ""; this.scramPassword = ""; this.gs2Header = "n,,";
        this.tlsConfig = DynamicArray.empty(); this.engine = DynamicArray.empty();
        this.tlsMode = false; this.established = false; this.directAccepted = false;
        this.endPoint = DynamicArray.empty(); this.sniWanted = "";
        this.policy = false; this.injection = "none"; this.hbaTypes = DynamicArray.empty(); this.hbaUsers = DynamicArray.empty();
        this.overSocket = false; this.events = DynamicArray.empty(); this.backlog = backlog; this.held = DynamicArray.empty();
    }

    // A server with TLS: it answers an SSLRequest 'S' and serves the script over `config` (and takes a direct
    // ClientHello when `direct`). `endPoint` is its certificate's tls-server-end-point hash, which a bound SCRAM
    // exchange must carry. `sni`: "" checks nothing, "-" requires that the client sent no SNI, anything else that it
    // sent that name; a mismatch is a FATAL error once the handshake is done.
    public ctor secure(DynamicArray<Step> steps, isize chunk, isize writeLimit, TlsConfig config, bool direct, DynamicArray<uint8> endPoint, string sni) {
        this.steps = give steps; this.next = 0;
        this.toClient = DynamicArray.empty(); this.readAt = 0;
        this.fromClient = DynamicArray.empty(); this.parsedAt = 0;
        this.startupSeen = false; this.hungUp = false;
        this.chunk = chunk; this.writeLimit = writeLimit;
        this.clientFirstBare = ""; this.serverFirst = ""; this.scramPassword = ""; this.gs2Header = "n,,";
        this.tlsConfig = DynamicArray.empty(); this.tlsConfig.add(item: give config);
        this.engine = DynamicArray.empty();
        this.tlsMode = false; this.established = false; this.directAccepted = direct;
        this.endPoint = give endPoint; this.sniWanted = give sni;
        this.policy = false; this.injection = "none"; this.hbaTypes = DynamicArray.empty(); this.hbaUsers = DynamicArray.empty();
        this.overSocket = false; this.events = DynamicArray.empty(); this.backlog = -1; this.held = DynamicArray.empty();
    }

    // A server in policy mode: TLS on (`config`, taking an SSLRequest or a direct ClientHello) or off, an injection
    // point ("none", "backend-initialize", "backend-initialize-v2-error", "backend-ssl-startup"), and pg_hba lines (a
    // connection type and a user, each trust). `socket`: the client came over a Unix socket.
    public ctor policyServer(TlsConfig config, bool sslOn, string injection, DynamicArray<string> types, DynamicArray<string> users,
                             bool socket, Sender<string> events) {
        this.steps = DynamicArray.empty(); this.next = 0;
        this.toClient = DynamicArray.empty(); this.readAt = 0;
        this.fromClient = DynamicArray.empty(); this.parsedAt = 0;
        this.startupSeen = false; this.hungUp = false;
        this.chunk = 1; this.writeLimit = 3;
        this.clientFirstBare = ""; this.serverFirst = ""; this.scramPassword = ""; this.gs2Header = "n,,";
        this.tlsConfig = DynamicArray.empty();
        if (sslOn) { this.tlsConfig.add(item: give config); } else { TlsConfig unused = give config; }
        this.engine = DynamicArray.empty();
        this.tlsMode = false; this.established = false; this.directAccepted = sslOn;
        this.endPoint = DynamicArray.empty(); this.sniWanted = "";
        this.policy = true; this.injection = give injection; this.hbaTypes = give types; this.hbaUsers = give users;
        this.overSocket = socket; this.events = DynamicArray.empty(); this.events.add(item: give events); this.backlog = -1; this.held = DynamicArray.empty(); this.held = DynamicArray.empty();
    }

    unsafe fn void event(const ref string name) {
        if (this.events.length() == 0) { return; }
        SendResult<string> r = this.events[0].send(item: copy name);
    }

    // As the backend errors out when an injection point fires: an ErrorResponse (or protocol 2's error text) to
    // whatever the client sent first, then gone.
    unsafe fn bool injected() {
        if (this.injection.equals(other: "backend-initialize")) {
            this.event(name: "backenderror");
            Wire m = Wire.make();
            m.report(tag: 69ui8, severity: "FATAL", code: "XX000", message: "error triggered for injection point backend-initialize");
            this.queue(b: m.bytes().view());
            this.hungUp = true;
            return true;
        }
        if (this.injection.equals(other: "backend-initialize-v2-error")) {
            this.event(name: "v2error");
            string text = "Eprotocol version 2 error triggered";
            DynamicArray<uint8> bytes = DynamicArray.empty();
            foreach (uint8 b in text) { bytes.add(item: b); }
            bytes.add(item: 0ui8);
            this.queue(b: bytes.view());
            this.hungUp = true;
            return true;
        }
        return false;
    }

    // pg_hba: the first line whose type and user match decides; every line is trust.
    fn bool admitted(const ref string user) {
        isize i = 0;
        while (i < this.hbaTypes.length()) {
            string kind = copy this.hbaTypes[i];
            bool typeMatches = false;
            if (kind.equals(other: "local")) { typeMatches = this.overSocket; }
            else if (kind.equals(other: "host") || kind.equals(other: "hostnogssenc")) { typeMatches = !this.overSocket; }
            else if (kind.equals(other: "hostssl")) { typeMatches = !this.overSocket && this.tlsMode; }
            else if (kind.equals(other: "hostnossl")) { typeMatches = !this.overSocket && !this.tlsMode; }
            if (typeMatches && this.hbaUsers[i].equals(other: user)) { return true; }
            i = i + 1;
        }
        return false;
    }

    // The startup packet in policy mode: authenticated (trust) or refused as the server refuses with no pg_hba entry.
    unsafe fn void policyStartup(const ref DynamicArray<uint8> body) {
        if (this.injected()) { return; }
        string user = startupValue(body: body, name: "user");
        if (this.admitted(user: user)) {
            this.event(name: "authok");
            Wire m = Wire.make();
            m.auth(code: 0);
            m.parameter(name: "client_encoding", value: "UTF8");
            m.parameter(name: "server_version", value: "18.0");
            m.backendKey(pid: 77, keyLength: 4);
            m.ready(status: 73ui8);
            this.queue(b: m.bytes().view());
            return;
        }
        this.event(name: "authfail");
        string encryption = "no encryption";
        if (this.tlsMode) { encryption = "SSL encryption"; }
        Wire m = Wire.make();
        m.report(tag: 69ui8, severity: "FATAL", code: "28000",
                 message: "no pg_hba.conf entry for host \"127.0.0.1\", user \"".concat(other: user).concat(other: "\", database \"postgres\", ").concat(other: encryption));
        this.queue(b: m.bytes().view());
        this.hungUp = true;
    }

    public unsafe fn Result<isize, IoError> read(View<uint8> into) {
        isize available = this.toClient.length() - this.readAt;
        if (available == 0) {
            if (this.hungUp) { return Result::Ok(value: 0); }
            return Result::Err(error: IoError.of(kind: IoErrorKind::WouldBlock));
        }
        isize n = available;
        if (n > this.chunk) { n = this.chunk; }
        if (n > into.length()) { n = into.length(); }
        isize i = 0;
        while (i < n) { into[i] = this.toClient[this.readAt + i]; i = i + 1; }
        this.readAt = this.readAt + n;
        return Result::Ok(value: n);
    }

    fn bool blocked() { return this.backlog >= 0 && this.toClient.length() - this.readAt > this.backlog; }

    public unsafe fn Result<isize, IoError> write(ConstView<uint8> bytes) {
        if (this.discarding) { return Result::Ok(value: bytes.length()); }
        if (this.hungUp) { return Result::Err(error: IoError.of(kind: IoErrorKind::BrokenPipe)); }
        if (this.blocked()) { return Result::Err(error: IoError.of(kind: IoErrorKind::WouldBlock)); }
        isize n = bytes.length();
        if (n > this.writeLimit) { n = this.writeLimit; }
        if (this.tlsMode) {
            this.engine[0].innerRefMut().feed(bytes: bytes.slice(from: 0, count: n));
            this.pump();
            return Result::Ok(value: n);
        }
        isize i = 0;
        while (i < n) { this.fromClient.add(item: bytes[i]); i = i + 1; }
        this.serve();
        return Result::Ok(value: n);
    }

    // TLS has started: the client's next bytes are the engine's.
    unsafe fn void startTls() {
        Result<TlsStream<ServerSide>, TlsError> opened = TlsStream::<ServerSide>.server(inner: ServerSide.make(), config: this.tlsConfig[0]);
        match (give opened) {
            case Ok(value: t): { this.engine.add(item: give t); this.tlsMode = true; }
            case Err(error: e): { this.hungUp = true; }
        };
        // Whatever the client sent past the request (a direct ClientHello) is ciphertext.
        DynamicArray<uint8> rest = DynamicArray.empty();
        isize i = this.parsedAt;
        while (i < this.fromClient.length()) { rest.add(item: this.fromClient[i]); i = i + 1; }
        this.fromClient = DynamicArray.empty();
        this.parsedAt = 0;
        if (this.tlsMode) { this.engine[0].innerRefMut().feedArray(bytes: rest); this.pump(); }
    }

    // Run the engine on what the client sent: the handshake, then the plaintext through the script, then the
    // ciphertext out to the client.
    unsafe fn void pump() {
        if (!this.established) {
            Result<Progress, TlsError> step = this.engine[0].handshake();
            match (give step) {
                case Ok(value: p): {
                    Progress at = p;
                    bool done = match (at) { case Done: true; case _: false; };
                    if (done) { this.established = true; this.checkSni(); }
                }
                case Err(error: e): { this.hungUp = true; }
            };
        }
        if (this.established && !this.hungUp) {
            FixedArray<uint8> buf = FixedArray.make(size: 4096);
            bool more = true;
            while (more) {
                Result<isize, IoError> r = this.engine[0].read(into: buf.viewMut());
                match (r) {
                    case Ok(value: n): {
                        if (n == 0) { more = false; }
                        isize i = 0;
                        while (i < n) { this.fromClient.add(item: buf[i]); i = i + 1; }
                    }
                    case Err(error: e): { more = false; }
                };
            }
            this.serve();
        }
        this.engine[0].innerRefMut().drain(into: this.toClient);
    }

    unsafe fn void checkSni() {
        if (this.sniWanted.length() == 0) { return; }
        Optional<string> seen = this.engine[0].requestedServerName();
        string got = match (give seen) { case Some(value: v): give v; case None: "-"; };
        if (!got.equals(other: this.sniWanted)) {
            Wire m = Wire.make();
            m.report(tag: 69ui8, severity: "FATAL", code: "08P01", message: "fake server: SNI ".concat(other: got).concat(other: ", wanted ").concat(other: this.sniWanted));
            this.queue(b: m.bytes().view());
            this.hungUp = true;
        }
    }

    public fn Result<Ready, IoError> wait(Interest interest, int32 timeoutMs) {
        if (this.held.length() > 0) {
            // This wait ends without the late reply; it is there for the next.
            foreach (uint8 b in this.held) { this.toClient.add(item: b); }
            this.held = DynamicArray.empty();
            return Result::Ok(value: Ready.of(readable: false, writable: !this.blocked()));
        }
        bool readable = this.readAt < this.toClient.length() || this.hungUp;
        return Result::Ok(value: Ready.of(readable: readable, writable: !this.blocked()));
    }

    public fn void shutdown() { }
    public fn Optional<PgError> explain(IoError error) { return Optional::None; }

    // Frame every whole message the client has sent, and answer each with the next step.
    unsafe fn void serve() {
        bool more = true;
        while (more) {
            isize start = this.parsedAt;
            isize have = this.fromClient.length() - start;
            // A TLS ClientHello (record type 22) where a startup packet belongs: direct negotiation.
            if (!this.startupSeen && !this.tlsMode && have > 0 && this.fromClient[start] == 22ui8) {
                if (this.directAccepted && this.tlsConfig.length() > 0) {
                    if (this.policy) { this.event(name: "directsslaccept"); }
                    this.startTls();
                } else {
                    if (this.policy) { this.event(name: "directsslreject"); }
                    this.hungUp = true;
                    this.discarding = true;
                }
                return;
            }
            isize header = 5;
            if (!this.startupSeen) { header = 4; }
            if (have < header) { return; }
            isize lenAt = start + header - 4;
            isize len = (cast<isize>(this.fromClient[lenAt]) << 24) | (cast<isize>(this.fromClient[lenAt + 1]) << 16)
                      | (cast<isize>(this.fromClient[lenAt + 2]) << 8) | cast<isize>(this.fromClient[lenAt + 3]);
            isize total = len + header - 4;
            if (have < total) { return; }
            uint8 tag = 0ui8;
            if (this.startupSeen) { tag = this.fromClient[start]; }
            DynamicArray<uint8> body = DynamicArray.empty();
            isize i = start + header;
            while (i < start + total) { body.add(item: this.fromClient[i]); i = i + 1; }
            this.parsedAt = start + total;
            // An SSLRequest (length 8, code 80877103) is answered here, and the startup packet is still to come.
            if (!this.startupSeen && total == 8 && body.length() == 4 && body[0] == 4ui8 && body[1] == 210ui8 && body[2] == 22ui8 && body[3] == 47ui8) {
                this.answerSslRequest();
                if (this.tlsMode || this.hungUp) { return; }
                continue;
            }
            bool first = !this.startupSeen;
            this.startupSeen = true;
            // In policy mode the startup packet decides everything; what follows it (Terminate) gets no answer.
            if (this.policy) { if (first) { this.policyStartup(body: body); } if (this.hungUp) { return; } continue; }
            this.answer(tag: tag, body: body);
        }
    }

    unsafe fn void answer(uint8 tag, const ref DynamicArray<uint8> body) {
        if (tag == 88ui8) { return; }   // Terminate: no reply
        if (this.next >= this.steps.length()) { return; }
        isize at = this.next;
        this.next = this.next + 1;
        match (this.steps[at]) {
            case Send(bytes: b): { this.queue(b: b.view()); }
            case Password(text: expected, then: t): {
                string got = cString(body: body, from: 0);
                if (tag == 112ui8 && got.equals(other: expected)) { this.queue(b: t.view()); } else { this.refuse(); }
            }
            case ScramFirst(password: pw, extend: ext): {
                // SASLInitialResponse: mechanism, Int32 length, client-first-message.
                string mechanism = cString(body: body, from: 0);
                isize dataAt = mechanism.length() + 1 + 4;
                string clientFirst = textFrom(body: body, from: dataAt);
                if (tag != 112ui8 || !mechanism.equals(other: "SCRAM-SHA-256") || !clientFirst.startsWith(prefix: "n,,")) { this.refuse(); return; }
                this.scramPassword = copy pw;
                this.clientFirstBare = clientFirst.substring(start: 3, end: clientFirst.length());
                string clientNonce = attribute(message: this.clientFirstBare, name: "r");
                string nonce = clientNonce.concat(other: serverNonceTail());
                if (!ext) { nonce = "notTheClientsNonce"; }
                string salt = "a2FtYS1wb3N0Z3Jlcy1zYWx0";   // base64 of "kama-postgres-salt"
                this.serverFirst = "r=".concat(other: nonce).concat(other: ",s=").concat(other: salt).concat(other: ",i=4096");
                Wire m = Wire.make();
                m.authSaslData(code: 11, data: this.serverFirst);
                this.queue(b: m.bytes().view());
            }
            case ScramFinal(signature: sig, then: t): {
                string clientFinal = textFrom(body: body, from: 0);
                Optional<usize> proofAt = clientFinal.find(substring: ",p=");
                isize cut = match (proofAt) { case Some(value: i): cast<isize>(i); case None: -1; };
                if (tag != 112ui8 || cut < 0) { this.refuse(); return; }
                string withoutProof = clientFinal.substring(start: 0, end: cut);
                string proof = clientFinal.substring(start: cut + 3, end: clientFinal.length());
                // c= is the GS2 header, and for p=tls-server-end-point the server certificate's hash after it.
                DynamicArray<uint8> binding = DynamicArray.empty();
                foreach (uint8 b in this.gs2Header) { binding.add(item: b); }
                if (this.gs2Header.startsWith(prefix: "p=")) { foreach (uint8 b in this.endPoint) { binding.add(item: b); } }
                string wantC = b64encode(bytes: binding.view());
                if (!attribute(message: withoutProof, name: "c").equals(other: wantC)) { this.refuse(); return; }
                string authMessage = this.clientFirstBare.concat(other: ",").concat(other: this.serverFirst).concat(other: ",").concat(other: withoutProof);
                string saltText = "kama-postgres-salt";
                FixedArray<uint8> salted = FixedArray.make(size: 32);
                pbkdf2(hash: Sha256.make(), password: this.scramPassword.bytes(), salt: saltText.bytes(), iterations: 4096, into: salted.viewMut());
                string clientLabel = "Client Key";
                string serverLabel = "Server Key";
                InlineArray<uint8>#(32) clientKey = hmacSha256(key: salted.view(), message: clientLabel.bytes());
                InlineArray<uint8>#(32) storedKey = sha256(bytes: clientKey.view());
                InlineArray<uint8>#(32) clientSignature = hmacSha256(key: storedKey.view(), message: authMessage.bytes());
                InlineArray<uint8>#(32) expected = [0ui8; 32];
                isize k = 0;
                while (k < 32) { expected[cast<usize>(k)] = clientKey[cast<usize>(k)] ^ clientSignature[cast<usize>(k)]; k = k + 1; }
                string expectedText = b64encode(bytes: expected.view());
                if (!proof.equals(other: expectedText)) { this.refuse(); return; }
                InlineArray<uint8>#(32) serverKey = hmacSha256(key: salted.view(), message: serverLabel.bytes());
                InlineArray<uint8>#(32) serverSignature = hmacSha256(key: serverKey.view(), message: authMessage.bytes());
                if (sig.equals(other: "wrong")) { serverSignature[0] = serverSignature[0] ^ 1ui8; }
                Wire m = Wire.make();
                if (sig.equals(other: "error")) { m.authSaslData(code: 12, data: "e=other-error"); }
                else if (!sig.equals(other: "none")) {
                    string v = b64encode(bytes: serverSignature.view());
                    m.authSaslData(code: 12, data: "v=".concat(other: v));
                }
                this.queue(b: m.bytes().view());
                this.queue(b: t.view());
            }
            case Expect(tag: want, body: hex, then: t): {
                string compact = hex.replace(old: " ", with: "");
                string got = hexEncode(bytes: body.view());
                if (tag != want || (compact.length() > 0 && !got.equals(other: compact))) {
                    Wire m = Wire.make();
                    string wanted = "fake server: expected a message of type ${want}, got ${tag} with body ".concat(other: got);
                    m.report(tag: 69ui8, severity: "FATAL", code: "08P01", message: wanted);
                    this.queue(b: m.bytes().view());
                    this.hungUp = true;
                    return;
                }
                this.queue(b: t.view());
            }
            case Hangup: { this.hungUp = true; }
            case Silent: { }
            case SslAnswer(bytes: b): { this.queue(b: b.view()); }
            case ScramFirstBound(password: pw, header: h): {
                string mechanism = cString(body: body, from: 0);
                isize dataAt = mechanism.length() + 1 + 4;
                string clientFirst = textFrom(body: body, from: dataAt);
                string wantMechanism = "SCRAM-SHA-256";
                string wantHeader = copy h;
                if (h.equals(other: "p")) { wantMechanism = "SCRAM-SHA-256-PLUS"; wantHeader = "p=tls-server-end-point"; }
                wantHeader = wantHeader.concat(other: ",,");
                if (tag != 112ui8 || !mechanism.equals(other: wantMechanism) || !clientFirst.startsWith(prefix: wantHeader)) {
                    Wire m = Wire.make();
                    m.report(tag: 69ui8, severity: "FATAL", code: "08P01", message: "fake server: SASL ".concat(other: mechanism).concat(other: " ").concat(other: clientFirst));
                    this.queue(b: m.bytes().view());
                    this.hungUp = true;
                    return;
                }
                this.gs2Header = copy wantHeader;
                this.scramPassword = copy pw;
                this.clientFirstBare = clientFirst.substring(start: wantHeader.length(), end: clientFirst.length());
                string clientNonce = attribute(message: this.clientFirstBare, name: "r");
                string nonce = clientNonce.concat(other: serverNonceTail());
                string salt = "a2FtYS1wb3N0Z3Jlcy1zYWx0";
                this.serverFirst = "r=".concat(other: nonce).concat(other: ",s=").concat(other: salt).concat(other: ",i=4096");
                Wire m = Wire.make();
                m.authSaslData(code: 11, data: this.serverFirst);
                this.queue(b: m.bytes().view());
            }
            case TlsClose(then: t): {
                this.queue(b: t.view());
                Result<Unit, TlsError> closed = this.engine[0].close();
                this.engine[0].innerRefMut().drain(into: this.toClient);
                this.hungUp = true;
            }
            case TlsGarble(then: t): {
                this.queue(b: t.view());
                isize last = this.toClient.length() - 1;
                if (last >= 0) { this.toClient[last] = this.toClient[last] ^ 1ui8; }
            }
            case Late(then: t): { foreach (uint8 b in t) { this.held.add(item: b); } }
            case Cancel(body: hex): {
                string compact = hex.replace(old: " ", with: "");
                string got = hexEncode(bytes: body.view());
                if (tag != 0ui8 || !got.equals(other: compact)) {
                    Wire m = Wire.make();
                    m.report(tag: 69ui8, severity: "FATAL", code: "08P01", message: "fake server: expected a CancelRequest ".concat(other: compact).concat(other: ", got ").concat(other: got));
                    this.queue(b: m.bytes().view());
                    this.hungUp = true;
                    return;
                }
                if (this.tlsMode) {
                    Result<Unit, TlsError> closed = this.engine[0].close();
                    this.engine[0].innerRefMut().drain(into: this.toClient);
                }
                this.hungUp = true;
            }
        };
        // A Hangup after a reply closes the connection as soon as that reply is sent.
        if (this.next < this.steps.length()) {
            bool hangup = match (this.steps[this.next]) { case Hangup: true; case _: false; };
            if (hangup) { this.hungUp = true; this.next = this.next + 1; }
        }
    }

    unsafe fn void answerSslRequest() {
        if (this.policy) {
            if (this.injected()) { return; }
            DynamicArray<uint8> one = DynamicArray.empty();
            if (this.tlsConfig.length() == 0) {
                this.event(name: "sslreject");
                one.add(item: 78ui8);
                this.queue(b: one.view());
                return;
            }
            this.event(name: "sslaccept");
            one.add(item: 83ui8);
            this.queue(b: one.view());
            if (this.injection.equals(other: "backend-ssl-startup")) {
                // The backend fails setting up TLS: it logs, and the connection is gone.
                this.event(name: "backenderror");
                this.hungUp = true;
                this.discarding = true;
                return;
            }
            this.startTls();
            return;
        }
        bool scripted = false;
        if (this.next < this.steps.length()) { scripted = match (this.steps[this.next]) { case SslAnswer(bytes: b): true; case _: false; }; }
        if (scripted) {
            isize at = this.next;
            this.next = this.next + 1;
            bool yes = false;
            match (this.steps[at]) {
                case SslAnswer(bytes: b): { this.queue(b: b.view()); yes = b.length() > 0 && b[0] == 83ui8; }
                case _: { }
            };
            if (yes && this.tlsConfig.length() > 0) { this.startTls(); }
            return;
        }
        DynamicArray<uint8> one = DynamicArray.empty();
        if (this.tlsConfig.length() > 0) {
            one.add(item: 83ui8);   // 'S'
            this.queue(b: one.view());
            this.startTls();
            return;
        }
        one.add(item: 78ui8);       // 'N'
        this.queue(b: one.view());
    }

    unsafe fn void refuse() {
        Wire m = Wire.make();
        m.report(tag: 69ui8, severity: "FATAL", code: "28P01", message: "password authentication failed for user \"fake\"");
        this.queue(b: m.bytes().view());
        this.hungUp = true;
    }

    // A reply: in plaintext, or once TLS is up, through the engine.
    unsafe fn void queue(ConstView<uint8> b) {
        if (this.tlsMode && this.established) {
            isize sent = 0;
            while (sent < b.length()) {
                Result<isize, IoError> w = this.engine[0].write(bytes: b.slice(from: sent, count: b.length() - sent));
                match (w) { case Ok(value: n): { sent = sent + n; } case Err(error: e): { sent = b.length(); } };
            }
            this.engine[0].innerRefMut().drain(into: this.toClient);
            return;
        }
        isize i = 0;
        while (i < b.length()) { this.toClient.add(item: b[i]); i = i + 1; }
    }
}

// The NUL-terminated string at `from`.
unsafe fn string cString(const ref DynamicArray<uint8> body, isize from) {
    isize end = from;
    while (end < body.length() && body[end] != 0ui8) { end = end + 1; }
    return textFrom(body: body, from: from).substring(start: 0, end: end - from);
}

unsafe fn string textFrom(const ref DynamicArray<uint8> body, isize from) {
    Result<string, Utf8Error> t = utf8Decode(bytes: body.slice(from: from, count: body.length() - from));
    return match (give t) { case Ok(value: s): give s; case Err(error: e): ""; };
}

// A startup packet's parameter: after the protocol version, name and value pairs, each NUL-terminated.
unsafe fn string startupValue(const ref DynamicArray<uint8> body, const ref string name) {
    isize at = 4;
    while (at < body.length() && body[at] != 0ui8) {
        string key = cString(body: body, from: at);
        at = at + key.length() + 1;
        string value = cString(body: body, from: at);
        at = at + value.length() + 1;
        if (key.equals(other: name)) { return value; }
    }
    return "";
}

fn string attribute(const ref string message, const ref string name) {
    string prefix = name.concat(other: "=");
    foreach (string part in message.split(separator: ",")) {
        if (part.startsWith(prefix: prefix)) { return part.substring(start: prefix.length(), end: part.length()); }
    }
    return "";
}
