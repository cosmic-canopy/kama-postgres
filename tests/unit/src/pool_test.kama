// postgres::pool against scripted servers: each connection the pool makes runs the next script (ScriptConnector), so
// every message a release sends is checked, and a connection the pool should have closed is seen to be replaced by a
// new one. The bound, waiters woken from another isolate, a timeout, what release closes, resets and rolls back, the
// settings it puts back, lifetimes and their spread, a transaction window on a lease, the maintenance, the bound under
// churn from four isolates, and the options a pool refuses.
//
// A script's steps are the conversation that connection must have. A message the script does not expect is answered
// FATAL, and the pool then replaces the connection, so "it connected once" and "the sentinel ran" together say that
// nothing else was sent.
import { std::collections::DynamicArray, std::concurrent::Channel, std::concurrent::Sender, std::concurrent::Receiver,
         std::concurrent::RecvError, std::concurrent::Isolate, std::concurrent::cpuCount, std::io::IoError,
         std::io::IoErrorKind, std::fmt::parse, std::fmt::ParseError, std::memory::Owned, std::time::Duration, std::time::Instant, std::time::monotonicNow,
         std::time::sleep,
         postgres::Connection, postgres::Config, postgres::Environment, postgres::PgError, postgres::Rows, postgres::Query,
         postgres::Transport, postgres::TransactionStatus, postgres::PipelineStatus, postgres::CacheMode,
         postgres::CopyInfo, postgres::NoticeHandler, postgres::ServerError,
         postgres::pool::Pool, postgres::pool::PoolOptions, postgres::pool::PoolShare, postgres::pool::Lease,
         postgres::pool::Connector,
         postgres_unit_tests::check, postgres_unit_tests::testEnvironment, postgres_unit_tests::resolveWith,
         postgres_unit_tests::FakeServer, postgres_unit_tests::Step, postgres_unit_tests::Wire,
         postgres_unit_tests::resetDiscardAll, postgres_unit_tests::opening, postgres_unit_tests::openingAt,
         postgres_unit_tests::queried, postgres_unit_tests::completes, postgres_unit_tests::resets,
         postgres_unit_tests::sentinel, postgres_unit_tests::quiet, postgres_unit_tests::answer,
         postgres_unit_tests::description, postgres_unit_tests::ints };
export { poolTests };

comptime uint8 IDLE = 73ui8;     // 'I'
comptime uint8 INTX = 84ui8;     // 'T'
comptime uint8 PARSE = 80ui8;    // 'P'
comptime uint8 BIND = 66ui8;     // 'B'
comptime uint8 DESCRIBE = 68ui8; // 'D'
comptime uint8 EXECUTE = 69ui8;  // 'E'
comptime uint8 SYNC = 83ui8;     // 'S'

// ---- the connector ----

// One connection's script, with its end of the test's log: "connect", then every message the client sends after its
// startup, as PQtrace prints it ("F\t16\tQuery\t…"). `pings`: the server answers a ping whenever it comes.
type enum Scripted implements Sendable { One(DynamicArray<Step> steps, Sender<string> log, bool pings) }

// The scripts in order, each with its own end of `log`, queued for the connectors that share them.
unsafe fn Channel<Scripted> queued(DynamicArray<DynamicArray<Step>> scripts, ref Channel<string> log, bool pings) {
    isize room = scripts.length();
    if (room < 1) { room = 1; }
    Channel<Scripted> q = Channel.bounded(capacity: cast<usize>(room));
    Sender<Scripted> into = q.sender();
    while (scripts.length() > 0) {
        DynamicArray<Step> s = scripts.remove(index: 0);
        _ = into.send(item: Scripted::One(steps: give s, log: log.sender(), pings: pings));
    }
    return q;
}

// Opens each of the pool's connections over the next script, through a FakeServer, which reports to the test's log.
// With no script left a connect is refused. A fork draws on the same scripts, so a pool's maintenance and a pool
// joined in another isolate connect over them too; a fork's fork opens nothing.
type resource ScriptConnector implements Connector, Sendable {
    DynamicArray<Channel<Scripted>> queue;   // zero or one: the scripts, kept by the connector a test made, for its forks
    DynamicArray<Receiver<Scripted>> left;   // zero or one: this connector's end of them

    public ctor make(DynamicArray<DynamicArray<Step>> scripts, Channel<string> channel) {
        Channel<Scripted> q = queued(scripts: give scripts, log: ref channel, pings: false);
        this.left = DynamicArray.empty();
        this.left.add(item: q.receiver());
        this.queue = DynamicArray.empty();
        this.queue.add(item: give q);
    }
    // `make`, each server answering pings whenever they come: for a pool whose maintenance pings when it will.
    public ctor pinging(DynamicArray<DynamicArray<Step>> scripts, Channel<string> channel) {
        Channel<Scripted> q = queued(scripts: give scripts, log: ref channel, pings: true);
        this.left = DynamicArray.empty();
        this.left.add(item: q.receiver());
        this.queue = DynamicArray.empty();
        this.queue.add(item: give q);
    }
    ctor sharing(Receiver<Scripted> scripts) {
        this.queue = DynamicArray.empty();
        this.left = DynamicArray.empty();
        this.left.add(item: give scripts);
    }
    ctor none() { this.queue = DynamicArray.empty(); this.left = DynamicArray.empty(); }

    public unsafe fn Result<Connection, PgError> open(const ref Config config) {
        if (this.left.length() > 0) {
            Result<Scripted, RecvError> r = this.left[0].tryRecv();
            match (give r) {
                case Ok(value: x): {
                    match (give x) {
                        case One(steps: s, log: l, pings: p): {
                            Sender<string> tells = give l;
                            _ = tells.send(item: "connect");
                            if (p) {
                                Owned<Transport> answering = new FakeServer.pinged(steps: give s, chunk: 1, writeLimit: 3, tracer: give tells);
                                return Connection.connectOver(transport: give answering, config: config);
                            }
                            Owned<Transport> fake = new FakeServer.traced(steps: give s, chunk: 1, writeLimit: 3, tracer: give tells);
                            return Connection.connectOver(transport: give fake, config: config);
                        }
                    };
                }
                case _: { }
            };
        }
        return Result::Err(error: PgError::Io(error: IoError.of(kind: IoErrorKind::ConnectionRefused)));
    }

    public fn Owned<Connector> fork() {
        if (this.queue.length() == 0) {
            Owned<Connector> none = new ScriptConnector.none();
            return give none;
        }
        Owned<Connector> next = new ScriptConnector.sharing(scripts: this.queue[0].receiver());
        return give next;
    }
}

// Everything `log` was told since it was last read.
fn DynamicArray<string> drained(ref Receiver<string> log) {
    DynamicArray<string> lines = DynamicArray.empty();
    bool more = true;
    while (more) {
        Result<string, RecvError> r = log.tryRecv();
        match (give r) { case Ok(value: line): { lines.add(item: give line); } case _: { more = false; } };
    }
    return lines;
}

// How many connects `lines` report.
fn isize connectsIn(const ref DynamicArray<string> lines) {
    isize n = 0;
    foreach (string line in lines) { if (line.equals(other: "connect")) { n = n + 1; } }
    return n;
}

// How many connects `log` reported since it was last read.
fn isize connects(ref Receiver<string> log) {
    DynamicArray<string> lines = drained(log: ref log);
    return connectsIn(lines: lines);
}

// Whether the first connection in `lines` sent a message with `what` in it.
fn bool firstSays(const ref DynamicArray<string> lines, const ref string what) {
    isize seen = 0;
    foreach (string line in lines) {
        if (line.equals(other: "connect")) { seen = seen + 1; }
        else if (seen == 1 && line.contains(substring: what)) { return true; }
    }
    return false;
}

// A pool over `scripts`, with no statement cache (so each reset is DISCARD ALL), reporting its connects on `log`.
unsafe fn Result<Pool, PgError> poolOver(DynamicArray<DynamicArray<Step>> scripts, PoolOptions options, Channel<string> log) {
    return poolOverInfo(conninfo: "", scripts: give scripts, options: options, log: give log);
}

// `poolOver`, its Config resolved from `conninfo`.
unsafe fn Result<Pool, PgError> poolOverInfo(const ref string conninfo, DynamicArray<DynamicArray<Step>> scripts, PoolOptions options, Channel<string> log) {
    Environment env = testEnvironment();
    Result<Config, PgError> c = resolveWith(text: conninfo, env: env);
    Config config = match (give c) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
    config.setStatementCache(mode: CacheMode::Off, capacity: 0);
    Owned<Connector> connector = new ScriptConnector.make(scripts: give scripts, channel: give log);
    return Pool.makeWith(connector: give connector, config: config, options: options);
}

fn DynamicArray<DynamicArray<Step>> scriptsOf(DynamicArray<Step> a) {
    DynamicArray<DynamicArray<Step>> all = DynamicArray.empty();
    all.add(item: give a);
    return all;
}

fn DynamicArray<DynamicArray<Step>> twoScripts(DynamicArray<Step> a, DynamicArray<Step> b) {
    DynamicArray<DynamicArray<Step>> all = DynamicArray.empty();
    all.add(item: give a);
    all.add(item: give b);
    return all;
}

// The options the tests start from: `size` connections, a short wait, no lifetime.
fn PoolOptions sized(isize size) {
    PoolOptions o = PoolOptions.defaults();
    o.maxSize = size;
    o.acquireTimeout = Duration.fromMillis(ms: 200i64);
    o.lifetime = Optional::None;
    o.lifetimeJitter = Duration.zero();
    return o;
}

fn string said(const ref Result<Lease, PgError> r) { return match (r) { case Ok(value: l): "ok"; case Err(error: e): e.message(); }; }

// SELECT 1 runs on `c`, which stays open.
unsafe fn bool selectsOne(ref Connection c) {
    Result<DynamicArray<Rows>, PgError> r = c.simpleQuery(sql: "SELECT 1");
    bool ran = match (r) { case Ok(value: rows): true; case Err(error: e): false; };
    return ran && !c.isClosed();
}

// A script that opens, and whose connection then answers the sentinel.
unsafe fn DynamicArray<Step> answersSentinel() {
    DynamicArray<Step> s = opening();
    s.add(item: sentinel());
    return s;
}

// ---- the bound ----

unsafe fn int32 sequentialKeepsOne() {
    DynamicArray<Step> s = opening();
    isize i = 0;
    while (i < 3) { s.add(item: sentinel()); s.add(item: resets(sql: resetDiscardAll())); i = i + 1; }
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    Result<Pool, PgError> made = poolOver(scripts: scriptsOf(a: give s), options: sized(size: 4), log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, sequential"); } };
    bool ran = true;
    i = 0;
    while (i < 3) {
        Result<Lease, PgError> a = pool.acquire();
        match (give a) {
            case Ok(value: lease): { Lease l = give lease; ran = ran && selectsOne(c: l.conn()); }
            case Err(error: e): { ran = false; }
        };
        i = i + 1;
    }
    isize n = connects(log: ref log);
    return check(ok: ran && n == 1, what: "pool: one lease at a time keeps using one connection, reset after each (connects ${n})");
}

unsafe fn int32 boundedAndTimesOut() {
    int32 f = 0;
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    Result<Pool, PgError> made = poolOver(scripts: twoScripts(a: opening(), b: opening()), options: sized(size: 2), log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, bounded"); } };
    Result<Lease, PgError> a = pool.acquire();
    Result<Lease, PgError> b = pool.acquire();
    Instant start = monotonicNow();
    Result<Lease, PgError> c = pool.acquire();
    int64 waited = start.elapsed().asMillis();
    string first = said(r: a);
    string second = said(r: b);
    string third = said(r: c);
    bool timedOut = match (c) { case Ok(value: l): false; case Err(error: e): match (e) { case PoolTimeout: true; case _: false; }; };
    isize n = connects(log: ref log);
    f = f + check(ok: first.equals(other: "ok") && second.equals(other: "ok") && n == 2,
                  what: "pool: maxSize connections are made (connects ${n}: ${first}, ${second})");
    f = f + check(ok: timedOut && third.equals(other: "pool timed out while waiting for an open connection") && waited >= 190i64 && waited < 5000i64,
                  what: "pool: one more waits acquireTimeout, then PoolTimeout (${third}, waited ${waited} ms)");
    return f;
}

// ---- a waiter in another isolate ----

type resource Waiter implements Sendable {
    PoolShare share;
    Sender<string> report;
    public ctor make(PoolShare share, Sender<string> report) { this.share = give share; this.report = give report; }
    public unsafe fn void run() {
        Pool pool = Pool.join(share: this.share);
        Instant start = monotonicNow();
        Result<Lease, PgError> got = pool.acquire();
        int64 waited = start.elapsed().asMillis();
        string outcome = said(r: got);
        match (give got) {
            case Ok(value: lease): {
                Lease l = give lease;
                if (!selectsOne(c: l.conn())) { outcome = "SELECT 1 failed"; }
            }
            case Err(error: e): { }
        };
        _ = this.report.send(item: give outcome);
        _ = this.report.send(item: "${waited}");
    }
}

fn void waitInIsolate(Waiter job) { job.run(); }

unsafe fn int32 waiterWokenAcrossIsolates() {
    DynamicArray<Step> s = opening();
    s.add(item: resets(sql: resetDiscardAll()));   // this isolate's release
    s.add(item: sentinel());                        // the waiter's query
    s.add(item: resets(sql: resetDiscardAll()));   // the waiter's release
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    PoolOptions o = sized(size: 1);
    o.acquireTimeout = Duration.fromSecs(s: 10i64);
    Result<Pool, PgError> made = poolOver(scripts: scriptsOf(a: give s), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, waiter"); } };
    Channel<string> results = Channel.bounded(capacity: 4);
    Receiver<string> rx = results.receiver();
    {
        Result<Lease, PgError> a = pool.acquire();
        Lease held = match (give a) { case Ok(value: l): give l; case Err(error: e): { return check(ok: false, what: "pool: acquire, waiter"); } };
        Result<PoolShare, PgError> sh = pool.share();
        PoolShare share = match (give sh) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "pool: share, waiter"); } };
        Waiter job = Waiter.make(share: give share, report: results.sender());
        Isolate worker = spawn waitInIsolate(job: give job);
        sleep(d: Duration.fromMillis(ms: 300i64));
        Lease released = give held;
    }
    Optional<string> outcome = rx.recv();
    Optional<string> took = rx.recv();
    string got = match (outcome) { case Some(value: v): copy v; case None: "(no report)"; };
    string waited = match (took) { case Some(value: v): copy v; case None: "0"; };
    Result<int64, ParseError> ms = parse::<int64>(s: waited);
    bool waitedLong = match (ms) { case Ok(value: v): v >= 150i64; case Err(error: e): false; };
    isize n = connects(log: ref log);
    return check(ok: got.equals(other: "ok") && waitedLong && n == 1,
                 what: "pool: a waiter in another isolate gets the connection released, with no new connect (${got}, waited ${waited} ms, connects ${n})");
}

// The place a connection closed under its lease gives back wakes a waiter in another isolate, which connects on it
// through its own pool's connector: freed capacity goes into `slots`, where waiters wait, never back to `permits`.
unsafe fn int32 waiterWokenByFreedPlace() {
    DynamicArray<Step> second = answersSentinel();               // the waiter's connection, and its query
    second.add(item: resets(sql: resetDiscardAll()));            // the waiter's release
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    PoolOptions o = sized(size: 1);
    o.acquireTimeout = Duration.fromSecs(s: 10i64);
    Result<Pool, PgError> made = poolOver(scripts: twoScripts(a: opening(), b: give second), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, freed place"); } };
    Channel<string> results = Channel.bounded(capacity: 4);
    Receiver<string> rx = results.receiver();
    {
        Result<Lease, PgError> a = pool.acquire();
        Lease held = match (give a) { case Ok(value: l): give l; case Err(error: e): { return check(ok: false, what: "pool: acquire, freed place"); } };
        Result<PoolShare, PgError> sh = pool.share();
        PoolShare share = match (give sh) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "pool: share, freed place"); } };
        Waiter job = Waiter.make(share: give share, report: results.sender());
        Isolate worker = spawn waitInIsolate(job: give job);
        sleep(d: Duration.fromMillis(ms: 300i64));
        held.conn().close();
        Lease released = give held;
    }
    Optional<string> outcome = rx.recv();
    Optional<string> took = rx.recv();
    string got = match (outcome) { case Some(value: v): copy v; case None: "(no report)"; };
    string waited = match (took) { case Some(value: v): copy v; case None: "0"; };
    Result<int64, ParseError> ms = parse::<int64>(s: waited);
    bool waitedLong = match (ms) { case Ok(value: v): v >= 150i64; case Err(error: e): false; };
    isize n = connects(log: ref log);
    return check(ok: got.equals(other: "ok") && waitedLong && n == 2,
                 what: "pool: a waiter in another isolate wakes for a closed connection's place, and connects on it (${got}, waited ${waited} ms, connects ${n})");
}

// ---- what release closes ----

unsafe fn int32 closedIsReplaced() {
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    Result<Pool, PgError> made = poolOver(scripts: twoScripts(a: opening(), b: answersSentinel()), options: sized(size: 1), log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, closed"); } };
    {
        Result<Lease, PgError> a = pool.acquire();
        match (give a) { case Ok(value: lease): { Lease l = give lease; l.conn().close(); } case Err(error: e): { } };
    }
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n = connects(log: ref log);
    return check(ok: ran && n == 2, what: "pool: a connection closed under its lease gives its place back, and the next acquire connects anew (connects ${n})");
}

// A release that must close the connection, with the reset off (with it on, the reset is refused and closes it too):
// the next acquire connects anew and its connection answers the sentinel.
unsafe fn int32 closesBusy(DynamicArray<Step> first, int32 how, const ref string what) {
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    PoolOptions o = sized(size: 1);
    o.reset = false;
    Result<Pool, PgError> made = poolOver(scripts: twoScripts(a: give first, b: answersSentinel()), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, ".concat(other: what)); } };
    bool busy = false;
    {
        Result<Lease, PgError> a = pool.acquire();
        match (give a) {
            case Ok(value: lease): {
                Lease l = give lease;
                if (how == 0) {
                    Query q = Query.make(sql: "select $1 + 1");
                    q.add(value: 7);
                    Result<Unit, PgError> started = l.conn().startRows(q: q);
                    Result<Rows, PgError> chunk = l.conn().nextRows(maxRows: 1);
                    busy = l.conn().transactionStatus() == TransactionStatus::Active;
                } else if (how == 1) {
                    Result<CopyInfo, PgError> started = l.conn().startCopyIn(sql: "COPY t FROM STDIN");
                    busy = l.conn().transactionStatus() == TransactionStatus::Active;
                } else {
                    Result<Unit, PgError> entered = l.conn().enterPipelineMode();
                    busy = l.conn().pipelineStatus() == PipelineStatus::On;
                }
            }
            case Err(error: e): { }
        };
    }
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n = connects(log: ref log);
    return check(ok: busy && ran && n == 2, what: "pool: ".concat(other: what).concat(other: " is closed on release, not kept (connects ${n})"));
}

unsafe fn int32 busyTests() {
    int32 f = 0;
    Wire rows = Wire.make(); rows.bindComplete();
    int32 i = 1;
    while (i <= 3) { rows.intRow(values: ints(a: i)); i = i + 1; }
    rows.complete(tag: "SELECT 3"); rows.ready(status: IDLE);
    DynamicArray<Step> stream = opening();
    stream.add(item: quiet(tag: PARSE, body: ""));
    stream.add(item: quiet(tag: DESCRIBE, body: ""));
    stream.add(item: answer(tag: SYNC, reply: description()));
    stream.add(item: quiet(tag: BIND, body: ""));
    stream.add(item: quiet(tag: EXECUTE, body: ""));
    stream.add(item: answer(tag: SYNC, reply: give rows));
    stream.add(item: completes(sql: "ROLLBACK", tag: "ROLLBACK", status: IDLE));   // what settle() would send, kept or not
    f = f + closesBusy(first: give stream, how: 0, what: "a result still being read");
    Wire g = Wire.make(); g.copyResponse(tag: 71ui8);
    DynamicArray<Step> copying = opening();
    copying.add(item: queried(sql: "COPY t FROM STDIN", reply: give g));
    f = f + closesBusy(first: give copying, how: 1, what: "a COPY in progress");
    f = f + closesBusy(first: opening(), how: 2, what: "a connection in pipeline mode");
    return f;
}

// ---- what release resets ----

unsafe fn int32 blockRolledBackAndReset() {
    DynamicArray<Step> s = opening();
    s.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s.add(item: completes(sql: "ROLLBACK", tag: "ROLLBACK", status: IDLE));
    s.add(item: resets(sql: resetDiscardAll()));
    s.add(item: sentinel());
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    Result<Pool, PgError> made = poolOver(scripts: scriptsOf(a: give s), options: sized(size: 1), log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, block"); } };
    bool inBlock = false;
    {
        Result<Lease, PgError> a = pool.acquire();
        match (give a) {
            case Ok(value: lease): {
                Lease l = give lease;
                Result<DynamicArray<Rows>, PgError> begun = l.conn().simpleQuery(sql: "BEGIN");
                inBlock = l.conn().transactionStatus() == TransactionStatus::InTransaction;
            }
            case Err(error: e): { }
        };
    }
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n = connects(log: ref log);
    return check(ok: inBlock && ran && n == 1,
                 what: "pool: release in a block sends ROLLBACK, then DISCARD ALL, and keeps the connection (connects ${n})");
}

// A transaction window opened on a lease's connection, as the README shows it: BEGIN, a statement through tx.conn(),
// COMMIT, and nothing as the window closes; then release resets, and the connection is kept.
unsafe fn int32 windowOnLease() {
    DynamicArray<Step> s = opening();
    s.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s.add(item: completes(sql: "INSERT INTO t VALUES (1)", tag: "INSERT 0 1", status: INTX));
    s.add(item: completes(sql: "COMMIT", tag: "COMMIT", status: IDLE));
    s.add(item: resets(sql: resetDiscardAll()));
    s.add(item: sentinel());
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    Result<Pool, PgError> made = poolOver(scripts: scriptsOf(a: give s), options: sized(size: 1), log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, window"); } };
    bool inserted = false;
    bool committed = false;
    {
        Result<Lease, PgError> a = pool.acquire();
        match (give a) {
            case Ok(value: lease): {
                Lease l = give lease;
                borrow l.conn().transaction() as tx {
                    Result<DynamicArray<Rows>, PgError> i = tx.conn().simpleQuery(sql: "INSERT INTO t VALUES (1)");
                    inserted = match (i) { case Ok(value: rows): true; case Err(error: e): false; };
                    Result<Unit, PgError> k = tx.commit();
                    committed = match (k) { case Ok(value: u): true; case Err(error: e): false; };
                }
            }
            case Err(error: e): { }
        };
    }
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n = connects(log: ref log);
    return check(ok: inserted && committed && ran && n == 1,
                 what: "pool: a transaction window on a lease commits, then release resets and keeps the connection (connects ${n})");
}

unsafe fn int32 resetOffSendsNothing() {
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    PoolOptions o = sized(size: 1);
    o.reset = false;
    Result<Pool, PgError> made = poolOver(scripts: scriptsOf(a: answersSentinel()), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, reset off"); } };
    { Result<Lease, PgError> a = pool.acquire(); }
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n = connects(log: ref log);
    return check(ok: ran && n == 1, what: "pool: with the reset off, an idle connection is sent nothing on release (connects ${n})");
}

unsafe fn int32 resetOffRollsBack() {
    DynamicArray<Step> s = opening();
    s.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s.add(item: completes(sql: "ROLLBACK", tag: "ROLLBACK", status: IDLE));
    s.add(item: sentinel());
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    PoolOptions o = sized(size: 1);
    o.reset = false;
    Result<Pool, PgError> made = poolOver(scripts: scriptsOf(a: give s), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, reset off, block"); } };
    {
        Result<Lease, PgError> a = pool.acquire();
        match (give a) {
            case Ok(value: lease): { Lease l = give lease; Result<DynamicArray<Rows>, PgError> begun = l.conn().simpleQuery(sql: "BEGIN"); }
            case Err(error: e): { }
        };
    }
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n = connects(log: ref log);
    return check(ok: ran && n == 1, what: "pool: with the reset off, a block is rolled back on release, and nothing else is sent (connects ${n})");
}

unsafe fn int32 resetOffFailedRollbackDropped() {
    Wire refused = Wire.make();
    refused.report(tag: 69ui8, severity: "ERROR", code: "XX000", message: "no rollback today");
    refused.ready(status: INTX);
    DynamicArray<Step> s = opening();
    s.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s.add(item: queried(sql: "ROLLBACK", reply: give refused));
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    PoolOptions o = sized(size: 1);
    o.reset = false;
    Result<Pool, PgError> made = poolOver(scripts: twoScripts(a: give s, b: answersSentinel()), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, reset off, failed rollback"); } };
    {
        Result<Lease, PgError> a = pool.acquire();
        match (give a) {
            case Ok(value: lease): { Lease l = give lease; Result<DynamicArray<Rows>, PgError> begun = l.conn().simpleQuery(sql: "BEGIN"); }
            case Err(error: e): { }
        };
    }
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n = connects(log: ref log);
    return check(ok: ran && n == 2, what: "pool: with the reset off, a rollback that fails closes the connection, and its place is given back (connects ${n})");
}

unsafe fn int32 failedResetDropped() {
    int32 f = 0;
    // The server refuses the reset.
    Wire refused = Wire.make();
    refused.report(tag: 69ui8, severity: "ERROR", code: "XX000", message: "no reset today");
    refused.ready(status: IDLE);
    DynamicArray<Step> s = opening();
    s.add(item: queried(sql: resetDiscardAll(), reply: give refused));
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    Result<Pool, PgError> made = poolOver(scripts: twoScripts(a: give s, b: answersSentinel()), options: sized(size: 1), log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, failed reset"); } };
    { Result<Lease, PgError> a = pool.acquire(); }
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n = connects(log: ref log);
    f = f + check(ok: ran && n == 2, what: "pool: a reset the server refuses closes the connection, and its place is given back (connects ${n})");
    // A server that reported no server_version: the reset is refused before anything is sent, and the connection is not
    // kept unreset.
    Channel<string> ch2 = Channel.bounded(capacity: 256);
    Receiver<string> log2 = ch2.receiver();
    Result<Pool, PgError> made2 = poolOver(scripts: twoScripts(a: openingAt(version: ""), b: answersSentinel()), options: sized(size: 1), log: give ch2);
    Pool pool2 = match (give made2) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, no server_version"); } };
    { Result<Lease, PgError> a = pool2.acquire(); }
    Result<Lease, PgError> c = pool2.acquire();
    bool ran2 = match (give c) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n2 = connects(log: ref log2);
    f = f + check(ok: ran2 && n2 == 2, what: "pool: a reset refused for want of server_version closes the connection (connects ${n2})");
    return f;
}

// ---- connects that fail ----

unsafe fn int32 failedConnectGivesBack() {
    Wire w = Wire.make();
    w.report(tag: 69ui8, severity: "FATAL", code: "53300", message: "sorry, too many clients already");
    DynamicArray<Step> refused = DynamicArray.empty();
    refused.add(item: Step::Send(bytes: w.bytes()));
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    Result<Pool, PgError> made = poolOver(scripts: twoScripts(a: give refused, b: answersSentinel()), options: sized(size: 1), log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, failed connect"); } };
    Result<Lease, PgError> a = pool.acquire();
    string first = said(r: a);
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n = connects(log: ref log);
    return check(ok: first.contains(substring: "sorry, too many clients already") && ran && n == 2,
                 what: "pool: a connect that fails is acquire's error, and its place is given back (".concat(other: first).concat(other: ", connects ${n})"));
}

// ---- lifetimes ----

unsafe fn int32 lifetimeTests() {
    int32 f = 0;
    // Past its lifetime when released: closed, not reset. The script would answer a reset, so one sent would be seen.
    DynamicArray<Step> first = opening();
    first.add(item: resets(sql: resetDiscardAll()));
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    PoolOptions o = sized(size: 1);
    o.lifetime = Optional::Some(value: Duration.fromMillis(ms: 50i64));
    Result<Pool, PgError> made = poolOver(scripts: twoScripts(a: give first, b: answersSentinel()), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, lifetime"); } };
    {
        Result<Lease, PgError> a = pool.acquire();
        sleep(d: Duration.fromMillis(ms: 100i64));
    }
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    DynamicArray<string> told = drained(log: ref log);
    bool reset = firstSays(lines: told, what: "DISCARD ALL");
    isize n = connectsIn(lines: told);
    f = f + check(ok: ran && n == 2 && !reset, what: "pool: a connection past its lifetime is closed on release, not reset (connects ${n})");
    // Past it while idle: closed when next acquired.
    DynamicArray<Step> s = opening();
    s.add(item: resets(sql: resetDiscardAll()));
    Channel<string> ch2 = Channel.bounded(capacity: 256);
    Receiver<string> log2 = ch2.receiver();
    Result<Pool, PgError> made2 = poolOver(scripts: twoScripts(a: give s, b: answersSentinel()), options: o, log: give ch2);
    Pool pool2 = match (give made2) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, idle lifetime"); } };
    { Result<Lease, PgError> a = pool2.acquire(); }
    sleep(d: Duration.fromMillis(ms: 100i64));
    Result<Lease, PgError> c = pool2.acquire();
    bool ran2 = match (give c) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n2 = connects(log: ref log2);
    f = f + check(ok: ran2 && n2 == 2, what: "pool: an idle connection past its lifetime is closed when acquired, and a new one made (connects ${n2})");
    return f;
}

// ---- what release puts back ----

// Counts the notices it is given.
type resource Counting implements NoticeHandler, Sendable {
    Sender<string> seen;
    public ctor make(Sender<string> seen) { this.seen = give seen; }
    public fn void notice(const ref ServerError notice) { _ = this.seen.send(item: notice.primary()); }
}

unsafe fn int32 settingsPutBack() {
    int32 f = 0;
    Wire noticed = Wire.make();
    noticed.columns(names: columnNamed(a: "x"));
    noticed.report(tag: 78ui8, severity: "NOTICE", code: "00000", message: "for whoever listens");
    noticed.complete(tag: "SELECT 0");
    noticed.ready(status: IDLE);
    DynamicArray<Step> s = opening();
    s.add(item: resets(sql: resetDiscardAll()));
    s.add(item: queried(sql: "SELECT 1", reply: give noticed));
    s.add(item: resets(sql: resetDiscardAll()));
    Channel<string> ch = Channel.bounded(capacity: 256);
    Receiver<string> log = ch.receiver();
    PoolOptions o = sized(size: 1);
    o.queryTimeout = Optional::Some(value: Duration.fromSecs(s: 5i64));
    Result<Pool, PgError> made = poolOver(scripts: scriptsOf(a: give s), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, settings"); } };
    Channel<string> notices = Channel.bounded(capacity: 8);
    Receiver<string> heard = notices.receiver();
    int64 firstMs = -1;
    {
        Result<Lease, PgError> a = pool.acquire();
        match (give a) {
            case Ok(value: lease): {
                Lease l = give lease;
                firstMs = msOf(t: l.conn().queryTimeout());
                l.conn().setQueryTimeout(timeout: Optional::Some(value: Duration.fromMillis(ms: 1i64)), grace: Duration.fromMillis(ms: 1i64));
                Owned<NoticeHandler> h = new Counting.make(seen: notices.sender());
                l.conn().setNoticeHandler(handler: give h);
            }
            case Err(error: e): { }
        };
    }
    int64 againMs = -1;
    bool ran = false;
    {
        Result<Lease, PgError> b = pool.acquire();
        match (give b) {
            case Ok(value: lease): {
                Lease l = give lease;
                againMs = msOf(t: l.conn().queryTimeout());
                Result<DynamicArray<Rows>, PgError> r = l.conn().simpleQuery(sql: "SELECT 1");
                ran = match (r) { case Ok(value: rows): true; case Err(error: e): false; };
            }
            case Err(error: e): { }
        };
    }
    Result<string, RecvError> got = heard.tryRecv();
    bool handled = match (got) { case Ok(value: m): true; case _: false; };
    f = f + check(ok: firstMs == 5000i64 && againMs == 5000i64,
                  what: "pool: each connection has the pool's query timeout, put back on release (${firstMs}, then ${againMs} ms)");
    f = f + check(ok: ran && !handled, what: "pool: a notice handler set through a lease is cleared on release");
    return f;
}

fn int64 msOf(Optional<Duration> t) { return match (t) { case Some(value: d): d.asMillis(); case None: -1i64; }; }

fn DynamicArray<string> columnNamed(const ref string a) { DynamicArray<string> v = DynamicArray.empty(); v.add(item: copy a); return v; }

// ---- maintenance ----

// How a ping and a close look in the log.
fn string pingLine() { return "Query\t \"\""; }
fn string closeLine() { return "Terminate"; }

// Options for the maintenance's cases: `size` connections, minIdle `least`, a round every 100 ms, no pruning, release
// sending nothing, and time to acquire while the maintenance connects.
fn PoolOptions keeping(isize size, isize least) {
    PoolOptions o = sized(size: size);
    o.minIdle = least;
    o.healthCheck = Duration.fromMillis(ms: 100i64);
    o.idleTimeout = Optional::None;
    o.acquireTimeout = Duration.fromSecs(s: 2i64);
    o.reset = false;
    return o;
}

// `poolOver`, each server answering pings whenever they come.
unsafe fn Result<Pool, PgError> keptPool(DynamicArray<DynamicArray<Step>> scripts, PoolOptions options, Channel<string> log) {
    Environment env = testEnvironment();
    string none = "";
    Result<Config, PgError> c = resolveWith(text: none, env: env);
    Config config = match (give c) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
    config.setStatementCache(mode: CacheMode::Off, capacity: 0);
    Owned<Connector> connector = new ScriptConnector.pinging(scripts: give scripts, channel: give log);
    return Pool.makeWith(connector: give connector, config: config, options: options);
}

// `n` scripts that open and say nothing more.
fn DynamicArray<DynamicArray<Step>> openings(isize n) {
    DynamicArray<DynamicArray<Step>> all = DynamicArray.empty();
    isize i = 0;
    while (i < n) { all.add(item: opening()); i = i + 1; }
    return all;
}

// A script whose server hangs up right after the connection opens: a connection dropped while it sits idle.
fn DynamicArray<Step> dropped() {
    DynamicArray<Step> s = opening();
    s.add(item: Step::Hangup);
    return s;
}

// Read `log` until `n` lines with `what` in them have come, or `within` passes: every line read.
unsafe fn DynamicArray<string> awaitLines(ref Receiver<string> log, const ref string what, isize n, Duration within) {
    DynamicArray<string> lines = DynamicArray.empty();
    Instant until = monotonicNow() + within;
    isize seen = 0;
    bool waiting = true;
    while (waiting && seen < n) {
        Instant now = monotonicNow();
        if (now >= until) { waiting = false; }
        else {
            Result<string, RecvError> r = log.recvTimeout(timeout: until.since(earlier: now));
            match (give r) {
                case Ok(value: line): {
                    if (line.contains(substring: what)) { seen = seen + 1; }
                    lines.add(item: give line);
                }
                case _: { waiting = false; }
            };
        }
    }
    return lines;
}

// How many of `lines` have `what` in them, and where the first is (-1 for none).
fn isize countIn(const ref DynamicArray<string> lines, const ref string what) {
    isize n = 0;
    foreach (string line in lines) { if (line.contains(substring: what)) { n = n + 1; } }
    return n;
}
fn isize firstAt(const ref DynamicArray<string> lines, const ref string what) {
    isize i = 0;
    while (i < lines.length()) {
        if (lines[i].contains(substring: what)) { return i; }
        i = i + 1;
    }
    return -1;
}

unsafe fn int32 minIdleAtStart() {
    int32 f = 0;
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = keeping(size: 3, least: 2);
    o.healthCheck = Duration.fromSecs(s: 60i64);   // the connects at the start, and no round
    Result<Pool, PgError> made = keptPool(scripts: openings(n: 3), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, minIdle"); } };
    DynamicArray<string> early = awaitLines(log: ref log, what: "connect", n: 2, within: Duration.fromSecs(s: 5i64));
    sleep(d: Duration.fromMillis(ms: 300i64));
    isize first = countIn(lines: early, what: "connect") + connects(log: ref log);
    Result<Lease, PgError> a = pool.acquire();
    Result<Lease, PgError> b = pool.acquire();
    isize leasing = connects(log: ref log);
    Result<Lease, PgError> c = pool.acquire();
    isize third = connects(log: ref log);
    bool leased = said(r: a).equals(other: "ok") && said(r: b).equals(other: "ok") && said(r: c).equals(other: "ok");
    f = f + check(ok: first == 2, what: "maintenance: minIdle (2) connections are made at once, before any acquire (connects ${first})");
    f = f + check(ok: leased && leasing == 0 && third == 1,
                  what: "maintenance: the minIdle connections are leased with no connect, and one more connects (${leasing}, then ${third})");
    return f;
}

unsafe fn int32 refilledAfterLoss() {
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    Result<Pool, PgError> made = keptPool(scripts: twoScripts(a: opening(), b: answersSentinel()), options: keeping(size: 1, least: 1), log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, refill"); } };
    {
        Result<Lease, PgError> a = pool.acquire();
        match (give a) { case Ok(value: lease): { Lease l = give lease; l.conn().close(); } case Err(error: e): { } };
    }
    DynamicArray<string> lines = awaitLines(log: ref log, what: "connect", n: 2, within: Duration.fromSecs(s: 5i64));
    isize n = countIn(lines: lines, what: "connect");
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize more = connects(log: ref log);
    return check(ok: n == 2 && ran && more == 0,
                 what: "maintenance: a connection closed under its lease is replaced by the maintenance, with no acquire (connects ${n}, then ${more})");
}

unsafe fn int32 pruningTests() {
    int32 f = 0;
    // The connections the pool has not needed for idleTimeout are closed, once it has watched that long.
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = keeping(size: 2, least: 0);
    o.idleTimeout = Optional::Some(value: Duration.fromSecs(s: 1i64));
    Result<Pool, PgError> made = keptPool(scripts: openings(n: 2), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, pruning"); } };
    {
        Result<Lease, PgError> a = pool.acquire();
        Result<Lease, PgError> b = pool.acquire();
    }
    DynamicArray<string> early = awaitLines(log: ref log, what: closeLine(), n: 1, within: Duration.fromMillis(ms: 600i64));
    DynamicArray<string> later = awaitLines(log: ref log, what: closeLine(), n: 2, within: Duration.fromSecs(s: 3i64));
    isize before = countIn(lines: early, what: closeLine());
    isize closed = countIn(lines: later, what: closeLine());
    f = f + check(ok: before == 0 && closed == 2,
                  what: "maintenance: connections not needed for idleTimeout are closed once it has passed, and not before (${before}, then ${closed})");

    // Pruning leaves minIdle idle.
    Channel<string> ch2 = Channel.bounded(capacity: 4096);
    Receiver<string> log2 = ch2.receiver();
    PoolOptions o2 = keeping(size: 2, least: 1);
    o2.idleTimeout = Optional::Some(value: Duration.fromSecs(s: 1i64));
    Result<Pool, PgError> made2 = keptPool(scripts: openings(n: 3), options: o2, log: give ch2);
    Pool pool2 = match (give made2) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, pruning floor"); } };
    {
        Result<Lease, PgError> a = pool2.acquire();
        Result<Lease, PgError> b = pool2.acquire();
    }
    DynamicArray<string> one = awaitLines(log: ref log2, what: closeLine(), n: 1, within: Duration.fromSecs(s: 3i64));
    DynamicArray<string> more = awaitLines(log: ref log2, what: closeLine(), n: 1, within: Duration.fromMillis(ms: 1500i64));
    isize first = countIn(lines: one, what: closeLine());
    isize second = countIn(lines: more, what: closeLine());
    isize made3 = connectsIn(lines: one) + connectsIn(lines: more);
    Result<Lease, PgError> c = pool2.acquire();
    isize again = connects(log: ref log2);
    f = f + check(ok: first == 1 && second == 0 && said(r: c).equals(other: "ok") && again == 0 && made3 == 2,
                  what: "maintenance: pruning leaves minIdle (1) connections idle, and the next acquire takes one (closed ${first}, then ${second}; connects ${again})");

    // A pool that grew in a burst is pruned to what a trickle of traffic uses, and the trickle then connects again at
    // most once. The connections are leased in turn, so neither is idle for long: an idle time per connection would
    // close none. A sweep counts the idle connections by taking them, so an acquire that lands between two of its takes
    // can find only an Empty and connect, as an acquire beside pgxpool's health check can. That is the one connect
    // allowed: measured, 2 runs in 100 make it, none makes two. A FIFO channel undoing every prune (no `idleWaiting`)
    // connects after each one, 3 times in every run. The spare scripts let the race's connect succeed.
    Channel<string> ch3 = Channel.bounded(capacity: 4096);
    Receiver<string> log3 = ch3.receiver();
    PoolOptions o3 = keeping(size: 2, least: 0);
    o3.idleTimeout = Optional::Some(value: Duration.fromMillis(ms: 600i64));
    Result<Pool, PgError> made4 = keptPool(scripts: openings(n: 5), options: o3, log: give ch3);
    Pool pool3 = match (give made4) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, trickle"); } };
    {
        Result<Lease, PgError> a = pool3.acquire();
        Result<Lease, PgError> b = pool3.acquire();
    }
    isize grown = connects(log: ref log3);
    Instant began = monotonicNow();
    isize refused = 0;
    while (began.elapsed() < Duration.fromMillis(ms: 2500i64)) {
        Result<Lease, PgError> l = pool3.acquire();
        bool got = match (l) { case Ok(value: x): true; case Err(error: e): false; };
        if (!got) { refused = refused + 1; }
        sleep(d: Duration.fromMillis(ms: 40i64));
    }
    DynamicArray<string> lines = drained(log: ref log3);
    isize closed3 = countIn(lines: lines, what: closeLine());
    isize dialed = connectsIn(lines: lines);
    f = f + check(ok: grown == 2 && refused == 0 && closed3 >= 1 && dialed <= 1,
                  what: "maintenance: a pool that grew in a burst is pruned to what a trickle uses, which then connects at most once (closed ${closed3}, connects ${dialed}, refused ${refused})");
    return f;
}

unsafe fn int32 lifetimeKept() {
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = keeping(size: 1, least: 0);
    o.lifetime = Optional::Some(value: Duration.fromMillis(ms: 300i64));
    Result<Pool, PgError> made = keptPool(scripts: openings(n: 1), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, lifetime"); } };
    { Result<Lease, PgError> a = pool.acquire(); }
    DynamicArray<string> lines = awaitLines(log: ref log, what: closeLine(), n: 1, within: Duration.fromSecs(s: 3i64));
    isize closed = countIn(lines: lines, what: closeLine());
    return check(ok: closed == 1, what: "maintenance: an idle connection past its lifetime is closed by the maintenance, with no acquire (closed ${closed})");
}

unsafe fn int32 keeperPings() {
    int32 f = 0;
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    Result<Pool, PgError> made = keptPool(scripts: openings(n: 1), options: keeping(size: 1, least: 0), log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, pings"); } };
    { Result<Lease, PgError> a = pool.acquire(); }
    DynamicArray<string> hush = awaitLines(log: ref log, what: pingLine(), n: 1, within: Duration.fromMillis(ms: 700i64));
    DynamicArray<string> first = awaitLines(log: ref log, what: pingLine(), n: 1, within: Duration.fromSecs(s: 2i64));
    DynamicArray<string> after = awaitLines(log: ref log, what: pingLine(), n: 1, within: Duration.fromMillis(ms: 600i64));
    isize early = countIn(lines: hush, what: pingLine());
    isize pinged = countIn(lines: first, what: pingLine());
    isize again = countIn(lines: after, what: pingLine());
    f = f + check(ok: early == 0, what: "maintenance: a connection known to be alive less than a second ago is not pinged (${early})");
    f = f + check(ok: pinged == 1 && again == 0,
                  what: "maintenance: an idle connection is pinged once it has sat idle a second, and not again in the second after (${pinged}, then ${again})");

    // Every stale connection in the round that finds them: with a round every 700 ms, both idle connections are pinged
    // in the round at about 1.4 s, not one of them a round later at 2.1 s.
    Channel<string> ch2 = Channel.bounded(capacity: 4096);
    Receiver<string> log2 = ch2.receiver();
    PoolOptions o = keeping(size: 2, least: 0);
    o.healthCheck = Duration.fromMillis(ms: 700i64);
    Instant start = monotonicNow();
    Result<Pool, PgError> made2 = keptPool(scripts: openings(n: 2), options: o, log: give ch2);
    Pool pool2 = match (give made2) { case Ok(value: p): give p; case Err(error: e): { return f + check(ok: false, what: "maintenance: make, pings in one round"); } };
    {
        Result<Lease, PgError> a = pool2.acquire();
        Result<Lease, PgError> b = pool2.acquire();
    }
    sleepUntil(from: start, ms: 1750i64);
    DynamicArray<string> lines = drained(log: ref log2);
    isize both = countIn(lines: lines, what: pingLine());
    f = f + check(ok: both == 2, what: "maintenance: a round pings every idle connection not known to be alive for a second (${both} by 1.75 s)");
    return f;
}

unsafe fn int32 droppedFoundByKeeper() {
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    Result<Pool, PgError> made = keptPool(scripts: twoScripts(a: dropped(), b: answersSentinel()), options: keeping(size: 1, least: 1), log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, dropped"); } };
    DynamicArray<string> lines = awaitLines(log: ref log, what: "connect", n: 2, within: Duration.fromSecs(s: 5i64));
    isize n = countIn(lines: lines, what: "connect");
    Result<Lease, PgError> b = pool.acquire();
    bool ran = match (give b) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize more = connects(log: ref log);
    int32 f = check(ok: n == 2 && ran && more == 0,
                    what: "maintenance: a connection its server dropped is found by the maintenance's ping, and replaced (connects ${n}, then ${more})");

    // In the round that finds it: with a round every 700 ms, the ping at about 1.4 s finds it, and the connect follows
    // at once, not a round later at 2.1 s.
    Channel<string> ch2 = Channel.bounded(capacity: 4096);
    Receiver<string> log2 = ch2.receiver();
    PoolOptions o = keeping(size: 1, least: 1);
    o.healthCheck = Duration.fromMillis(ms: 700i64);
    Instant start = monotonicNow();
    Result<Pool, PgError> made2 = keptPool(scripts: twoScripts(a: dropped(), b: opening()), options: o, log: give ch2);
    Pool pool2 = match (give made2) { case Ok(value: p): give p; case Err(error: e): { return f + check(ok: false, what: "maintenance: make, dropped, same round"); } };
    sleepUntil(from: start, ms: 1750i64);
    DynamicArray<string> lines2 = drained(log: ref log2);
    isize n2 = connectsIn(lines: lines2);
    f = f + check(ok: n2 == 2, what: "maintenance: a connection that fails its ping is replaced in the round that found it (connects ${n2} by 1.75 s)");
    return f;
}

unsafe fn int32 acquirePings() {
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    int32 f = 0;
    PoolOptions o = keeping(size: 1, least: 0);
    o.healthCheck = Duration.fromSecs(s: 60i64);
    o.queryTimeout = Optional::Some(value: Duration.fromSecs(s: 7i64));
    Result<Pool, PgError> made = keptPool(scripts: scriptsOf(a: answersSentinel()), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, acquire's ping"); } };
    { Result<Lease, PgError> a = pool.acquire(); }
    sleep(d: Duration.fromMillis(ms: 1100i64));
    Result<Lease, PgError> b = pool.acquire();
    int64 limit = -1;
    bool ran = false;
    match (give b) {
        case Ok(value: lease): { Lease l = give lease; limit = msOf(t: l.conn().queryTimeout()); ran = selectsOne(c: l.conn()); }
        case Err(error: e): { }
    };
    DynamicArray<string> lines = drained(log: ref log);
    isize pingAt = firstAt(lines: lines, what: pingLine());
    isize selectAt = firstAt(lines: lines, what: "SELECT 1");
    f = f + check(ok: ran && pingAt >= 0 && pingAt < selectAt,
                  what: "pool: acquire pings a connection idle for more than a second before it is leased (ping at ${pingAt}, SELECT 1 at ${selectAt})");
    f = f + check(ok: limit == 7000i64, what: "pool: after acquire's ping the connection has the pool's query timeout again (${limit} ms)");
    return f;
}

unsafe fn int32 failedPingPassedOver() {
    int32 f = 0;
    // Two idle connections, the first dropped by its server: acquire takes the second, with no connect.
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = keeping(size: 2, least: 0);
    o.healthCheck = Duration.fromSecs(s: 60i64);
    DynamicArray<DynamicArray<Step>> three = twoScripts(a: dropped(), b: answersSentinel());
    three.add(item: opening());
    Result<Pool, PgError> made = keptPool(scripts: give three, options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, failed ping"); } };
    Result<Lease, PgError> a = pool.acquire();
    Result<Lease, PgError> b = pool.acquire();
    { Result<Lease, PgError> first = give a; }    // the dropped one goes back first, and is first in line
    { Result<Lease, PgError> second = give b; }
    sleep(d: Duration.fromMillis(ms: 1100i64));
    Result<Lease, PgError> c = pool.acquire();
    bool ran = false;
    isize n = 0;
    string another = "";
    match (give c) {
        case Ok(value: lease): {
            Lease held = give lease;
            ran = selectsOne(c: held.conn());
            n = connects(log: ref log);
            Result<Lease, PgError> extra = pool.acquire();   // on the place the closed one left
            another = said(r: extra);
        }
        case Err(error: e): { }
    };
    f = f + check(ok: ran && n == 2, what: "pool: a connection that does not answer acquire's ping is passed over for the next idle one (connects ${n})");
    f = f + check(ok: another.equals(other: "ok"), what: "pool: the place of a connection acquire passed over stays the pool's (".concat(other: another).concat(other: ")"));

    // The only idle connection does not answer: acquire connects on its place.
    Channel<string> ch2 = Channel.bounded(capacity: 4096);
    Receiver<string> log2 = ch2.receiver();
    Result<Pool, PgError> made2 = keptPool(scripts: twoScripts(a: dropped(), b: answersSentinel()), options: o, log: give ch2);
    Pool pool2 = match (give made2) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, failed ping, none idle"); } };
    { Result<Lease, PgError> x = pool2.acquire(); }
    sleep(d: Duration.fromMillis(ms: 1100i64));
    Result<Lease, PgError> d = pool2.acquire();
    bool ran2 = match (give d) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    isize n2 = connects(log: ref log2);
    f = f + check(ok: ran2 && n2 == 2, what: "pool: with no other idle connection, acquire connects on the place of one that did not answer (connects ${n2})");
    return f;
}

// A script whose server stops answering once the connection is open.
fn DynamicArray<Step> stalling() {
    DynamicArray<Step> s = opening();
    s.add(item: Step::Stall);
    return s;
}

// Two idle connections whose servers have stopped answering: acquire's ping to the first fails after pingTimeout, which
// is past acquireTimeout (200 ms), so acquire connects on its place rather than ping the second too.
unsafe fn int32 pingBounded() {
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = sized(size: 2);
    o.reset = false;
    o.pingTimeout = Duration.fromMillis(ms: 300i64);
    o.queryTimeout = Optional::Some(value: Duration.fromSecs(s: 3i64));   // a ping not bounded by pingTimeout takes this
    DynamicArray<DynamicArray<Step>> three = twoScripts(a: stalling(), b: stalling());
    three.add(item: answersSentinel());
    Result<Pool, PgError> made = poolOver(scripts: give three, options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, ping bound"); } };
    Result<Lease, PgError> a = pool.acquire();
    Result<Lease, PgError> b = pool.acquire();
    { Result<Lease, PgError> first = give a; }
    { Result<Lease, PgError> second = give b; }
    sleep(d: Duration.fromMillis(ms: 1100i64));
    Instant start = monotonicNow();
    Result<Lease, PgError> c = pool.acquire();
    int64 ms = start.elapsed().asMillis();
    bool ran = match (give c) { case Ok(value: lease): { Lease l = give lease; := selectsOne(c: l.conn()); } case Err(error: e): false; };
    return check(ok: ran && ms >= 250i64 && ms < 500i64,
                 what: "pool: a ping is bounded by pingTimeout, and past acquireTimeout acquire connects rather than ping another (${ms} ms)");
}

// Makes a pool as `kind` says, and drops it, reporting how long the drop took:
//   0: a pool with nothing to do, its maintenance waiting a minute for its next round;
//   1: three idle connections whose servers have stopped answering, dropped while the maintenance pings the first;
//   2: minIdle 1 and a server that never answers the startup, dropped while the maintenance connects, which ends
//      within acquireTimeout (1 s) since there is no connect_timeout;
//   3: the same with connect_timeout=1 and acquireTimeout 5 s, which ends within connect_timeout;
//   4: minIdle 1, its connection leased and the lease held while the pool drops, the maintenance finding no capacity
//      each round; then the lease is dropped, and the report says whether its connection closed;
//   5: kind 2 with acquireTimeout 0: the maintenance's connects are still bounded, by a second, since a
//      connect_timeout of 0 would be none.
type resource Dropper implements Sendable {
    Sender<string> report;
    int32 kind;
    public ctor make(Sender<string> report, int32 kind) { this.report = give report; this.kind = kind; }
    public unsafe fn void run() {
        Channel<string> ch = Channel.bounded(capacity: 4096);
        Receiver<string> log = ch.receiver();
        PoolOptions o = sized(size: 1);
        DynamicArray<DynamicArray<Step>> scripts = DynamicArray.empty();
        string conninfo = "";
        if (this.kind == 1) {
            o = keeping(size: 3, least: 0);
            o.pingTimeout = Duration.fromSecs(s: 1i64);
            scripts.add(item: stalling()); scripts.add(item: stalling()); scripts.add(item: stalling());
        } else if (this.kind == 4) {
            o = keeping(size: 1, least: 1);
            scripts.add(item: opening());
        } else if (this.kind >= 2) {
            o = keeping(size: 1, least: 1);
            o.acquireTimeout = Duration.fromSecs(s: 1i64);
            if (this.kind == 3) { o.acquireTimeout = Duration.fromSecs(s: 5i64); conninfo = "connect_timeout=1"; }
            if (this.kind == 5) { o.acquireTimeout = Duration.zero(); }
            DynamicArray<Step> never = DynamicArray.empty();
            never.add(item: Step::Stall);
            scripts.add(item: give never);
        }
        Result<Pool, PgError> made = poolOverInfo(conninfo: conninfo, scripts: give scripts, options: o, log: give ch);
        Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { _ = this.report.send(item: e.message()); return; } };
        if (this.kind == 1) {
            Result<Lease, PgError> a = pool.acquire();
            Result<Lease, PgError> b = pool.acquire();
            Result<Lease, PgError> c = pool.acquire();
        }
        DynamicArray<Lease> held = DynamicArray.empty();   // kind 4's lease, held while the pool drops
        if (this.kind == 4) {
            DynamicArray<string> made1 = awaitLines(log: ref log, what: "connect", n: 1, within: Duration.fromSecs(s: 2i64));
            Result<Lease, PgError> a = pool.acquire();
            match (give a) { case Ok(value: l): { held.add(item: give l); } case Err(error: e): { } };
        }
        int64 wait = 200;
        if (this.kind == 1) { wait = 1500; }   // the first ping, from 1.1 s to 2.1 s
        sleep(d: Duration.fromMillis(ms: wait));
        Instant dropping = monotonicNow();
        { Pool gone = give pool; }
        int64 ms = dropping.elapsed().asMillis();
        _ = this.report.send(item: "${ms}");
        if (this.kind == 4) {
            DynamicArray<string> before = drained(log: ref log);
            isize leased = held.length();
            Optional<Lease> last = held.pop();
            match (give last) { case Some(value: l): { Lease outlived = give l; } case None: { } };
            DynamicArray<string> after = awaitLines(log: ref log, what: closeLine(), n: 1, within: Duration.fromSecs(s: 2i64));
            isize early = countIn(lines: before, what: closeLine());
            isize closed = countIn(lines: after, what: closeLine());
            _ = this.report.send(item: "leased ${leased}, closed ${early} before the lease was dropped and ${closed} after");
        }
    }
}

fn void dropInIsolate(Dropper job) { job.run(); }

// Check that a Dropper of `kind` dropped its pool in under `most` milliseconds. The check is made, and printed, before
// the isolate is joined, so a drop that never ends still fails its case first.
unsafe fn int32 droppedWithin(int32 kind, int64 most, const ref string what) {
    Channel<string> results = Channel.bounded(capacity: 2);
    Receiver<string> rx = results.receiver();
    Dropper job = Dropper.make(report: results.sender(), kind: kind);
    Isolate worker = spawn dropInIsolate(job: give job);
    Result<string, RecvError> r = rx.recvTimeout(timeout: Duration.fromSecs(s: 10i64));
    string took = match (give r) { case Ok(value: v): give v; case _: "(no report in 10 s)"; };
    return check(ok: tookUnder(took: took, most: most), what: what.concat(other: " (").concat(other: took).concat(other: " ms)"));
}

// Whether `took` is a number of milliseconds under `most`.
fn bool tookUnder(const ref string took, int64 most) {
    Result<int64, ParseError> ms = parse::<int64>(s: took);
    return match (ms) { case Ok(value: v): v >= 0i64 && v < most; case Err(error: e): false; };
}

unsafe fn int32 dropStopsMaintenance() {
    int32 f = 0;
    f = f + droppedWithin(kind: 0, most: 1000i64, what: "maintenance: dropping a pool stops its maintenance at once, mid-wait");
    f = f + droppedWithin(kind: 1, most: 1500i64, what: "maintenance: dropping a pool stops its maintenance after the ping under way, not the rest");
    f = f + droppedWithin(kind: 2, most: 1500i64, what: "maintenance: its connects end within acquireTimeout when there is no connect_timeout");
    f = f + droppedWithin(kind: 3, most: 2000i64, what: "maintenance: its connects keep the connect_timeout the Config has");
    f = f + droppedWithin(kind: 5, most: 1500i64, what: "maintenance: with an acquireTimeout of 0, its connects still end within a second");
    f = f + droppedWhileLeased();
    f = f + connectBoundRoundsUp();
    return f;
}

// The maintenance's connects are bounded by acquireTimeout rounded up to a whole second, connect_timeout's unit, never
// down: with acquireTimeout 1.1 s, a connect to a silent server gives up after 2 s, not 1 s, and the next round's
// connect follows it.
unsafe fn int32 connectBoundRoundsUp() {
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = keeping(size: 1, least: 1);
    o.acquireTimeout = Duration.fromMillis(ms: 1100i64);
    DynamicArray<DynamicArray<Step>> scripts = DynamicArray.empty();
    isize i = 0;
    while (i < 2) {
        DynamicArray<Step> never = DynamicArray.empty();
        never.add(item: Step::Stall);
        scripts.add(item: give never);
        i = i + 1;
    }
    Result<Pool, PgError> made = poolOverInfo(conninfo: "", scripts: give scripts, options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, connect bound"); } };
    DynamicArray<string> first = awaitLines(log: ref log, what: "connect", n: 1, within: Duration.fromSecs(s: 1i64));
    DynamicArray<string> soon = awaitLines(log: ref log, what: "connect", n: 1, within: Duration.fromMillis(ms: 1600i64));
    DynamicArray<string> later = awaitLines(log: ref log, what: "connect", n: 1, within: Duration.fromMillis(ms: 1500i64));
    isize began = countIn(lines: first, what: "connect");
    isize early = countIn(lines: soon, what: "connect");
    isize next = countIn(lines: later, what: "connect");
    return check(ok: began == 1 && early == 0 && next == 1,
                 what: "maintenance: its connects wait acquireTimeout rounded up to a whole second (1.1 s: the next connect ${early} within 1.6 s, ${next} by 3.1 s)");
}

// A pool dropped while its every connection is leased: the maintenance, which finds no capacity for minIdle each round,
// waits on no channel, so the drop is prompt. The lease outlives the pool, and its connection closes when it is dropped.
unsafe fn int32 droppedWhileLeased() {
    int32 f = 0;
    Channel<string> results = Channel.bounded(capacity: 2);
    Receiver<string> rx = results.receiver();
    Dropper job = Dropper.make(report: results.sender(), kind: 4);
    Isolate worker = spawn dropInIsolate(job: give job);
    Result<string, RecvError> r = rx.recvTimeout(timeout: Duration.fromSecs(s: 10i64));
    string took = match (give r) { case Ok(value: v): give v; case _: "(no report in 10 s)"; };
    f = f + check(ok: tookUnder(took: took, most: 1000i64),
                  what: "maintenance: dropping a pool whose connections are all leased stops its maintenance at once (".concat(other: took).concat(other: " ms)"));
    Result<string, RecvError> r2 = rx.recvTimeout(timeout: Duration.fromSecs(s: 10i64));
    string closed = match (give r2) { case Ok(value: v): give v; case _: "(no report in 10 s)"; };
    f = f + check(ok: closed.equals(other: "leased 1, closed 0 before the lease was dropped and 1 after"),
                  what: "pool: a lease that outlives its pool closes its connection when it is dropped (".concat(other: closed).concat(other: ")"));
    return f;
}

// A closed connection's place, taken by an acquire while another connection sits idle behind it: the idle one is
// leased, with no connect, and the place stays for the next acquire.
unsafe fn int32 emptyBehindIdle() {
    int32 f = 0;
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = sized(size: 2);
    o.reset = false;
    DynamicArray<DynamicArray<Step>> three = twoScripts(a: opening(), b: answersSentinel());
    three.add(item: opening());
    Result<Pool, PgError> made = poolOver(scripts: give three, options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, place behind"); } };
    Result<Lease, PgError> a = pool.acquire();
    Result<Lease, PgError> b = pool.acquire();
    {
        Result<Lease, PgError> first = give a;   // closed under its lease: its place goes back first
        match (give first) { case Ok(value: lease): { Lease l = give lease; l.conn().close(); } case Err(error: e): { } };
    }
    { Result<Lease, PgError> second = give b; }
    isize grown = connects(log: ref log);
    Result<Lease, PgError> c = pool.acquire();
    bool ran = false;
    isize reused = -1;
    string another = "";
    string beyond = "";
    match (give c) {
        case Ok(value: lease): {
            Lease held = give lease;
            reused = connects(log: ref log);
            ran = selectsOne(c: held.conn());
            Result<Lease, PgError> extra = pool.acquire();
            another = said(r: extra);
            Result<Lease, PgError> over = pool.acquire();
            beyond = said(r: over);
        }
        case Err(error: e): { }
    };
    f = f + check(ok: grown == 2 && ran && reused == 0,
                  what: "pool: an acquire that takes a closed connection's place leases the idle connection behind it, with no connect (connects ${reused})");
    f = f + check(ok: another.equals(other: "ok") && beyond.equals(other: "pool timed out while waiting for an open connection"),
                  what: "pool: the place stays for the next acquire, and the bound holds (".concat(other: another).concat(other: ", ").concat(other: beyond).concat(other: ")"));

    // Two closed connections' places in front of the idle one: the acquire passes over the second to reach it, and
    // both places stay the pool's.
    Channel<string> ch2 = Channel.bounded(capacity: 4096);
    Receiver<string> log2 = ch2.receiver();
    PoolOptions o2 = sized(size: 3);
    o2.reset = false;
    DynamicArray<DynamicArray<Step>> five = twoScripts(a: opening(), b: opening());
    five.add(item: answersSentinel());
    five.add(item: opening());
    five.add(item: opening());
    Result<Pool, PgError> made2 = poolOver(scripts: give five, options: o2, log: give ch2);
    Pool pool2 = match (give made2) { case Ok(value: p): give p; case Err(error: e): { return f + check(ok: false, what: "pool: make, places passed over"); } };
    Result<Lease, PgError> d = pool2.acquire();
    Result<Lease, PgError> e2 = pool2.acquire();
    Result<Lease, PgError> g = pool2.acquire();
    {
        Result<Lease, PgError> first = give d;
        match (give first) { case Ok(value: lease): { Lease l = give lease; l.conn().close(); } case Err(error: x): { } };
    }
    {
        Result<Lease, PgError> second = give e2;
        match (give second) { case Ok(value: lease): { Lease l = give lease; l.conn().close(); } case Err(error: x): { } };
    }
    { Result<Lease, PgError> third = give g; }
    isize grown2 = connects(log: ref log2);
    Result<Lease, PgError> h = pool2.acquire();
    bool ran2 = false;
    isize reused2 = -1;
    string fourth = "";
    string fifth = "";
    string sixth = "";
    match (give h) {
        case Ok(value: lease): {
            Lease held = give lease;
            reused2 = connects(log: ref log2);
            ran2 = selectsOne(c: held.conn());
            Result<Lease, PgError> x1 = pool2.acquire();
            fourth = said(r: x1);
            Result<Lease, PgError> x2 = pool2.acquire();
            fifth = said(r: x2);
            Result<Lease, PgError> x3 = pool2.acquire();
            sixth = said(r: x3);
        }
        case Err(error: x): { }
    };
    f = f + check(ok: grown2 == 3 && ran2 && reused2 == 0 && fourth.equals(other: "ok") && fifth.equals(other: "ok")
                      && sixth.equals(other: "pool timed out while waiting for an open connection"),
                  what: "pool: the closed connections' places an acquire passes over to reach an idle one stay the pool's (connects ${reused2}; "
                        .concat(other: fourth).concat(other: ", ").concat(other: fifth).concat(other: ", ").concat(other: sixth).concat(other: ")"));
    return f;
}

// The round's ping pass meets a free place only when an acquire takes a connection it counted: while its ping to the
// first stale connection waits out pingTimeout (800 ms), an acquire leases the second, and the pass, owing one more
// ping, then takes the free places behind them. It puts each back. The acquire comes as the ping is seen in the log.
// The servers are strict, so that the ping is the message that takes the first one's Stall step (a `pinged` server
// answers it without a step), and the second answers one ping, acquire's, before the sentinel.
unsafe fn int32 pingPassKeepsPlaces() {
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = keeping(size: 3, least: 0);
    o.healthCheck = Duration.fromMillis(ms: 700i64);
    o.pingTimeout = Duration.fromMillis(ms: 800i64);
    o.acquireTimeout = Duration.fromMillis(ms: 500i64);
    o.queryTimeout = Optional::Some(value: Duration.fromSecs(s: 2i64));   // a wrong lease fails, rather than waits for ever
    Wire pong = Wire.make();
    pong.emptyQuery();
    pong.ready(status: IDLE);
    DynamicArray<Step> answering = opening();
    answering.add(item: answer(tag: 81ui8, reply: give pong));
    answering.add(item: sentinel());
    DynamicArray<DynamicArray<Step>> scripts = twoScripts(a: stalling(), b: give answering);
    scripts.add(item: opening());   // closed under its lease
    scripts.add(item: opening());
    scripts.add(item: opening());
    Result<Pool, PgError> made = poolOver(scripts: give scripts, options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, ping pass"); } };
    Result<Lease, PgError> a = pool.acquire();
    Result<Lease, PgError> b = pool.acquire();
    Result<Lease, PgError> c = pool.acquire();
    { Result<Lease, PgError> silent = give a; }     // first in line
    { Result<Lease, PgError> pinged = give b; }      // then the one acquire will ping
    {
        Result<Lease, PgError> lost = give c;       // closed under its lease: its place goes in behind them
        match (give lost) { case Ok(value: lease): { Lease l = give lease; l.conn().close(); } case Err(error: e): { } };
    }
    DynamicArray<string> pinging = awaitLines(log: ref log, what: pingLine(), n: 1, within: Duration.fromSecs(s: 3i64));
    isize seen = countIn(lines: pinging, what: pingLine());
    Result<Lease, PgError> d = pool.acquire();
    sleep(d: Duration.fromMillis(ms: 1200i64));   // the ping fails, and the pass goes on
    bool ran = false;
    string second = "";
    string third = "";
    string beyond = "";
    match (give d) {
        case Ok(value: lease): {
            Lease held = give lease;
            ran = selectsOne(c: held.conn());
            Result<Lease, PgError> x1 = pool.acquire();
            second = said(r: x1);
            Result<Lease, PgError> x2 = pool.acquire();
            third = said(r: x2);
            Result<Lease, PgError> x3 = pool.acquire();
            beyond = said(r: x3);
        }
        case Err(error: e): { }
    };
    return check(ok: seen == 1 && ran && second.equals(other: "ok") && third.equals(other: "ok") && beyond.equals(other: "pool timed out while waiting for an open connection"),
                 what: "maintenance: the ping pass puts back the free places it meets while an acquire takes what it would ping (ping ${seen}, ran ${ran}; ".concat(other: second)
                       .concat(other: ", ").concat(other: third).concat(other: ", ").concat(other: beyond).concat(other: ")"));
}

// Capacity for minIdle, behind an idle connection: the maintenance passes over the idle one to reach the free place,
// connects on it, and keeps the idle one.
unsafe fn int32 claimPassesIdle() {
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = keeping(size: 2, least: 2);
    o.acquireTimeout = Duration.fromMillis(ms: 500i64);
    Result<Pool, PgError> made = keptPool(scripts: openings(n: 3), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, claim"); } };
    DynamicArray<string> early = awaitLines(log: ref log, what: "connect", n: 2, within: Duration.fromSecs(s: 5i64));
    isize first = countIn(lines: early, what: "connect");
    Result<Lease, PgError> a = pool.acquire();
    Result<Lease, PgError> b = pool.acquire();
    { Result<Lease, PgError> kept = give a; }   // idle, first in line
    {
        Result<Lease, PgError> lost = give b;   // closed under its lease: its place goes in behind the idle one
        match (give lost) { case Ok(value: lease): { Lease l = give lease; l.conn().close(); } case Err(error: e): { } };
    }
    // Within a few rounds, and before the idle one has sat a second: its ping would put it back behind the free place.
    DynamicArray<string> later = awaitLines(log: ref log, what: "connect", n: 1, within: Duration.fromMillis(ms: 600i64));
    DynamicArray<string> rest = drained(log: ref log);
    isize refilled = countIn(lines: later, what: "connect") + countIn(lines: rest, what: "connect");
    isize closed = countIn(lines: early, what: closeLine()) + countIn(lines: later, what: closeLine()) + countIn(lines: rest, what: closeLine());
    Result<Lease, PgError> c = pool.acquire();
    Result<Lease, PgError> d = pool.acquire();
    isize leasing = connects(log: ref log);
    Result<Lease, PgError> over = pool.acquire();
    string third = said(r: over);
    return check(ok: first == 2 && refilled == 1 && closed == 1 && said(r: c).equals(other: "ok") && said(r: d).equals(other: "ok") && leasing == 0
                     && third.equals(other: "pool timed out while waiting for an open connection"),
                 what: "maintenance: it passes over an idle connection to reach a free place for minIdle, and keeps the idle one (connects ${first}, ${refilled}, ${leasing}; closed ${closed}; "
                       .concat(other: third).concat(other: ")"));
}

// Lifetimes spread by lifetimeJitter: of eight connections made together with a lifetime of 200 ms and up to a second
// more, not all are closed within 400 ms (the chance of it is (1/5)^8), and all are closed once the second has passed.
// With no spread, all eight close within a round of 200 ms.
unsafe fn int32 lifetimesSpread() {
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = keeping(size: 8, least: 0);
    o.healthCheck = Duration.fromMillis(ms: 50i64);
    o.lifetime = Optional::Some(value: Duration.fromMillis(ms: 200i64));
    o.lifetimeJitter = Duration.fromMillis(ms: 1000i64);
    Result<Pool, PgError> made = keptPool(scripts: openings(n: 8), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, jitter"); } };
    isize leased = 0;
    Instant start = monotonicNow();
    {
        DynamicArray<Lease> held = DynamicArray.empty();
        isize i = 0;
        while (i < 8) {
            Result<Lease, PgError> a = pool.acquire();
            match (give a) { case Ok(value: l): { held.add(item: give l); } case Err(error: e): { } };
            i = i + 1;
        }
        leased = held.length();
        start = monotonicNow();
    }
    DynamicArray<string> early = awaitLines(log: ref log, what: closeLine(), n: 8, within: Duration.fromMillis(ms: 400i64));
    isize soon = countIn(lines: early, what: closeLine());
    sleepUntil(from: start, ms: 1700i64);
    DynamicArray<string> rest = drained(log: ref log);
    isize all = soon + countIn(lines: rest, what: closeLine());
    return check(ok: leased == 8 && soon < 8 && all == 8,
                 what: "pool: lifetimes are spread over lifetimeJitter, so connections made together are not all closed together (${soon} closed within 400 ms, ${all} by 1.7 s)");
}

// Sleep until `ms` after `from`.
unsafe fn void sleepUntil(Instant from, int64 ms) {
    Instant at = from + Duration.fromMillis(ms: ms);
    Instant now = monotonicNow();
    if (now < at) { sleep(d: at.since(earlier: now)); }
}

// Npgsql's median, over a window of three rounds (idleTimeout 1.2 s, healthCheck 400 ms): the round that fills the
// window closes as many as the middle of its three idle counts, sorted, and the next window starts afresh.
unsafe fn int32 medianTests() {
    int32 f = 0;
    // Counts 0, 0, 2: the median is 0, so nothing is closed (the largest count would close both). The next window's
    // counts are 2, 2, 2, and both are closed.
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = keeping(size: 2, least: 0);
    o.healthCheck = Duration.fromMillis(ms: 400i64);
    o.idleTimeout = Optional::Some(value: Duration.fromMillis(ms: 1200i64));
    Result<Pool, PgError> made = keptPool(scripts: openings(n: 2), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, median"); } };
    Instant start = monotonicNow();
    {
        Result<Lease, PgError> a = pool.acquire();
        Result<Lease, PgError> b = pool.acquire();
        sleepUntil(from: start, ms: 1000i64);   // the rounds at 400 and 800 ms count 0
    }                                           // the round at 1200 ms counts 2
    sleepUntil(from: start, ms: 1600i64);
    DynamicArray<string> first = drained(log: ref log);
    DynamicArray<string> second = awaitLines(log: ref log, what: closeLine(), n: 2, within: Duration.fromMillis(ms: 1800i64));
    isize early = countIn(lines: first, what: closeLine());
    isize later = countIn(lines: second, what: closeLine());
    f = f + check(ok: early == 0, what: "maintenance: pruning closes the median of the window's idle counts (0, 0, 2: none; closed ${early})");
    f = f + check(ok: later == 2, what: "maintenance: each window of idle counts starts afresh (2, 2, 2: both; closed ${later})");

    // Counts 0, 2, 2: the median is 2, so both are closed (the smallest count would close none).
    Channel<string> ch2 = Channel.bounded(capacity: 4096);
    Receiver<string> log2 = ch2.receiver();
    Result<Pool, PgError> made2 = keptPool(scripts: openings(n: 2), options: o, log: give ch2);
    Pool pool2 = match (give made2) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, median 2"); } };
    Instant start2 = monotonicNow();
    {
        Result<Lease, PgError> a = pool2.acquire();
        Result<Lease, PgError> b = pool2.acquire();
        sleepUntil(from: start2, ms: 600i64);   // the round at 400 ms counts 0
    }                                           // the rounds at 800 and 1200 ms count 2
    DynamicArray<string> lines = awaitLines(log: ref log2, what: closeLine(), n: 2, within: Duration.fromMillis(ms: 1200i64));
    isize closed = countIn(lines: lines, what: closeLine());
    f = f + check(ok: closed == 2, what: "maintenance: pruning closes the median of the window's idle counts (0, 2, 2: both; closed ${closed})");

    // Counts 1, 1, 3: the median is 1, so one of the three idle is closed, not every one the round counted.
    Channel<string> ch3 = Channel.bounded(capacity: 4096);
    Receiver<string> log3 = ch3.receiver();
    PoolOptions o3 = keeping(size: 3, least: 0);
    o3.healthCheck = Duration.fromMillis(ms: 400i64);
    o3.idleTimeout = Optional::Some(value: Duration.fromMillis(ms: 1200i64));
    Result<Pool, PgError> made3 = keptPool(scripts: openings(n: 3), options: o3, log: give ch3);
    Pool pool3 = match (give made3) { case Ok(value: p): give p; case Err(error: e): { return f + check(ok: false, what: "maintenance: make, median 1"); } };
    Instant start3 = monotonicNow();
    {
        Result<Lease, PgError> a = pool3.acquire();
        Result<Lease, PgError> b = pool3.acquire();
        Result<Lease, PgError> c = pool3.acquire();
        { Result<Lease, PgError> lead = give a; }    // the rounds at 400 and 800 ms count 1
        sleepUntil(from: start3, ms: 1000i64);
    }                                                  // the round at 1200 ms counts 3
    DynamicArray<string> before = drained(log: ref log3);
    sleepUntil(from: start3, ms: 2000i64);             // the next window's last round is at 2400 ms
    DynamicArray<string> window = drained(log: ref log3);
    isize early3 = countIn(lines: before, what: closeLine());
    isize closed3 = countIn(lines: window, what: closeLine());
    f = f + check(ok: early3 == 0 && closed3 == 1,
                  what: "maintenance: pruning closes the median of the window's idle counts (1, 1, 3: one; closed ${early3}, then ${closed3})");
    return f;
}

// Rounds that close connections past their lifetime and connect for minIdle keep the bound: maxSize leases can be
// held, and not one more.
unsafe fn int32 boundKeptThroughRounds() {
    int32 f = 0;
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = keeping(size: 2, least: 1);
    o.lifetime = Optional::Some(value: Duration.fromMillis(ms: 300i64));
    o.acquireTimeout = Duration.fromSecs(s: 1i64);
    Result<Pool, PgError> made = keptPool(scripts: openings(n: 40), options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "maintenance: make, bound"); } };
    isize round = 0;
    while (round < 2) {
        sleep(d: Duration.fromMillis(ms: 1000i64));
        Result<Lease, PgError> a = pool.acquire();
        Result<Lease, PgError> b = pool.acquire();
        Result<Lease, PgError> c = pool.acquire();
        string first = said(r: a);
        string second = said(r: b);
        string third = said(r: c);
        f = f + check(ok: first.equals(other: "ok") && second.equals(other: "ok") && third.equals(other: "pool timed out while waiting for an open connection"),
                      what: "maintenance: after rounds of closes and connects, maxSize (2) leases can be held and no more (".concat(other: first).concat(other: ", ")
                            .concat(other: second).concat(other: ", ").concat(other: third).concat(other: ")"));
        round = round + 1;
    }
    return f;
}

unsafe fn int32 maintenanceTests() {
    int32 f = 0;
    f = f + minIdleAtStart();
    f = f + refilledAfterLoss();
    f = f + pruningTests();
    f = f + medianTests();
    f = f + emptyBehindIdle();
    f = f + claimPassesIdle();
    f = f + pingPassKeepsPlaces();
    f = f + lifetimesSpread();
    f = f + lifetimeKept();
    f = f + keeperPings();
    f = f + droppedFoundByKeeper();
    f = f + acquirePings();
    f = f + failedPingPassedOver();
    f = f + pingBounded();
    f = f + dropStopsMaintenance();
    f = f + boundKeptThroughRounds();
    f = f + boundUnderChurn();
    return f;
}

// ---- the bound under churn ----

// Acquires from a pool it joins `rounds` times, holding each connection a moment, closing every third under its lease
// and giving the rest back; then reports "ok" and the connects refused, or the first other failure.
type resource Churner implements Sendable {
    PoolShare share;
    Sender<string> report;
    public ctor make(PoolShare share, Sender<string> report) { this.share = give share; this.report = give report; }
    public unsafe fn void run() {
        Pool pool = Pool.join(share: this.share);
        isize refused = 0;
        string other = "";
        isize round = 0;
        while (round < 40) {
            Result<Lease, PgError> got = pool.acquire();
            match (give got) {
                case Ok(value: lease): {
                    Lease l = give lease;
                    sleep(d: Duration.fromMillis(ms: 1i64));
                    if (round % 3 == 0) { l.conn().close(); }
                }
                case Err(error: e): {
                    string m = e.message();
                    if (m.contains(substring: "sorry, too many clients already")) { refused = refused + 1; }
                    else if (other.length() == 0) { other = copy m; }
                }
            };
            round = round + 1;
        }
        string outcome = "ok, ${refused} refused";
        if (other.length() > 0) { outcome = copy other; }
        _ = this.report.send(item: give outcome);
    }
}

fn void churnInIsolate(Churner job) { job.run(); }

// A connect the server refuses (FATAL 53300).
fn DynamicArray<Step> refusedConnect() {
    Wire w = Wire.make();
    w.report(tag: 69ui8, severity: "FATAL", code: "53300", message: "sorry, too many clients already");
    DynamicArray<Step> s = DynamicArray.empty();
    s.add(item: Step::Send(bytes: w.bytes()));
    return s;
}

// Four isolates churn through one pool of 3 while every path that gives capacity back runs at once: connections
// closed under their leases, connects refused, lifetimes of 30 to 60 ms ending on release, on acquire and in the
// maintenance, pruning, and minIdle connected again. If a path lost a place, acquires would time out; if one made a
// place, a release would block on the full channel. After it, 3 leases can be held and not a fourth.
unsafe fn int32 boundUnderChurn() {
    int32 f = 0;
    Channel<string> ch = Channel.bounded(capacity: 4096);
    Receiver<string> log = ch.receiver();
    PoolOptions o = keeping(size: 3, least: 1);
    o.healthCheck = Duration.fromMillis(ms: 20i64);
    o.idleTimeout = Optional::Some(value: Duration.fromMillis(ms: 60i64));
    o.lifetime = Optional::Some(value: Duration.fromMillis(ms: 30i64));
    o.lifetimeJitter = Duration.fromMillis(ms: 30i64);
    o.acquireTimeout = Duration.fromSecs(s: 1i64);
    DynamicArray<DynamicArray<Step>> scripts = DynamicArray.empty();
    isize i = 0;
    while (i < 1000) {
        if (i % 5 == 4) { scripts.add(item: refusedConnect()); } else { scripts.add(item: opening()); }
        i = i + 1;
    }
    Result<Pool, PgError> made = keptPool(scripts: give scripts, options: o, log: give ch);
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return check(ok: false, what: "pool: make, churn"); } };
    Channel<string> results = Channel.bounded(capacity: 8);
    Receiver<string> rx = results.receiver();
    DynamicArray<Isolate> running = DynamicArray.empty();
    i = 0;
    while (i < 4) {
        Result<PoolShare, PgError> sh = pool.share();
        match (give sh) {
            case Ok(value: x): {
                Churner job = Churner.make(share: give x, report: results.sender());
                Isolate w = spawn churnInIsolate(job: give job);
                running.add(item: give w);
            }
            case Err(error: e): { }
        };
        i = i + 1;
    }
    // The reports, reading the log as they come so that its channel never fills.
    string seen = "";
    bool churned = running.length() == 4;
    isize reports = 0;
    Instant until = monotonicNow() + Duration.fromSecs(s: 60i64);
    while (reports < 4 && monotonicNow() < until) {
        Result<string, RecvError> r = rx.recvTimeout(timeout: Duration.fromMillis(ms: 50i64));
        match (give r) {
            case Ok(value: v): {
                churned = churned && v.startsWith(prefix: "ok,");
                if (seen.length() > 0) { seen = seen.concat(other: "; "); }
                seen = seen.concat(other: v);
                reports = reports + 1;
            }
            case _: { }
        };
        DynamicArray<string> lines = drained(log: ref log);
    }
    f = f + check(ok: churned && reports == 4, what: "pool: four isolates churning through one pool never wait out acquireTimeout (".concat(other: seen).concat(other: ")"));
    // The bound: 3 leases (a refused connect gives its place back, and is tried again), then a fourth times out.
    DynamicArray<Lease> held = DynamicArray.empty();
    isize tries = 0;
    string failed = "";
    while (held.length() < 3 && tries < 10) {
        Result<Lease, PgError> a = pool.acquire();
        match (give a) {
            case Ok(value: l): { held.add(item: give l); }
            case Err(error: e): { string m = e.message(); if (!m.contains(substring: "sorry, too many clients already")) { failed = copy m; } }
        };
        tries = tries + 1;
        DynamicArray<string> lines = drained(log: ref log);
    }
    isize leased = held.length();
    Result<Lease, PgError> beyond = pool.acquire();
    string fourth = said(r: beyond);
    f = f + check(ok: leased == 3 && failed.length() == 0 && fourth.equals(other: "pool timed out while waiting for an open connection"),
                  what: "pool: after the churn, maxSize (3) leases can be held and no more (${leased} in ${tries} tries; ".concat(other: failed)
                        .concat(other: fourth).concat(other: ")"));
    return f;
}

// ---- making and sharing ----

// Why `options` cannot make a pool, or "made".
unsafe fn string refusal(PoolOptions options) {
    DynamicArray<DynamicArray<Step>> none = DynamicArray.empty();
    Result<Pool, PgError> made = poolOver(scripts: give none, options: options, log: Channel.bounded(capacity: 1));
    return match (made) { case Ok(value: p): "made"; case Err(error: e): e.message(); };
}

fn PoolOptions minIdleOf(isize n) {
    PoolOptions o = sized(size: 2);
    o.minIdle = n;
    return o;
}

unsafe fn int32 refusals() {
    int32 f = 0;
    DynamicArray<DynamicArray<Step>> none = DynamicArray.empty();
    Result<Pool, PgError> zero = poolOver(scripts: give none, options: sized(size: 0), log: Channel.bounded(capacity: 1));
    string z = match (zero) { case Ok(value: p): "made"; case Err(error: e): e.message(); };
    f = f + check(ok: z.equals(other: "pool maxSize must be at least 1, not 0"), what: "pool: maxSize 0 is refused (".concat(other: z).concat(other: ")"));
    PoolOptions o = sized(size: 1);
    o.acquireTimeout = Duration.fromMillis(ms: -1i64);
    DynamicArray<DynamicArray<Step>> none2 = DynamicArray.empty();
    Result<Pool, PgError> negative = poolOver(scripts: give none2, options: o, log: Channel.bounded(capacity: 1));
    string neg = match (negative) { case Ok(value: p): "made"; case Err(error: e): e.message(); };
    f = f + check(ok: neg.equals(other: "pool durations must not be negative"), what: "pool: a negative duration is refused (".concat(other: neg).concat(other: ")"));
    PoolOptions j = sized(size: 1);
    j.lifetimeJitter = Duration.fromMillis(ms: -1i64);
    f = f + check(ok: refusal(options: j).equals(other: "pool durations must not be negative"), what: "pool: a negative lifetimeJitter is refused");
    PoolOptions g = sized(size: 1);
    g.queryGrace = Duration.fromMillis(ms: -1i64);
    f = f + check(ok: refusal(options: g).equals(other: "pool durations must not be negative"), what: "pool: a negative queryGrace is refused");
    PoolOptions q = sized(size: 1);
    q.queryTimeout = Optional::Some(value: Duration.fromMillis(ms: -1i64));
    f = f + check(ok: refusal(options: q).equals(other: "pool durations must not be negative"), what: "pool: a negative queryTimeout is refused");
    PoolOptions o2 = sized(size: 1);
    o2.lifetime = Optional::Some(value: Duration.zero());
    DynamicArray<DynamicArray<Step>> none3 = DynamicArray.empty();
    Result<Pool, PgError> noLife = poolOver(scripts: give none3, options: o2, log: Channel.bounded(capacity: 1));
    string nl = match (noLife) { case Ok(value: p): "made"; case Err(error: e): e.message(); };
    f = f + check(ok: nl.equals(other: "pool lifetime must be more than 0 (or None, for no limit)"), what: "pool: a lifetime of 0 is refused (".concat(other: nl).concat(other: ")"));

    DynamicArray<DynamicArray<Step>> none4 = DynamicArray.empty();
    Result<Pool, PgError> made = poolOver(scripts: give none4, options: sized(size: 1), log: Channel.bounded(capacity: 1));
    Pool pool = match (give made) { case Ok(value: p): give p; case Err(error: e): { return f + check(ok: false, what: "pool: make, share"); } };
    Result<PoolShare, PgError> sh = pool.share();
    PoolShare share = match (give sh) { case Ok(value: x): give x; case Err(error: e): { return f + check(ok: false, what: "pool: share"); } };
    Pool joined = Pool.join(share: share);
    Result<PoolShare, PgError> again = joined.share();
    string a = match (again) { case Ok(value: x): "shared"; case Err(error: e): e.message(); };
    f = f + check(ok: a.equals(other: "a pool joined from a PoolShare cannot be shared again: share the pool that made it"),
                  what: "pool: a joined pool cannot share (".concat(other: a).concat(other: ")"));

    f = f + check(ok: refusal(options: minIdleOf(n: 3)).equals(other: "pool minIdle must be from 0 to maxSize (2), not 3"), what: "pool: minIdle over maxSize is refused");
    f = f + check(ok: refusal(options: minIdleOf(n: -1)).equals(other: "pool minIdle must be from 0 to maxSize (2), not -1"), what: "pool: a negative minIdle is refused");
    PoolOptions o5 = sized(size: 1);
    o5.healthCheck = Duration.zero();
    f = f + check(ok: refusal(options: o5).equals(other: "pool healthCheck must be more than 0"), what: "pool: a healthCheck of 0 is refused");
    PoolOptions o6 = sized(size: 1);
    o6.pingTimeout = Duration.zero();
    f = f + check(ok: refusal(options: o6).equals(other: "pool pingTimeout must be more than 0"), what: "pool: a pingTimeout of 0 is refused");
    PoolOptions o7 = sized(size: 1);
    o7.idleTimeout = Optional::Some(value: Duration.fromSecs(s: 30i64));   // healthCheck is a minute
    f = f + check(ok: refusal(options: o7).equals(other: "pool idleTimeout must be at least healthCheck (or None, for no limit)"),
                  what: "pool: an idleTimeout under healthCheck is refused, as Npgsql refuses it");
    PoolOptions o8 = sized(size: 1);
    o8.idleTimeout = Optional::Some(value: Duration.fromSecs(s: 60i64));
    f = f + check(ok: refusal(options: o8).equals(other: "made"), what: "pool: an idleTimeout equal to healthCheck is taken");

    PoolOptions d = PoolOptions.defaults();
    isize cpus = cast<isize>(cpuCount());
    isize most = cpus;
    if (cpus < 4) { most = 4; }
    bool lifeHour = match (d.lifetime) { case Some(value: t): t.asSecs() == 3600i64; case None: false; };
    f = f + check(ok: d.maxSize == most && lifeHour && d.lifetimeJitter.asSecs() == 90i64 && d.acquireTimeout.asSecs() == 30i64
                      && d.reset && msOf(t: d.queryTimeout) == -1i64 && d.queryGrace.asSecs() == 2i64,
                  what: "pool: the defaults are max(4, CPUs), an hour and 90 s, 30 s, reset on, no query timeout and 2 s of grace");
    f = f + check(ok: d.minIdle == 0 && msOf(t: d.idleTimeout) == 1800000i64 && d.healthCheck.asSecs() == 60i64 && d.pingTimeout.asSecs() == 5i64,
                  what: "pool: the maintenance's defaults are minIdle 0, idleTimeout 30 min, healthCheck 1 min and pingTimeout 5 s");
    return f;
}

unsafe fn int32 poolTests() {
    int32 f = 0;
    f = f + sequentialKeepsOne();
    f = f + boundedAndTimesOut();
    f = f + waiterWokenAcrossIsolates();
    f = f + waiterWokenByFreedPlace();
    f = f + closedIsReplaced();
    f = f + busyTests();
    f = f + blockRolledBackAndReset();
    f = f + windowOnLease();
    f = f + resetOffSendsNothing();
    f = f + resetOffRollsBack();
    f = f + resetOffFailedRollbackDropped();
    f = f + failedResetDropped();
    f = f + failedConnectGivesBack();
    f = f + lifetimeTests();
    f = f + settingsPutBack();
    f = f + refusals();
    f = f + maintenanceTests();
    return f;
}
