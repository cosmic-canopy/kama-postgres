// Transactions against a scripted server: the exact statements each call sends (BEGIN with its options, COMMIT,
// ROLLBACK, the savepoints), what COMMIT's ROLLBACK tag means, and the borrow window's Transaction: what its mint
// sends, what its methods send, and what the window sends when it closes, on every way out of it.
//
// A window that should send nothing as it closes is followed by a sentinel (SELECT 1) at the end of the script. A
// statement the script does not expect is answered FATAL and the server hangs up; one past the end of the script is
// never answered, so the client times out. Either way the sentinel then fails, which is what catches a stray ROLLBACK.
import { std::collections::DynamicArray, std::encoding::hex::encode as hexEncode,
         postgres::Connection, postgres::PgError, postgres::Rows, postgres::TransactionStatus, postgres::Query,
         postgres::TransactionOptions, postgres::IsolationLevel, postgres::AccessMode, postgres::Savepoint,
         postgres::Transaction, postgres::CopyInfo,
         postgres::sqlstate::UNIQUE_VIOLATION, postgres::sqlstate::FOREIGN_KEY_VIOLATION,
         postgres::sqlstate::IN_FAILED_SQL_TRANSACTION, postgres::sqlstate::ACTIVE_SQL_TRANSACTION,
         postgres_unit_tests::check, postgres_unit_tests::Step, postgres_unit_tests::Wire,
         postgres_unit_tests::over, postgres_unit_tests::overUncached, postgres_unit_tests::welcome };
export { transactionTests };

comptime uint8 IDLE = 73ui8;     // 'I'
comptime uint8 INTX = 84ui8;     // 'T'
comptime uint8 FAILED = 69ui8;   // 'E'

// The simple query `sql` must come next; the server completes it with `tag` and is then ready with `status`.
unsafe fn Step completes(const ref string sql, const ref string tag, uint8 status) {
    DynamicArray<uint8> text = DynamicArray.empty();
    foreach (uint8 b in sql) { text.add(item: b); }
    text.add(item: 0ui8);
    Wire reply = Wire.make();
    reply.complete(tag: tag);
    reply.ready(status: status);
    return Step::Expect(tag: 81ui8, body: hexEncode(bytes: text.view()), then: reply.bytes());
}

// The simple query `sql` must come next, and fails with `code`.
unsafe fn Step fails(const ref string sql, const ref string code, uint8 status) {
    DynamicArray<uint8> text = DynamicArray.empty();
    foreach (uint8 b in sql) { text.add(item: b); }
    text.add(item: 0ui8);
    Wire reply = Wire.make();
    reply.report(tag: 69ui8, severity: "ERROR", code: code, message: "it failed");
    reply.ready(status: status);
    return Step::Expect(tag: 81ui8, body: hexEncode(bytes: text.view()), then: reply.bytes());
}

// The simple query `sql` must come next, and the server answers it with `reply`.
unsafe fn Step answers(const ref string sql, Wire reply) {
    DynamicArray<uint8> text = DynamicArray.empty();
    foreach (uint8 b in sql) { text.add(item: b); }
    text.add(item: 0ui8);
    return Step::Expect(tag: 81ui8, body: hexEncode(bytes: text.view()), then: reply.bytes());
}

// The next message must be of type `tag`; reply with `reply` (nothing, when it is empty).
fn Step quiet(uint8 tag) { return Step::Expect(tag: tag, body: "", then: DynamicArray.empty()); }
fn Step answer(uint8 tag, Wire reply) { return Step::Expect(tag: tag, body: "", then: reply.bytes()); }

// The sentinel: SELECT 1, ready with `status`.
unsafe fn Step sentinel(uint8 status) { return completes(sql: "SELECT 1", tag: "SELECT 1", status: status); }

// The sentinel runs, so nothing was sent between the last statement and it.
unsafe fn bool sentinelRuns(ref Connection c) {
    Result<DynamicArray<Rows>, PgError> r = c.simpleQuery(sql: "SELECT 1");
    bool ran = match (r) { case Ok(value: rows): true; case Err(error: e): false; };
    return ran && !c.isClosed();
}

// A script that starts with the server's welcome.
fn DynamicArray<Step> opening() { DynamicArray<Step> s = DynamicArray.empty(); s.add(item: Step::Send(bytes: welcome())); return s; }

unsafe fn Result<Connection, PgError> scripted(DynamicArray<Step> steps) {
    string none = "";
    return over(script: give steps, conninfo: none);
}

fn string said(const ref Result<Unit, PgError> r) { return match (r) { case Ok(value: u): "ok"; case Err(error: e): e.message(); }; }
fn int32 stateOf(const ref Result<Unit, PgError> r) { return match (r) { case Ok(value: u): 0; case Err(error: e): e.sqlstate(); }; }

// A helper that works inside a window it did not open: it borrows the transaction.
unsafe fn Result<Unit, PgError> insertOne(ref Transaction tx) {
    Result<DynamicArray<Rows>, PgError> r = tx.conn().simpleQuery(sql: "INSERT INTO t VALUES (1)");
    return match (give r) { case Ok(value: rows): Result::Ok(value: Unit::Unit); case Err(error: e): Result::Err(error: give e); };
}

// A window left by an early return.
unsafe fn int32 leavesEarly(ref Connection c) {
    borrow c.transaction() as tx {
        Result<Unit, PgError> b = tx.began();
        return 5;
    }
}

unsafe fn int32 transactionTests() {
    int32 f = 0;
    TransactionOptions plain = TransactionOptions.defaults();

    // BEGIN with every option, then COMMIT.
    DynamicArray<Step> s1 = opening();
    s1.add(item: completes(sql: "BEGIN ISOLATION LEVEL SERIALIZABLE READ ONLY DEFERRABLE", tag: "BEGIN", status: INTX));
    s1.add(item: completes(sql: "COMMIT", tag: "COMMIT", status: IDLE));
    s1.add(item: completes(sql: "BEGIN ISOLATION LEVEL READ COMMITTED READ WRITE", tag: "BEGIN", status: INTX));
    s1.add(item: completes(sql: "ROLLBACK", tag: "ROLLBACK", status: IDLE));
    Result<Connection, PgError> m1 = scripted(steps: give s1);
    Connection c = match (give m1) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "transaction: connect (".concat(other: e.message()).concat(other: ")")); } };
    TransactionOptions strict = TransactionOptions.of(isolation: IsolationLevel::Serializable, access: AccessMode::ReadOnly, deferrable: true);
    Result<Unit, PgError> b1 = c.begin(options: strict);
    f = f + check(ok: said(r: b1).equals(other: "ok") && c.transactionStatus() == TransactionStatus::InTransaction, what: "transaction: BEGIN with its options (".concat(other: said(r: b1)).concat(other: ")"));
    Result<Unit, PgError> k1 = c.commit();
    f = f + check(ok: said(r: k1).equals(other: "ok") && c.transactionStatus() == TransactionStatus::Idle, what: "transaction: COMMIT");
    TransactionOptions written = TransactionOptions.of(isolation: IsolationLevel::ReadCommitted, access: AccessMode::ReadWrite, deferrable: false);
    Result<Unit, PgError> b2 = c.begin(options: written);
    Result<Unit, PgError> r2 = c.rollback();
    f = f + check(ok: said(r: b2).equals(other: "ok") && said(r: r2).equals(other: "ok"), what: "transaction: BEGIN READ COMMITTED READ WRITE, then ROLLBACK");

    // A COMMIT the server ends with a rollback: the transaction had failed.
    DynamicArray<Step> s2 = opening();
    s2.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s2.add(item: completes(sql: "COMMIT", tag: "ROLLBACK", status: IDLE));
    Result<Connection, PgError> m2 = scripted(steps: give s2);
    match (give m2) {
        case Ok(value: x): {
            Connection d = give x;
            Result<Unit, PgError> b = d.begin(options: plain);
            Result<Unit, PgError> k = d.commit();
            f = f + check(ok: said(r: k).equals(other: "commit unexpectedly resulted in rollback"), what: "transaction: COMMIT that rolled back (".concat(other: said(r: k)).concat(other: ")"));
        }
        case Err(error: e): { f = f + check(ok: false, what: "transaction: connect 2"); }
    };

    // Savepoints by name.
    DynamicArray<Step> s3 = opening();
    s3.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s3.add(item: completes(sql: "SAVEPOINT sp_1", tag: "SAVEPOINT", status: INTX));
    s3.add(item: completes(sql: "ROLLBACK TO SAVEPOINT sp_1", tag: "ROLLBACK", status: INTX));
    s3.add(item: completes(sql: "RELEASE SAVEPOINT sp_1", tag: "RELEASE", status: INTX));
    s3.add(item: completes(sql: "COMMIT", tag: "COMMIT", status: IDLE));
    Result<Connection, PgError> m3 = scripted(steps: give s3);
    match (give m3) {
        case Ok(value: x): {
            Connection e = give x;
            Result<Unit, PgError> b = e.begin(options: plain);
            Result<Savepoint, PgError> sp = e.savepoint();
            match (give sp) {
                case Ok(value: p): {
                    Savepoint point = give p;
                    f = f + check(ok: point.name().equals(other: "sp_1"), what: "transaction: the savepoint is sp_1");
                    Result<Unit, PgError> back = e.rollbackToSavepoint(sp: point);
                    Result<Unit, PgError> gone = e.releaseSavepoint(sp: give point);
                    Result<Unit, PgError> k = e.commit();
                    f = f + check(ok: said(r: back).equals(other: "ok") && said(r: gone).equals(other: "ok") && said(r: k).equals(other: "ok"),
                                  what: "transaction: ROLLBACK TO and RELEASE the savepoint by name");
                }
                case Err(error: x): { f = f + check(ok: false, what: "transaction: SAVEPOINT (".concat(other: x.message()).concat(other: ")")); }
            };
        }
        case Err(error: x): { f = f + check(ok: false, what: "transaction: connect 3"); }
    };

    f = f + windowEndings();
    f = f + nestedWindows();
    f = f + unbegunWindows();
    f = f + windowMethods();
    f = f + abandonedWindows();
    return f;
}

// How a window ends its transaction: by the view's commit, by falling through (ROLLBACK), by a COMMIT run through the
// connection or one that failed (nothing more), by an early return, `continue` or `break`, and a block chained in one
// message (rolled back).
unsafe fn int32 windowEndings() {
    int32 f = 0;

    // tx.commit(): COMMIT, and nothing more.
    DynamicArray<Step> s1 = opening();
    s1.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s1.add(item: completes(sql: "INSERT INTO t VALUES (1)", tag: "INSERT 0 1", status: INTX));
    s1.add(item: completes(sql: "COMMIT", tag: "COMMIT", status: IDLE));
    s1.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m1 = scripted(steps: give s1);
    Connection c1 = match (give m1) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "window: connect 1"); } };
    string began1 = "";
    string inserted = "";
    string committed = "";
    borrow c1.transaction() as tx {
        Result<Unit, PgError> b = tx.began();
        began1 = said(r: b);
        Result<Unit, PgError> i = insertOne(tx: ref tx);
        inserted = said(r: i);
        Result<Unit, PgError> k = tx.commit();
        committed = said(r: k);
    }
    f = f + check(ok: began1.equals(other: "ok") && inserted.equals(other: "ok") && committed.equals(other: "ok") && sentinelRuns(c: ref c1),
                  what: "window: BEGIN, a helper's INSERT, tx.commit(), and nothing when the window closes (".concat(other: committed).concat(other: ")"));

    // Falling through: ROLLBACK.
    DynamicArray<Step> s2 = opening();
    s2.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s2.add(item: completes(sql: "INSERT INTO t VALUES (1)", tag: "INSERT 0 1", status: INTX));
    s2.add(item: completes(sql: "ROLLBACK", tag: "ROLLBACK", status: IDLE));
    s2.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m2 = scripted(steps: give s2);
    Connection c2 = match (give m2) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "window: connect 2"); } };
    borrow c2.transaction() as tx { Result<Unit, PgError> i = insertOne(tx: ref tx); }
    f = f + check(ok: sentinelRuns(c: ref c2) && c2.transactionStatus() == TransactionStatus::Idle, what: "window: falling through rolls back");

    // A COMMIT run through the connection ends the transaction: the window sends nothing, and tx.commit() is refused.
    DynamicArray<Step> s3 = opening();
    s3.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s3.add(item: completes(sql: "COMMIT", tag: "COMMIT", status: IDLE));
    s3.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m3 = scripted(steps: give s3);
    Connection c3 = match (give m3) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "window: connect 3"); } };
    string again = "";
    borrow c3.transaction() as tx {
        Result<Unit, PgError> k = tx.conn().commit();
        Result<Unit, PgError> twice = tx.commit();
        again = said(r: twice);
    }
    f = f + check(ok: again.equals(other: "the transaction is over: it was committed or rolled back") && sentinelRuns(c: ref c3),
                  what: "window: a COMMIT through conn() counts, and tx.commit() after it is refused (".concat(other: again).concat(other: ")"));

    // A COMMIT that fails (a deferred constraint) has ended the transaction too.
    DynamicArray<Step> s4 = opening();
    s4.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s4.add(item: fails(sql: "COMMIT", code: "23503", status: IDLE));
    s4.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m4 = scripted(steps: give s4);
    Connection c4 = match (give m4) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "window: connect 4"); } };
    int32 refused = 0;
    borrow c4.transaction() as tx {
        Result<Unit, PgError> k = tx.commit();
        refused = stateOf(r: k);
    }
    f = f + check(ok: refused == FOREIGN_KEY_VIOLATION && sentinelRuns(c: ref c4), what: "window: a COMMIT that fails is the commit's error, and the window sends nothing");

    // Every way out of a window: an early return, `continue`, and `break` after a commit.
    DynamicArray<Step> s5 = opening();
    s5.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s5.add(item: completes(sql: "ROLLBACK", tag: "ROLLBACK", status: IDLE));
    s5.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s5.add(item: completes(sql: "ROLLBACK", tag: "ROLLBACK", status: IDLE));
    s5.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s5.add(item: completes(sql: "COMMIT", tag: "COMMIT", status: IDLE));
    s5.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m5 = scripted(steps: give s5);
    Connection c5 = match (give m5) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "window: connect 5"); } };
    int32 early = leavesEarly(c: ref c5);
    int32 turns = 0;
    while (turns < 3) {
        borrow c5.transaction() as tx {
            turns = turns + 1;
            if (turns == 1) { continue; }
            Result<Unit, PgError> k = tx.commit();
            break;
        }
    }
    f = f + check(ok: early == 5 && turns == 2 && sentinelRuns(c: ref c5), what: "window: a return and a continue roll back, a commit then break does not");

    // A block chained in the same message: the server never said the window's block ended, so the window rolls back.
    DynamicArray<Step> s6 = opening();
    s6.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s6.add(item: completes(sql: "COMMIT; BEGIN", tag: "BEGIN", status: INTX));
    s6.add(item: completes(sql: "ROLLBACK", tag: "ROLLBACK", status: IDLE));
    s6.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m6 = scripted(steps: give s6);
    Connection c6 = match (give m6) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "window: connect 6"); } };
    borrow c6.transaction() as tx { Result<DynamicArray<Rows>, PgError> r = tx.conn().simpleQuery(sql: "COMMIT; BEGIN"); }
    f = f + check(ok: sentinelRuns(c: ref c6), what: "window: COMMIT; BEGIN in one message leaves a block the window rolls back");
    return f;
}

// A window inside a window is a savepoint: released by inner.commit(), rolled back to and released (one message) when
// it falls through, refused by the server when the block has failed, numbered with savepoint()'s names.
unsafe fn int32 nestedWindows() {
    int32 f = 0;

    // inner.commit(): RELEASE; the outer commits.
    DynamicArray<Step> s1 = opening();
    s1.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s1.add(item: completes(sql: "SAVEPOINT sp_1", tag: "SAVEPOINT", status: INTX));
    s1.add(item: completes(sql: "INSERT INTO t VALUES (1)", tag: "INSERT 0 1", status: INTX));
    s1.add(item: completes(sql: "RELEASE SAVEPOINT sp_1", tag: "RELEASE", status: INTX));
    s1.add(item: completes(sql: "COMMIT", tag: "COMMIT", status: IDLE));
    s1.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m1 = scripted(steps: give s1);
    Connection c1 = match (give m1) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "nested: connect 1"); } };
    string released = "";
    string committed = "";
    borrow c1.transaction() as tx {
        borrow tx.conn().transaction() as inner {
            Result<Unit, PgError> i = insertOne(tx: ref inner);
            Result<Unit, PgError> k = inner.commit();
            released = said(r: k);
        }
        Result<Unit, PgError> k = tx.commit();
        committed = said(r: k);
    }
    f = f + check(ok: released.equals(other: "ok") && committed.equals(other: "ok") && sentinelRuns(c: ref c1), what: "nested: SAVEPOINT sp_1, RELEASE by inner.commit(), the outer's COMMIT");

    // Falling through: ROLLBACK TO and RELEASE, in one message; the outer goes on and commits.
    DynamicArray<Step> s2 = opening();
    s2.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s2.add(item: completes(sql: "SAVEPOINT sp_1", tag: "SAVEPOINT", status: INTX));
    s2.add(item: fails(sql: "INSERT INTO t VALUES (1)", code: "23505", status: FAILED));
    s2.add(item: completes(sql: "ROLLBACK TO SAVEPOINT sp_1; RELEASE SAVEPOINT sp_1", tag: "RELEASE", status: INTX));
    s2.add(item: completes(sql: "COMMIT", tag: "COMMIT", status: IDLE));
    s2.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m2 = scripted(steps: give s2);
    Connection c2 = match (give m2) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "nested: connect 2"); } };
    int32 duplicate = 0;
    string outerCommit = "";
    borrow c2.transaction() as tx {
        borrow tx.conn().transaction() as inner {
            Result<Unit, PgError> i = insertOne(tx: ref inner);
            duplicate = stateOf(r: i);
        }
        Result<Unit, PgError> k = tx.commit();
        outerCommit = said(r: k);
    }
    f = f + check(ok: duplicate == UNIQUE_VIOLATION && outerCommit.equals(other: "ok") && sentinelRuns(c: ref c2),
                  what: "nested: a failed inner window is rolled back to its savepoint, and the outer commits (".concat(other: outerCommit).concat(other: ")"));

    // In a failed block the inner window's SAVEPOINT is refused (25P02): it ends nothing, and the outer rolls back.
    DynamicArray<Step> s3 = opening();
    s3.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s3.add(item: fails(sql: "SELECT 1/0", code: "22012", status: FAILED));
    s3.add(item: fails(sql: "SAVEPOINT sp_1", code: "25P02", status: FAILED));
    s3.add(item: completes(sql: "ROLLBACK", tag: "ROLLBACK", status: IDLE));
    s3.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m3 = scripted(steps: give s3);
    Connection c3 = match (give m3) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "nested: connect 3"); } };
    int32 aborted = 0;
    borrow c3.transaction() as tx {
        Result<DynamicArray<Rows>, PgError> r = tx.conn().simpleQuery(sql: "SELECT 1/0");
        borrow tx.conn().transaction() as inner {
            Result<Unit, PgError> b = inner.began();
            aborted = stateOf(r: b);
        }
    }
    f = f + check(ok: aborted == IN_FAILED_SQL_TRANSACTION && sentinelRuns(c: ref c3), what: "nested: SAVEPOINT in a failed block is refused, and only the outer window rolls back");

    // The outer transaction committed through the inner window, and a new one begun there: neither window ends it.
    DynamicArray<Step> s4 = opening();
    s4.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s4.add(item: completes(sql: "SAVEPOINT sp_1", tag: "SAVEPOINT", status: INTX));
    s4.add(item: completes(sql: "COMMIT", tag: "COMMIT", status: IDLE));
    s4.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s4.add(item: sentinel(status: INTX));
    Result<Connection, PgError> m4 = scripted(steps: give s4);
    Connection c4 = match (give m4) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "nested: connect 4"); } };
    TransactionOptions plain = TransactionOptions.defaults();
    borrow c4.transaction() as tx {
        borrow tx.conn().transaction() as inner {
            Result<Unit, PgError> k = inner.conn().commit();
            Result<Unit, PgError> b = inner.conn().begin(options: plain);
        }
    }
    f = f + check(ok: sentinelRuns(c: ref c4) && c4.transactionStatus() == TransactionStatus::InTransaction, what: "nested: a block begun after the window's ended is not the window's to end");

    // The names: each window takes the next, and savepoint() goes on from them.
    DynamicArray<Step> s5 = opening();
    s5.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s5.add(item: completes(sql: "SAVEPOINT sp_1", tag: "SAVEPOINT", status: INTX));
    s5.add(item: completes(sql: "RELEASE SAVEPOINT sp_1", tag: "RELEASE", status: INTX));
    s5.add(item: completes(sql: "SAVEPOINT sp_2", tag: "SAVEPOINT", status: INTX));
    s5.add(item: completes(sql: "RELEASE SAVEPOINT sp_2", tag: "RELEASE", status: INTX));
    s5.add(item: completes(sql: "SAVEPOINT sp_3", tag: "SAVEPOINT", status: INTX));
    s5.add(item: completes(sql: "COMMIT", tag: "COMMIT", status: IDLE));
    s5.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m5 = scripted(steps: give s5);
    Connection c5 = match (give m5) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "nested: connect 5"); } };
    string third = "";
    borrow c5.transaction() as tx {
        borrow tx.conn().transaction() as a { Result<Unit, PgError> k = a.commit(); }
        borrow tx.conn().transaction() as b { Result<Unit, PgError> k = b.commit(); }
        Result<Savepoint, PgError> sp = tx.conn().savepoint();
        match (give sp) { case Ok(value: p): { third = copy p.name(); } case Err(error: e): { third = e.message(); } };
        Result<Unit, PgError> k = tx.commit();
    }
    f = f + check(ok: third.equals(other: "sp_3") && sentinelRuns(c: ref c5), what: "nested: windows take sp_1 and sp_2, and savepoint() then sp_3 (".concat(other: third).concat(other: ")"));
    return f;
}

// A window whose BEGIN did not run: began() gives why, once; commit() gives it too; the window ends nothing.
unsafe fn int32 unbegunWindows() {
    int32 f = 0;
    string pipelined = "synchronous command execution functions are not allowed in pipeline mode";

    // In pipeline mode BEGIN is refused: began() says why, then that it has said so.
    DynamicArray<Step> s1 = opening();
    s1.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m1 = scripted(steps: give s1);
    Connection c1 = match (give m1) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "unbegun: connect 1"); } };
    Result<Unit, PgError> entered = c1.enterPipelineMode();
    string first = "";
    string second = "";
    borrow c1.transaction() as tx {
        Result<Unit, PgError> b1 = tx.began();
        first = said(r: b1);
        Result<Unit, PgError> b2 = tx.began();
        second = said(r: b2);
    }
    Result<Unit, PgError> left = c1.exitPipelineMode();
    f = f + check(ok: first.equals(other: pipelined) && second.equals(other: "the transaction did not begin, and began() has returned why") && sentinelRuns(c: ref c1),
                  what: "unbegun: began() gives BEGIN's refusal once, and the window ends nothing (".concat(other: first).concat(other: " / ").concat(other: second).concat(other: ")"));

    // commit() on a window that did not begin gives BEGIN's error; rollback() after it, that it was given.
    DynamicArray<Step> s2 = opening();
    s2.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m2 = scripted(steps: give s2);
    Connection c2 = match (give m2) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "unbegun: connect 2"); } };
    Result<Unit, PgError> entered2 = c2.enterPipelineMode();
    string commitSaid = "";
    string rollbackSaid = "";
    borrow c2.transaction() as tx {
        Result<Unit, PgError> k = tx.commit();
        commitSaid = said(r: k);
        Result<Unit, PgError> r = tx.rollback();
        rollbackSaid = said(r: r);
    }
    Result<Unit, PgError> left2 = c2.exitPipelineMode();
    f = f + check(ok: commitSaid.equals(other: pipelined) && rollbackSaid.equals(other: "the transaction did not begin, and began() has returned why") && sentinelRuns(c: ref c2),
                  what: "unbegun: commit() gives BEGIN's error (".concat(other: commitSaid).concat(other: ")"));

    // An unclaimed error is dropped by the next window's mint.
    DynamicArray<Step> s3 = opening();
    s3.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m3 = scripted(steps: give s3);
    Connection c3 = match (give m3) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "unbegun: connect 3"); } };
    Result<Unit, PgError> entered3 = c3.enterPipelineMode();
    string innerSaid = "";
    string outerSaid = "";
    borrow c3.transaction() as tx {
        borrow tx.conn().transaction() as inner {
            Result<Unit, PgError> b = inner.began();
            innerSaid = said(r: b);
        }
        Result<Unit, PgError> b = tx.began();
        outerSaid = said(r: b);
    }
    Result<Unit, PgError> left3 = c3.exitPipelineMode();
    f = f + check(ok: innerSaid.equals(other: pipelined) && outerSaid.equals(other: "the transaction did not begin, and why was dropped when a later transaction() began") && sentinelRuns(c: ref c3),
                  what: "unbegun: a later mint drops an unclaimed error (".concat(other: outerSaid).concat(other: ")"));

    // On a closed connection: Closed.
    DynamicArray<Step> s4 = opening();
    Result<Connection, PgError> m4 = scripted(steps: give s4);
    Connection c4 = match (give m4) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "unbegun: connect 4"); } };
    c4.close();
    string closedSaid = "";
    borrow c4.transaction() as tx {
        Result<Unit, PgError> b = tx.began();
        closedSaid = said(r: b);
    }
    f = f + check(ok: closedSaid.equals(other: "no connection to the server"), what: "unbegun: a closed connection (".concat(other: closedSaid).concat(other: ")"));
    return f;
}

// setOptions: SET TRANSACTION with the modes; nothing for the defaults; a savepoint's refused by the server, which
// fails the savepoint only.
unsafe fn int32 windowMethods() {
    int32 f = 0;
    TransactionOptions strict = TransactionOptions.of(isolation: IsolationLevel::Serializable, access: AccessMode::ReadOnly, deferrable: true);
    TransactionOptions plain = TransactionOptions.defaults();
    TransactionOptions serializable = TransactionOptions.of(isolation: IsolationLevel::Serializable, access: AccessMode::Default, deferrable: false);

    DynamicArray<Step> s1 = opening();
    s1.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s1.add(item: completes(sql: "SET TRANSACTION ISOLATION LEVEL SERIALIZABLE READ ONLY DEFERRABLE", tag: "SET", status: INTX));
    s1.add(item: completes(sql: "SAVEPOINT sp_1", tag: "SAVEPOINT", status: INTX));
    s1.add(item: fails(sql: "SET TRANSACTION ISOLATION LEVEL SERIALIZABLE", code: "25001", status: FAILED));
    s1.add(item: completes(sql: "ROLLBACK TO SAVEPOINT sp_1; RELEASE SAVEPOINT sp_1", tag: "RELEASE", status: INTX));
    s1.add(item: completes(sql: "COMMIT", tag: "COMMIT", status: IDLE));
    s1.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m1 = scripted(steps: give s1);
    Connection c1 = match (give m1) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "options: connect"); } };
    string set = "";
    string none = "";
    int32 inSavepoint = 0;
    string committed = "";
    borrow c1.transaction() as tx {
        Result<Unit, PgError> o = tx.setOptions(options: strict);
        set = said(r: o);
        Result<Unit, PgError> d = tx.setOptions(options: plain);
        none = said(r: d);
        borrow tx.conn().transaction() as inner {
            Result<Unit, PgError> s = inner.setOptions(options: serializable);
            inSavepoint = stateOf(r: s);
        }
        Result<Unit, PgError> k = tx.commit();
        committed = said(r: k);
    }
    f = f + check(ok: set.equals(other: "ok") && none.equals(other: "ok") && inSavepoint == ACTIVE_SQL_TRANSACTION && committed.equals(other: "ok") && sentinelRuns(c: ref c1),
                  what: "options: SET TRANSACTION with every mode, nothing for the defaults, a savepoint's refused and rolled back to (".concat(other: committed).concat(other: ")"));
    return f;
}

// A window that cannot end its transaction closes the connection: a chunked result left open is read off first, but a
// COPY or pipeline mode left open, or a ROLLBACK the server refuses, is the end of the session. A savepoint the server
// will not roll back to leaves the block failed, for the outer COMMIT to report.
unsafe fn int32 abandonedWindows() {
    int32 f = 0;

    // Rows left unread: read off, then ROLLBACK.
    DynamicArray<Step> s1 = opening();
    s1.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s1.add(item: quiet(tag: 80ui8));   // Parse
    s1.add(item: quiet(tag: 68ui8));   // Describe
    Wire described = Wire.make();
    described.parseComplete();
    DynamicArray<uint32> noTypes = DynamicArray.empty();
    described.parameterTypes(oids: noTypes);
    DynamicArray<string> names = DynamicArray.empty(); names.add(item: "n");
    DynamicArray<uint32> types = DynamicArray.empty(); types.add(item: 23ui32);
    described.typedColumns(names: names, oids: types);
    described.ready(status: INTX);
    s1.add(item: answer(tag: 83ui8, reply: give described));   // Sync
    s1.add(item: quiet(tag: 66ui8));   // Bind
    s1.add(item: quiet(tag: 69ui8));   // Execute
    Wire rows = Wire.make();
    rows.bindComplete();
    int32 i = 1;
    while (i <= 3) { DynamicArray<int32> one = DynamicArray.empty(); one.add(item: i); rows.intRow(values: one); i = i + 1; }
    rows.complete(tag: "SELECT 3");
    rows.ready(status: INTX);
    s1.add(item: answer(tag: 83ui8, reply: give rows));   // Sync
    s1.add(item: completes(sql: "ROLLBACK", tag: "ROLLBACK", status: IDLE));
    s1.add(item: sentinel(status: IDLE));
    string none = "";
    Result<Connection, PgError> m1 = overUncached(script: give s1, conninfo: none);
    Connection c1 = match (give m1) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "abandoned: connect 1 (".concat(other: e.message()).concat(other: ")")); } };
    isize firstChunk = 0;
    borrow c1.transaction() as tx {
        Query q = Query.make(sql: "select n from t");
        Result<Unit, PgError> st = tx.conn().startRows(q: q);
        Result<Rows, PgError> chunk = tx.conn().nextRows(maxRows: 1);
        match (give chunk) { case Ok(value: r): { firstChunk = r.rowCount(); } case Err(error: e): { } };
    }
    f = f + check(ok: firstChunk == 1 && sentinelRuns(c: ref c1), what: "abandoned: rows left unread are read off, then ROLLBACK");

    // A COPY left open: the connection is closed.
    DynamicArray<Step> s2 = opening();
    s2.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    Wire copying = Wire.make(); copying.copyResponse(tag: 71ui8);
    s2.add(item: answers(sql: "COPY t FROM STDIN", reply: give copying));
    Result<Connection, PgError> m2 = scripted(steps: give s2);
    Connection c2 = match (give m2) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "abandoned: connect 2"); } };
    bool copyStarted = false;
    borrow c2.transaction() as tx {
        Result<CopyInfo, PgError> st = tx.conn().startCopyIn(sql: "COPY t FROM STDIN");
        copyStarted = match (st) { case Ok(value: info): true; case Err(error: e): false; };
    }
    f = f + check(ok: copyStarted && c2.isClosed(), what: "abandoned: a COPY left open closes the connection");

    // Pipeline mode left on: the connection is closed.
    DynamicArray<Step> s3 = opening();
    s3.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    Result<Connection, PgError> m3 = scripted(steps: give s3);
    Connection c3 = match (give m3) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "abandoned: connect 3"); } };
    borrow c3.transaction() as tx { Result<Unit, PgError> p = tx.conn().enterPipelineMode(); }
    f = f + check(ok: c3.isClosed(), what: "abandoned: pipeline mode left on closes the connection");

    // A ROLLBACK the server refuses, still in the block: the connection is closed.
    DynamicArray<Step> s4 = opening();
    s4.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s4.add(item: fails(sql: "ROLLBACK", code: "XX000", status: INTX));
    Result<Connection, PgError> m4 = scripted(steps: give s4);
    Connection c4 = match (give m4) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "abandoned: connect 4"); } };
    borrow c4.transaction() as tx { }
    f = f + check(ok: c4.isClosed(), what: "abandoned: a ROLLBACK refused, still in the block, closes the connection");

    // A savepoint the server will not roll back to (3B001): the block is failed, the connection kept, and the outer
    // COMMIT reports the rollback.
    DynamicArray<Step> s5 = opening();
    s5.add(item: completes(sql: "BEGIN", tag: "BEGIN", status: INTX));
    s5.add(item: completes(sql: "SAVEPOINT sp_1", tag: "SAVEPOINT", status: INTX));
    s5.add(item: fails(sql: "ROLLBACK TO SAVEPOINT sp_1; RELEASE SAVEPOINT sp_1", code: "3B001", status: FAILED));
    s5.add(item: completes(sql: "COMMIT", tag: "ROLLBACK", status: IDLE));
    s5.add(item: sentinel(status: IDLE));
    Result<Connection, PgError> m5 = scripted(steps: give s5);
    Connection c5 = match (give m5) { case Ok(value: x): give x; case Err(error: e): { return check(ok: false, what: "abandoned: connect 5"); } };
    string outer = "";
    borrow c5.transaction() as tx {
        borrow tx.conn().transaction() as inner { }
        Result<Unit, PgError> k = tx.commit();
        outer = said(r: k);
    }
    f = f + check(ok: outer.equals(other: "commit unexpectedly resulted in rollback") && sentinelRuns(c: ref c5),
                  what: "abandoned: a savepoint not rolled back to leaves the block failed, and the outer COMMIT says so (".concat(other: outer).concat(other: ")"));
    return f;
}
